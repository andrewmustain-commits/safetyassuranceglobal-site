---
import { brandAssets, brandAttribution } from '../../config/brand-assets';

interface Props {
  href?: string;
  alt?: string;
  variant?: 'default' | 'light' | 'dark' | 'white' | 'icon';
  className?: string;
  imageClassName?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  attribution?: boolean;
}

const {
  href = '/',
  alt = 'Safety Assurance Global',
  variant = 'default',
  className = '',
  imageClassName = '',
  loading = 'eager',
  decoding = 'async',
  attribution = true
} = Astro.props;

const isIcon = variant === 'icon';
const sealClass = imageClassName ? `sag-seal-image ${imageClassName}` : 'sag-seal-image';
const linkClass = className ? `sag-logo-link ${className}` : 'sag-logo-link';
---

<div class:list={['sag-brand-lockup', { 'is-icon': isIcon }] }>
  <a href={href} class={linkClass} aria-label="Safety Assurance Global home">
    <img class={sealClass} src={brandAssets.sagSeal} alt={alt} loading={loading} decoding={decoding} />
    {!isIcon && (
      <span class="sag-wordmark" aria-hidden="true">
        <strong>Safety Assurance</strong>
        <span>Global</span>
        {attribution && <small>{brandAttribution}</small>}
      </span>
    )}
  </a>
</div>

<style>
  .sag-brand-lockup{min-width:0}
  .sag-logo-link{display:flex;align-items:center;gap:clamp(.75rem,1.6vw,1.2rem);max-width:100%;text-decoration:none;color:inherit}
  .sag-seal-image{display:block;width:clamp(5.8rem,9vw,8.5rem);height:clamp(5.8rem,9vw,8.5rem);flex:0 0 auto;filter:drop-shadow(0 10px 20px rgba(0,0,0,.35))}
  .sag-wordmark{display:grid;min-width:0;line-height:1;text-transform:uppercase}
  .sag-wordmark strong{color:#f8fafc;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(1.35rem,2.8vw,2.8rem);font-weight:850;letter-spacing:.015em;white-space:nowrap}
  .sag-wordmark>span{margin-top:.4rem;color:#d39a32;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(1rem,2vw,1.75rem);font-weight:800;letter-spacing:.34em}
  .sag-wordmark small{display:block;margin-top:.75rem;padding-top:.65rem;border-top:2px solid rgba(211,154,50,.8);color:#aeb8c5;font-size:clamp(.58rem,1vw,.82rem);font-weight:800;letter-spacing:.18em;white-space:nowrap}
  .is-icon .sag-seal-image{width:3.25rem;height:3.25rem}
  @media(max-width:920px){.sag-seal-image{width:clamp(4.4rem,14vw,6.25rem);height:clamp(4.4rem,14vw,6.25rem)}.sag-wordmark strong{font-size:clamp(1.05rem,4.3vw,1.8rem)}.sag-wordmark>span{font-size:clamp(.76rem,3.3vw,1.15rem)}.sag-wordmark small{margin-top:.48rem;padding-top:.45rem;font-size:.53rem;letter-spacing:.12em}}
  @media(max-width:560px){.sag-logo-link{gap:.55rem}.sag-seal-image{width:4rem;height:4rem}.sag-wordmark strong{font-size:clamp(.9rem,4.4vw,1.25rem)}.sag-wordmark>span{margin-top:.25rem;font-size:.72rem;letter-spacing:.25em}.sag-wordmark small{font-size:.43rem;letter-spacing:.085em}}
</style>

<style is:global>@import '../../styles/brand-polish.css';</style>
