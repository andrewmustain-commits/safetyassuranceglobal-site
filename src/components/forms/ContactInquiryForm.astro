---
const inquiryTypes = [
  'Consultation',
  'Proposal Request',
  'Maritime Services',
  'Training',
  'Government Contracting',
  'Teaming',
  'General Inquiry'
];

const serviceOptions = [
  'Operational Readiness',
  'Independent Assurance',
  'Maritime Compliance',
  'QA/QC',
  'Contractor Assurance',
  'Safety and Risk Management',
  'Incident Investigation',
  'Embedded HSE Support',
  'Emergency Preparedness',
  'Program Assurance',
  'Not Sure Yet'
];
---

<section class="lead-form-shell" aria-labelledby="contact-form-title">
  <div class="lead-form-intro">
    <p class="lead-form-eyebrow" id="contact-form-title">Inquiry form</p>
    <p class="lead-form-description">Submit a consultation inquiry through the secured intake path.</p>
  </div>

  <form class="lead-form" id="contact-form" data-intake-form data-form-type="contact" novalidate>
    <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden" />

    <div class="lead-form-grid">
      <label class="lead-field" for="contact-name">
        <span>Name</span>
        <input id="contact-name" name="name" type="text" autocomplete="name" required aria-describedby="contact-status" />
      </label>

      <label class="lead-field" for="contact-organization">
        <span>Organization</span>
        <input id="contact-organization" name="organization" type="text" autocomplete="organization" required aria-describedby="contact-status" />
      </label>

      <label class="lead-field" for="contact-email">
        <span>Business Email</span>
        <input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-status" />
      </label>

      <label class="lead-field" for="contact-phone">
        <span>Phone, optional</span>
        <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
      </label>

      <label class="lead-field" for="contact-inquiry-type">
        <span>Inquiry Type</span>
        <select id="contact-inquiry-type" name="inquiryType" required aria-describedby="contact-status">
          <option value="">Select inquiry type</option>
          {inquiryTypes.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>

      <label class="lead-field" for="contact-service-interest">
        <span>Service Interest</span>
        <select id="contact-service-interest" name="serviceInterest" required aria-describedby="contact-status">
          <option value="">Select service interest</option>
          {serviceOptions.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>

      <label class="lead-field lead-field-full" for="contact-message">
        <span>Message</span>
        <textarea id="contact-message" name="message" rows="5" required aria-describedby="contact-status"></textarea>
      </label>

      <label class="lead-field lead-field-full lead-checkbox" for="contact-privacy">
        <input id="contact-privacy" name="privacyAcknowledgement" type="checkbox" required aria-describedby="contact-status" />
        <span>I acknowledge the privacy notice and agree to inquiry-response processing.</span>
      </label>
    </div>

    <p class="lead-form-status" id="contact-status" data-form-status aria-live="polite"></p>

    <div class="lead-form-actions">
      <button class="ui-button ui-button-primary" type="submit">Submit Inquiry</button>
    </div>
  </form>
</section>

<script is:inline src="/scripts/intake-form.js" defer></script>
