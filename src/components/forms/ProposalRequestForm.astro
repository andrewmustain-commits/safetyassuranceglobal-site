---
const projectTypes = [
  'Program Assurance',
  'Operational Readiness',
  'Compliance and QA/QC',
  'Contractor Assurance',
  'Safety and Risk Management',
  'Emergency Preparedness',
  'Other'
];

const serviceNeeded = [
  'Operational Readiness',
  'Independent Assurance',
  'Maritime Compliance',
  'QA/QC',
  'Contractor Assurance',
  'Safety and Risk Management',
  'Incident Investigation',
  'Embedded HSE Support',
  'Emergency Preparedness',
  'Program Assurance'
];

const schedules = ['Immediate', 'Within 30 days', 'Within 90 days', 'Quarter planning', 'Exploratory'];
---

<section class="lead-form-shell" aria-labelledby="proposal-form-title">
  <div class="lead-form-intro">
    <p class="lead-form-eyebrow" id="proposal-form-title">Proposal intake</p>
    <p class="lead-form-description">Submit a commercially scoped request for proposal review.</p>
  </div>

  <form class="lead-form" id="proposal-form" data-intake-form data-form-type="proposal" novalidate>
    <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden" />

    <div class="lead-form-grid">
      <label class="lead-field" for="proposal-name">
        <span>Name</span>
        <input id="proposal-name" name="name" type="text" autocomplete="name" required aria-describedby="proposal-status" />
      </label>

      <label class="lead-field" for="proposal-organization">
        <span>Organization</span>
        <input id="proposal-organization" name="organization" type="text" autocomplete="organization" required aria-describedby="proposal-status" />
      </label>

      <label class="lead-field" for="proposal-email">
        <span>Business Email</span>
        <input id="proposal-email" name="email" type="email" autocomplete="email" required aria-describedby="proposal-status" />
      </label>

      <label class="lead-field" for="proposal-phone">
        <span>Phone, optional</span>
        <input id="proposal-phone" name="phone" type="tel" autocomplete="tel" />
      </label>

      <label class="lead-field" for="proposal-project-type">
        <span>Project or Program Type</span>
        <select id="proposal-project-type" name="projectType" required aria-describedby="proposal-status">
          <option value="">Select project type</option>
          {projectTypes.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>

      <label class="lead-field" for="proposal-service-needed">
        <span>Service Needed</span>
        <select id="proposal-service-needed" name="serviceNeeded" required aria-describedby="proposal-status">
          <option value="">Select service</option>
          {serviceNeeded.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>

      <label class="lead-field" for="proposal-location">
        <span>Project Location</span>
        <input id="proposal-location" name="projectLocation" type="text" autocomplete="address-level2" required aria-describedby="proposal-status" />
      </label>

      <label class="lead-field" for="proposal-schedule">
        <span>Anticipated Schedule</span>
        <select id="proposal-schedule" name="anticipatedSchedule" required aria-describedby="proposal-status">
          <option value="">Select schedule</option>
          {schedules.map((item) => <option value={item}>{item}</option>)}
        </select>
      </label>

      <label class="lead-field lead-field-full" for="proposal-scope">
        <span>Brief Scope</span>
        <textarea id="proposal-scope" name="briefScope" rows="5" required aria-describedby="proposal-status"></textarea>
      </label>

      <label class="lead-field lead-field-full" for="proposal-procurement-context">
        <span>Procurement or Teaming Context</span>
        <textarea id="proposal-procurement-context" name="procurementContext" rows="4" required aria-describedby="proposal-status"></textarea>
      </label>

      <label class="lead-field lead-field-full lead-checkbox" for="proposal-privacy">
        <input id="proposal-privacy" name="privacyAcknowledgement" type="checkbox" required aria-describedby="proposal-status" />
        <span>I acknowledge the privacy notice and agree to proposal-intake processing.</span>
      </label>
    </div>

    <p class="lead-form-status" id="proposal-status" data-form-status aria-live="polite"></p>

    <div class="lead-form-actions">
      <button class="ui-button ui-button-primary" type="submit">Submit Proposal Request</button>
    </div>
  </form>
</section>

<script is:inline src="/scripts/intake-form.js" defer></script>
