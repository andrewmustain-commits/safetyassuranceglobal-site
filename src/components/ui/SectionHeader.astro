---
import Badge from './Badge.astro';

interface Props {
  badge: string;
  title: string;
  id: string;
  intro?: string;
  class?: string;
}

const { badge, title, id, intro, class: className } = Astro.props;
---

<div class:list={['section-header', className]}>
  <Badge text={badge} />
  <h2 id={id}>{title}</h2>
  {intro && <p>{intro}</p>}
</div>
