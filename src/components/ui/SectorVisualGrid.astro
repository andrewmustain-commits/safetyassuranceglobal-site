---
const sectors = [
  { code: 'MT', title: 'Maritime Terminals', detail: 'Approved photography slot for ports, terminals, cargo operations, and marine interfaces.' },
  { code: 'HC', title: 'Heavy Construction', detail: 'Approved photography slot for capital projects, contractor operations, and field execution.' },
  { code: 'DC', title: 'Data Center Facilities', detail: 'Approved photography slot for mission-critical facilities, construction, and operational readiness.' },
  { code: 'SD', title: 'School Districts', detail: 'Approved photography slot for public-sector learning environments and workforce-support contexts.' }
];
---
<section class="sector-visuals" aria-labelledby="sector-visuals-title">
  <div class="sector-visuals-heading">
    <p class="sector-visuals-kicker">Sector Visuals</p>
    <h2 id="sector-visuals-title">Photography-ready modules for priority operating environments.</h2>
    <p>These containers intentionally use neutral brand graphics until approved, rights-cleared photography is available. No customer, project, or agency relationship is implied.</p>
  </div>
  <div class="sector-visual-grid">
    {sectors.map((sector) => (
      <article class="sector-visual-card">
        <div class="sector-art" aria-hidden="true">
          <span>{sector.code}</span>
          <i></i>
        </div>
        <div class="sector-copy">
          <h3>{sector.title}</h3>
          <p>{sector.detail}</p>
        </div>
      </article>
    ))}
  </div>
</section>
<style>
.sector-visuals{padding:clamp(1.5rem,4vw,3rem);border:1px solid rgba(148,163,184,.18);border-radius:1.25rem;background:linear-gradient(145deg,rgba(15,23,42,.94),rgba(9,18,31,.98));box-shadow:var(--shadow-panel)}.sector-visuals-heading{max-width:780px;margin-bottom:1.5rem}.sector-visuals-kicker{margin:0 0 .45rem;color:#f59e0b;font-size:.72rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.sector-visuals-heading h2{font-size:clamp(1.7rem,3vw,2.8rem)}.sector-visual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.sector-visual-card{overflow:hidden;border:1px solid rgba(148,163,184,.18);border-radius:1rem;background:rgba(15,23,42,.78);transition:transform .2s ease,border-color .2s ease}.sector-visual-card:hover{transform:translateY(-3px);border-color:rgba(59,130,246,.5)}.sector-art{position:relative;display:grid;place-items:center;min-height:180px;overflow:hidden;background:radial-gradient(circle at 50% 45%,rgba(59,130,246,.26),transparent 22%),linear-gradient(135deg,#0f172a,#1e293b)}.sector-art:before,.sector-art:after{content:'';position:absolute;border:1px solid rgba(96,165,250,.22);border-radius:50%}.sector-art:before{width:180px;height:180px}.sector-art:after{width:105px;height:105px}.sector-art span{position:relative;z-index:2;display:grid;place-items:center;width:64px;height:64px;border:1px solid rgba(245,158,11,.4);border-radius:50%;background:rgba(9,18,31,.86);color:#fbbf24;font-size:.9rem;font-weight:900;letter-spacing:.12em}.sector-art i{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(148,163,184,.28) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.28) 1px,transparent 1px);background-size:28px 28px}.sector-copy{padding:1.1rem}.sector-copy h3{margin-bottom:.5rem}.sector-copy p{margin:0;color:#94a3b8;font-size:.9rem}@media(max-width:720px){.sector-visual-grid{grid-template-columns:1fr}.sector-art{min-height:150px}}
</style>