---
const sectors = [
  {
    title: 'Maritime Terminals',
    detail: 'Operational-readiness, contractor-assurance, safety, quality, and evidence-focused support for ports, terminals, cargo operations, and marine interfaces.',
    image: '/images/site-2026/maritime-hero.webp',
    position: 'center 56%'
  },
  {
    title: 'Heavy Construction',
    detail: 'Requirements-first safety, QA/QC, contractor oversight, field verification, corrective-action, and closeout support for complex capital work.',
    image: '/images/site-2026/services-hero.webp',
    position: 'center 50%'
  },
  {
    title: 'Critical Facilities',
    detail: 'Readiness, control verification, evidence review, workforce coordination, and risk support for mission-critical facilities and infrastructure environments.',
    image: '/images/site-2026/capabilities-hero.webp',
    position: 'center 48%'
  },
  {
    title: 'Public-Sector Workforce',
    detail: 'Governed learning, readiness, safety, assurance, and workforce-development support where the engagement scope and applicable requirements are defined.',
    image: '/images/site-2026/institute-hero.webp',
    position: 'center 50%'
  }
];
---
<section class="sector-visuals" aria-labelledby="sector-visuals-title">
  <div class="sector-visuals-heading">
    <p class="sector-visuals-kicker">Operating Environments</p>
    <h2 id="sector-visuals-title">Visual pathways into high-consequence work.</h2>
    <p>Representative imagery illustrates operating environments Safety Assurance Global may support. It does not identify a customer, project, agency, vessel, facility, or current engagement.</p>
  </div>
  <div class="sector-visual-grid">
    {sectors.map((sector) => (
      <article class="sector-visual-card">
        <div class="sector-art">
          <img src={sector.image} alt="" aria-hidden="true" loading="lazy" decoding="async" style={`object-position:${sector.position};`} />
          <span class="sector-art-shade" aria-hidden="true"></span>
        </div>
        <div class="sector-copy">
          <h3>{sector.title}</h3>
          <p>{sector.detail}</p>
        </div>
      </article>
    ))}
  </div>
</section>
<style>
.sector-visuals{padding:clamp(1.5rem,4vw,3rem);border:1px solid rgba(202,164,79,.28);border-radius:1.25rem;background:linear-gradient(145deg,rgba(15,23,42,.94),rgba(9,18,31,.98));box-shadow:var(--shadow-panel)}
.sector-visuals-heading{max-width:820px;margin-bottom:1.5rem}.sector-visuals-kicker{margin:0 0 .45rem;color:#f59e0b;font-size:.72rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.sector-visuals-heading h2{font-size:clamp(1.7rem,3vw,2.8rem)}
.sector-visual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.sector-visual-card{overflow:hidden;border:1px solid rgba(148,163,184,.2);border-radius:1rem;background:rgba(15,23,42,.82);box-shadow:0 12px 28px rgba(0,0,0,.2);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.sector-visual-card:hover{transform:translateY(-3px);border-color:rgba(202,164,79,.58);box-shadow:0 18px 36px rgba(0,0,0,.3)}
.sector-art{position:relative;min-height:clamp(180px,24vw,245px);overflow:hidden;background:#061426}.sector-art img,.sector-art-shade{position:absolute;inset:0;width:100%;height:100%}.sector-art img{object-fit:cover;filter:saturate(.94) contrast(1.04)}.sector-art-shade{pointer-events:none;background:linear-gradient(180deg,rgba(3,15,28,.02) 20%,rgba(3,15,28,.15) 62%,rgba(3,15,28,.62) 100%)}
.sector-copy{padding:1.15rem 1.2rem 1.25rem}.sector-copy h3{margin-bottom:.5rem}.sector-copy p{margin:0;color:#cbd5e1;font-size:.92rem;line-height:1.6}@media(max-width:720px){.sector-visual-grid{grid-template-columns:1fr}.sector-art{min-height:220px}}
</style>
