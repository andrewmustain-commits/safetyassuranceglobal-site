---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  as?: 'article' | 'div' | 'section';
}

const { as = 'article', class: className, ...attrs } = Astro.props as Props;
const Tag = as;
---

<Tag class:list={['ui-card', className]} {...attrs}>
  <slot />
</Tag>
