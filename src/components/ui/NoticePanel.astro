---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'aside'> {
  tone?: 'info' | 'warning' | 'success' | 'error';
  title?: string;
  class?: string;
}

const { tone = 'info', title, class: className, ...attrs } = Astro.props as Props;
const toneClass =
  tone === 'warning'
    ? 'notice-warning'
    : tone === 'success'
      ? 'notice-success'
      : tone === 'error'
        ? 'alert-error'
        : 'notice-info';
---

<aside class:list={['notice', toneClass, className]} {...attrs}>
  {title && <h3>{title}</h3>}
  <slot />
</aside>
