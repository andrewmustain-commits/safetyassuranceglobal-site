---
---
<aside class="site-assistant" aria-labelledby="site-assistant-title" data-site-assistant>
  <details class="site-assistant__details">
    <summary>Need help choosing?</summary>
    <div class="site-assistant__body">
      <p class="site-assistant__eyebrow">Choose Your Path</p>
      <h2 id="site-assistant-title">What are you trying to accomplish?</h2>
      <p>Move directly to the right customer path. This helper uses only verified public routes and does not collect questions or personal information.</p>
      <nav aria-label="Customer decision shortcuts" class="site-assistant__actions">
        <a href="/start" data-assistant-action="scope">I have a problem to scope</a>
        <a href="/resources" data-assistant-action="resources">I want practical tools</a>
        <a href="/proof" data-assistant-action="proof">I am evaluating Safety Assurance Global</a>
        <a href="/government" data-assistant-action="government">I am a government buyer</a>
        <a href="/partners" data-assistant-action="partners">I am a prime or teaming partner</a>
        <a href="/request-proposal" data-assistant-action="proposal">I am ready to request a proposal</a>
        <a href="https://institute.safetyassuranceglobal.com" data-assistant-action="institute">I need Institute information</a>
      </nav>
      <p class="site-assistant__fallback">Not sure where to start? <a href="/contact" data-assistant-action="handoff">Contact the appropriate Safety Assurance Global team.</a></p>
    </div>
  </details>
</aside>

<style>
.site-assistant{position:fixed;right:clamp(.75rem,2vw,1.5rem);bottom:clamp(.75rem,2vw,1.5rem);z-index:88;width:min(25rem,calc(100vw - 1.5rem));pointer-events:none}.site-assistant__details{pointer-events:auto}.site-assistant__details>summary{display:flex;justify-content:center;align-items:center;min-height:3rem;padding:.7rem 1rem;margin-left:auto;width:max-content;max-width:100%;border:1px solid rgba(214,173,85,.5);border-radius:999px;background:rgba(9,18,31,.96);box-shadow:0 12px 34px rgba(0,0,0,.34);color:#fff;font-weight:850;cursor:pointer;list-style:none}.site-assistant__details>summary::-webkit-details-marker{display:none}.site-assistant__details>summary:before{content:"↗";margin-right:.55rem;color:#f1d493}.site-assistant__details[open]>summary{margin-bottom:.55rem}.site-assistant__body{max-height:min(70vh,38rem);overflow:auto;padding:1.1rem;border:1px solid rgba(148,163,184,.24);border-radius:1rem;background:rgba(9,18,31,.98);box-shadow:0 18px 50px rgba(0,0,0,.46);backdrop-filter:blur(18px)}.site-assistant__eyebrow{margin:0;color:#f1d493;font-size:.72rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.site-assistant h2{margin:.25rem 0 .5rem;font-size:clamp(1.2rem,2.4vw,1.7rem)}.site-assistant__body>p{font-size:.88rem;line-height:1.55}.site-assistant__actions{display:grid;grid-template-columns:1fr;gap:.45rem;margin:.85rem 0}.site-assistant__actions a{display:flex;min-height:44px;align-items:center;padding:.65rem .75rem;border:1px solid rgba(148,163,184,.22);border-radius:.65rem;color:#fff;font-size:.86rem;font-weight:750;text-decoration:none}.site-assistant__actions a:hover,.site-assistant__actions a:focus-visible{border-color:rgba(214,173,85,.65);background:rgba(214,173,85,.08)}.site-assistant__fallback{margin-bottom:0;color:var(--color-text-muted)}@media(max-width:560px){.site-assistant{left:.65rem;right:.65rem;bottom:.65rem;width:auto}.site-assistant__details>summary{min-height:2.8rem}.site-assistant__body{max-height:72vh}}@media(prefers-reduced-motion:reduce){.site-assistant__actions a{transition:none}}
</style>
