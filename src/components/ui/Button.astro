---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', class: className, type = 'button' } = Astro.props;
const buttonClass = `ui-button ui-button-${variant}`;
---

{href ? (
  <a href={href} class:list={[buttonClass, className]}>
    <slot />
  </a>
) : (
  <button type={type} class:list={[buttonClass, className]}>
    <slot />
  </button>
)}
