---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  as?: 'section' | 'div' | 'article';
  ariaLabelledby?: string;
}

const { as = 'section', class: className, ariaLabelledby, ...attrs } = Astro.props as Props;
const Tag = as;
---

<Tag class:list={['ui-section', className]} aria-labelledby={ariaLabelledby} {...attrs}>
  <slot />
</Tag>
