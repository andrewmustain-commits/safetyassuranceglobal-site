---
interface TimelineItem {
  title: string;
  detail?: string;
}

interface Props {
  items: TimelineItem[];
  ordered?: boolean;
  class?: string;
}

const { items, ordered = false, class: className } = Astro.props as Props;
const ListTag = ordered ? 'ol' : 'ul';
---

<ListTag class:list={['timeline', className]}>
  {items.map((item) => (
    <li>
      <h3>{item.title}</h3>
      {item.detail && <p>{item.detail}</p>}
    </li>
  ))}
</ListTag>
