---
interface Props {
  showRegisteredArtwork?: boolean;
}

const { showRegisteredArtwork = true } = Astro.props;
---

<section class="home-hero section-shell" aria-labelledby="home-hero-title">
  <div class="hero-grid">
    <div class:list={["hero-copy", showRegisteredArtwork && "has-brand-artwork"]}>
      <p class="eyebrow">SAFETY ASSURANCE GLOBAL</p>
      <h1 id="home-hero-title">Safety assurance command center for high-consequence operations.</h1>
      <p>
        Align governance, field execution, and capability development through one practical operating model.
        SAG helps leadership teams create clarity, accountability, and sustained assurance performance.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="/contact">Book a consultation</a>
        <a class="button-secondary" href="/services">Explore services</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Operational focus areas">
      <h2>Operational Focus</h2>
      <ul>
        <li>Governance and oversight design</li>
        <li>Assurance framework implementation</li>
        <li>Workforce capability uplift</li>
        <li>Continuous performance visibility</li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .home-hero {
    margin-top: 2.2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.2rem;
  }

  .hero-copy {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 14% -12%, rgba(105, 174, 255, 0.2), transparent 36%),
      linear-gradient(148deg, rgba(9, 25, 46, 0.97), rgba(5, 15, 29, 0.98));
    border: 1px solid rgba(140, 185, 246, 0.5);
    box-shadow: 0 18px 36px rgba(3, 10, 22, 0.56);
    border-radius: 1rem;
    padding: clamp(1.45rem, 3vw, 2.2rem);
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    inset: 0.65rem auto 0.65rem 0.65rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(234, 216, 168, 0.78), rgba(105, 174, 255, 0.06));
    z-index: 1;
  }

  .hero-copy > * {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    color: var(--home-accent-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 650;
    font-size: 0.76rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.05rem, 4vw, 3rem);
    line-height: 1.13;
    max-width: 20ch;
  }

  .hero-copy p {
    margin: 1rem 0 0;
    color: var(--home-text-muted);
    max-width: 66ch;
  }

  .hero-actions {
    margin-top: 1.4rem;
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .hero-panel {
    background: linear-gradient(170deg, rgba(8, 22, 43, 0.88), rgba(6, 16, 32, 0.9));
    border: 1px solid rgba(114, 211, 196, 0.34);
    border-radius: 1rem;
    padding: 1.3rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .hero-panel h2 {
    margin: 0;
    font-size: 1.14rem;
    letter-spacing: 0.03em;
  }

  .hero-panel ul {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .hero-panel li {
    color: var(--home-text-muted);
    border: 1px solid rgba(111, 220, 190, 0.26);
    border-radius: 0.7rem;
    padding: 0.6rem 0.7rem;
    background: rgba(111, 220, 190, 0.08);
  }

  @media (min-width: 961px) {
    .hero-copy.has-brand-artwork::after {
      content: '';
      position: absolute;
      right: -6%;
      bottom: -14%;
      width: min(52%, 30rem);
      aspect-ratio: 3 / 2;
      background-image: url('/images/brand/sag-brand-artwork-registered.png');
      background-size: contain;
      background-repeat: no-repeat;
      background-position: bottom right;
      opacity: 0.24;
      filter: saturate(0.82) contrast(1.02);
      pointer-events: none;
      z-index: 0;
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>