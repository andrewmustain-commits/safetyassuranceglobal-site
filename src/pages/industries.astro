---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import { industryDetails } from '../data/industries';

const priorityIndustries = industryDetails.map((industry) => ({
  href: `/industries/${industry.slug}`,
  title: industry.title,
  context: industry.operatingContext
}));

const additionalTargets = [
  'Construction and Capital Projects',
  'Energy and Process Industries',
  'Semiconductor and Advanced Manufacturing',
  'Data Centers and Critical Facilities',
  'Transportation and Public Infrastructure'
];
---

<BaseLayout
  title="Industries"
  description="Industry-focused assurance support for maritime and critical-infrastructure operating environments."
>
  <Container>
    <HeroSection
      id="industries-title"
      badge="Industries Architecture"
      title="Industry pathways for maritime and critical-infrastructure buyers."
    >
      <p>
        Industry support is organized around operating context, common risk patterns, and the assurance evidence
        needed for stronger decisions.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/government" variant="secondary">Government and Infrastructure Support</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="industries-priority-title">
      <SectionHeader badge="Priority Industry Routes" id="industries-priority-title" title="Phase 3 buyer-specific routes." />
      <div class="grid-two">
        {priorityIndustries.map((industry) => (
          <IndustryCard>
            <h3><a href={industry.href}>{industry.title}</a></h3>
            <p>{industry.context}</p>
            <p><a href={industry.href}>View industry detail</a></p>
          </IndustryCard>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="industries-additional-title">
      <SectionHeader
        badge="Additional Priority Markets"
        id="industries-additional-title"
        title="Addressed through critical-infrastructure and service pathways in this phase."
      />
      <Card>
        <ul>
          {additionalTargets.map((target) => (
            <li>{target}</li>
          ))}
        </ul>
        <p>
          These sectors are currently supported through the critical-infrastructure industry route and priority service
          routes, pending deeper validated content for additional buyer-specific child pages.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>
