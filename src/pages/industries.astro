---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import SectorVisualGrid from '../components/ui/SectorVisualGrid.astro';
import { industryDetails } from '../data/industries';

const industryImages = [
  '/images/site-2026/maritime-hero.webp',
  '/images/site-2026/services-hero.webp',
  '/images/site-2026/home-hero.webp',
  '/images/site-2026/about-hero.webp',
  '/images/site-2026/government-hero.webp',
  '/images/site-2026/industries-hero.webp'
];

const priorityIndustries = industryDetails.map((industry, index) => ({
  href: `/industries/${industry.slug}`,
  title: industry.title,
  context: industry.operatingContext,
  image: industryImages[index % industryImages.length]
}));

const additionalTargets = [
  'Construction and Capital Projects',
  'Critical Infrastructure and Public Assets',
  'Energy and Process Industries',
  'Occupational Safety and Industrial Operations',
  'Assurance, Risk, and Governance',
  'Quality and Operational Excellence',
  'Leadership and Workforce Readiness',
  'Technology and Digital Systems',
  'Semiconductor and Advanced Manufacturing',
  'Data Centers and Critical Facilities',
  'Transportation and Public Infrastructure'
];
---

<BaseLayout
  title="Industries"
  description="Maritime-first assurance support with broader capability across critical infrastructure, construction, energy, industrial safety, quality, workforce readiness, and technology-enabled operations."
>
  <Container>
    <HeroSection
      id="industries-title"
      badge="Maritime First | Broader Sector Coverage"
      title="Assurance support shaped around operating context, risk, and evidence."
      image="/images/site-2026/industries-hero.webp"
      imagePosition="center 48%"
    >
      <p>
        Maritime is Safety Assurance Global's primary market. Our assurance, safety, quality, risk, governance,
        readiness, and workforce capabilities can also support other defined high-consequence sectors where the
        engagement scope and available evidence substantiate the work.
      </p>
      <div class="ui-actions">
        <Button href="/maritime">Explore Maritime</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="industries-priority-title">
      <SectionHeader badge="Priority Sectors" id="industries-priority-title" title="Explore support by operating environment." />
      <div class="grid-two">
        {priorityIndustries.map((industry) => (
          <IndustryCard class="image-forward-card image-forward-card-tall image-forward-card-gold" style={`--card-image:url(${industry.image})`}>
            <h3><a href={industry.href}>{industry.title}</a></h3>
            <p>{industry.context}</p>
            <p><a href={industry.href}>View industry detail</a></p>
          </IndustryCard>
        ))}
      </div>
    </Section>

    <SectorVisualGrid />

    <Section ariaLabelledby="industries-additional-title">
      <SectionHeader
        badge="Additional Coverage Areas"
        id="industries-additional-title"
        title="Broader high-consequence sectors supported through defined Safety Assurance Global service pathways."
      />
      <Card class="photo-backed-band" style="--band-image:url(/images/site-2026/industries-hero.webp);--band-position:center 58%">
        <ul>
          {additionalTargets.map((target) => (
            <li>{target}</li>
          ))}
        </ul>
        <p>
          Engagements are accepted and described only to the extent supported by verified personnel capability,
          documented scope, applicable evidence, contractual authority, and jurisdictional requirements. Safety Assurance Global does not
          claim universal accreditation, licensure, regulatory approval, or unrestricted capability across every sector.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>