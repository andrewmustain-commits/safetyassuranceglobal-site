---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const sectors = [
  {
    title: 'Ports and marine terminals',
    problem: 'Need support for operational continuity, evidence, and contractor coordination.',
    focus: 'Compliance readiness, operational readiness, QA/QC, and emergency preparedness.'
  },
  {
    title: 'Shipyards',
    problem: 'Need disciplined field controls and proof of quality and safety execution.',
    focus: 'Contractor assurance, embedded HSE support, and safety risk management.'
  },
  {
    title: 'Vessel operators',
    problem: 'Need practical review of readiness, incident response, and workforce coordination.',
    focus: 'Operational readiness assessments and maritime training support.'
  },
  {
    title: 'Marine contractors',
    problem: 'Need evidence that subcontractors, scope, and field work are under control.',
    focus: 'QA/QC, field verification, and contractor assurance.'
  },
  {
    title: 'Government organizations',
    problem: 'Need controlled support without agency-endorsed claims or overstatement.',
    focus: 'Program assurance, safety and compliance support, and oversight-ready evidence.'
  },
  {
    title: 'Critical infrastructure teams',
    problem: 'Need assurance that controls, documentation, and response paths are ready.',
    focus: 'Independent assurance and risk management support.'
  }
];
---

<BaseLayout title="Industries" description="Safety Assurance Global serves ports, shipyards, vessel operators, marine contractors, government organizations, and critical infrastructure teams.">
  <Container>
    <Section class="industries-hero" ariaLabelledby="industries-title">
      <Badge text="Industries" />
      <h1 id="industries-title">Maritime and critical infrastructure sectors we support.</h1>
      <p>Our industry focus stays close to the buyer problem: readiness, assurance, safety, quality, and control.</p>
      <div class="hero-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/government" variant="secondary">Government support</Button>
      </div>
    </Section>

    <Section ariaLabelledby="sectors-title">
      <div class="section-head">
        <Badge text="Target Sectors" />
        <h2 id="sectors-title">The operating environments most often asking for SAG help.</h2>
      </div>
      <div class="sector-grid">
        {sectors.map((sector) => (
          <Card>
            <h3>{sector.title}</h3>
            <p>{sector.problem}</p>
            <p><strong>Focus:</strong> {sector.focus}</p>
          </Card>
        ))}
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
  .industries-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .industries-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 19ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .sector-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .sector-grid {
      grid-template-columns: 1fr;
    }
  }
</style>