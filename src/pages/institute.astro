---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import { brandAssets } from '../config/brand-assets';

const focusAreas = [
  { title: 'Assurance Foundations', detail: 'Learning designed to strengthen evidence-based thinking, control verification, risk awareness, and operational decision-making.', image: '/images/site-2026/capabilities-hero.webp' },
  { title: 'Workforce Readiness', detail: 'Role-aware development aligned to operational responsibilities, field conditions, and organization-specific readiness needs.', image: '/images/site-2026/institute-hero.webp' },
  { title: 'Sector Learning', detail: 'Programs organized around maritime, construction, critical infrastructure, occupational safety, quality, leadership, and related assurance disciplines.', image: '/images/site-2026/maritime-hero.webp' }
];

const buyerQuestions = [
  ['Who is the audience?', 'Define the roles, experience level, operating environment, and workforce need the training is intended to address.'],
  ['What should learners be able to do?', 'Confirm the practical learning outcomes, role responsibilities, and readiness or performance objectives.'],
  ['How should it be delivered?', 'Confirm whether the proposed need calls for corporate, onsite, or custom delivery and what operating constraints apply.'],
  ['What is actually available?', 'Confirm program status, format, prerequisites, duration, assessment expectations, instructor requirements, and any completion documentation before commitment.']
];
---
<BaseLayout title="Institute of Assurance" description="Corporate gateway to the Safety Assurance Global Institute of Assurance for current course information, program status, workforce-development inquiries, and next steps." noIndex={true}>
  <Container class="institute-shell">
    <section class="institute-hero" aria-labelledby="institute-title">
      <img class="institute-scene" src="/images/site-2026/institute-hero.webp" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
      <span class="institute-overlay" aria-hidden="true"></span>
      <div class="institute-copy">
        <p class="institute-eyebrow">Safety Assurance Global Institute of Assurance</p>
        <h1 id="institute-title">Workforce development connected to operational readiness.</h1>
        <p class="institute-lede">The Safety Assurance Global Institute of Assurance is a professional-education and workforce-development institution associated with the Safety Assurance Global ecosystem. It connects professional development with evidence-first principles used across assurance, safety, risk, QA/QC, and operational-readiness work.</p>
        <div class="ui-actions"><Button href="https://institute.safetyassuranceglobal.com/">Open the Institute Site</Button><Button href="mailto:academy@safetyassuranceglobal.com?subject=Institute%20of%20Assurance%20Inquiry" variant="secondary">Ask About a Workforce Need</Button></div>
      </div>
      <aside class="institute-crest" aria-label="Institute of Assurance identity">
        <div class="crest-halo"></div>
        <img src={brandAssets.instituteSeal} alt="Safety Assurance Global Institute of Assurance seal" width="320" height="320" loading="eager" decoding="async" />
        <p>Learning built around role needs, operating context, evidence, and readiness outcomes.</p>
      </aside>
    </section>

    <Section ariaLabelledby="institute-today-title">
      <SectionHeader badge="What You Can Do Today" id="institute-today-title" title="Use the dedicated Institute site for current offering status." />
      <div class="grid-three">
        <Card><h3>Course information</h3><p><strong>Available now:</strong> review published course and Academy information on the dedicated Institute website.</p><p><a href="https://institute.safetyassuranceglobal.com/">Open Institute information →</a></p></Card>
        <Card><h3>Public enrollment</h3><p><strong>Do not assume enrollment is open.</strong> The current status, prerequisites, assessment expectations, and next action are confirmed for each offering on the Institute site.</p></Card>
        <Card><h3>Employer or workforce need</h3><p><strong>Inquiry available:</strong> employers may contact the Institute team to discuss a defined workforce-development need. An inquiry is not an enrollment or delivery commitment.</p><p><a href="mailto:academy@safetyassuranceglobal.com?subject=Workforce%20Development%20Inquiry">Email the Institute team →</a></p></Card>
      </div>
    </Section>

    <Section ariaLabelledby="institute-purpose-title"><SectionHeader badge="Purpose" id="institute-purpose-title" title="Build capability without separating learning from operational reality." /><Card class="photo-backed-band" style="--band-image:url(/images/site-2026/institute-hero.webp);--band-position:center 55%"><p>Institute programs are intended to support organizations and professionals who need stronger assurance judgment, safer execution, better quality controls, and clearer readiness evidence. Public offerings are presented only when their delivery status and applicable prerequisites are confirmed.</p></Card></Section>

    <Section ariaLabelledby="institute-buyer-title">
      <SectionHeader badge="Training Conversation" id="institute-buyer-title" title="What an employer or procurement team needs to confirm before delivery." />
      <div class="grid-two">
        {buyerQuestions.map(([title, detail]) => <Card><h3>{title}</h3><p>{detail}</p></Card>)}
      </div>
    </Section>

    <Section ariaLabelledby="institute-focus-title"><SectionHeader badge="Learning Focus" id="institute-focus-title" title="Workforce development centered on assurance and readiness." /><div class="grid-three">{focusAreas.map((area) => <Card class="image-forward-card image-forward-card-tall image-forward-card-gold" style={`--card-image:url(${area.image})`}><span class="focus-mark" aria-hidden="true">◆</span><h3>{area.title}</h3><p>{area.detail}</p></Card>)}</div></Section>

    <Section ariaLabelledby="institute-relationship-title"><SectionHeader badge="Relationship to Safety Assurance Global" id="institute-relationship-title" title="Learning supports the same operating problems addressed by assurance work." /><div class="grid-two"><Card class="image-forward-card" style="--card-image:url(/images/site-2026/services-hero.webp)"><h3>Assurance can identify learning needs</h3><p>Training priorities can be shaped by verified control gaps, role requirements, readiness findings, and operating context.</p></Card><Card class="image-forward-card" style="--card-image:url(/images/site-2026/home-hero.webp)"><h3>Learning can support readiness</h3><p>Programs can be structured to reinforce practical performance, decision quality, accountability, and sustained operational improvement.</p></Card></div></Section>

    <Section ariaLabelledby="institute-contact-title"><SectionHeader badge="Institute Contact" id="institute-contact-title" title="Questions about training or workforce development?" /><Card class="photo-backed-band" style="--band-image:url(/images/site-2026/contact-hero.webp);--band-position:center 50%"><p>Email the Institute team at <a href="mailto:academy@safetyassuranceglobal.com">academy@safetyassuranceglobal.com</a>.</p></Card></Section>

    <Section ariaLabelledby="institute-boundary-title"><SectionHeader badge="Plain-Language Status" id="institute-boundary-title" title="Check the offering before you rely on availability." /><NoticePanel tone="warning" title="Current-status rule"><p><strong>Information available</strong> does not mean <strong>enrollment open</strong>. Course availability, delivery format, prerequisites, assessment requirements, recognition or approval claims, and any credential decision remain offering-specific and are confirmed on the dedicated Institute site or directly by the Institute team before commitment.</p></NoticePanel></Section>
  </Container>
</BaseLayout>
<style>
.institute-shell{display:grid;gap:clamp(1.5rem,3vw,2.5rem);padding-top:1rem}.institute-hero{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;overflow:hidden;min-height:clamp(31rem,58vw,42rem);padding:clamp(2rem,6vw,5rem);border:1px solid rgba(202,164,79,.42);border-radius:1.25rem;background:#081524;box-shadow:0 26px 60px rgba(0,0,0,.3)}.institute-scene,.institute-overlay{position:absolute;inset:0;width:100%;height:100%}.institute-scene{z-index:0;object-fit:cover;object-position:center 50%;filter:saturate(.96) contrast(1.03)}.institute-overlay{z-index:1;background:linear-gradient(90deg,rgba(4,15,28,.97) 0%,rgba(4,15,28,.86) 38%,rgba(4,15,28,.45) 70%,rgba(4,15,28,.24) 100%),linear-gradient(180deg,rgba(3,12,22,.04),rgba(3,12,22,.42))}.institute-hero:before{content:'';position:absolute;z-index:1;inset:0;opacity:.1;pointer-events:none;background-image:radial-gradient(rgba(148,163,184,.7) .7px,transparent .7px);background-size:20px 20px;mask-image:linear-gradient(to right,black,transparent 85%)}.institute-copy,.institute-crest{position:relative;z-index:2}.institute-eyebrow{margin:0 0 .7rem;color:#caa44f;font-size:.78rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.institute-copy h1{max-width:14ch;font-size:clamp(2.5rem,5.7vw,5rem);line-height:1;letter-spacing:-.04em}.institute-lede{max-width:760px;color:#e1e8ef;font-size:clamp(1.03rem,1.7vw,1.2rem)}.institute-crest{display:grid;place-items:center;text-align:center}.institute-crest img{position:relative;z-index:1;width:min(100%,300px);height:auto;filter:drop-shadow(0 24px 38px rgba(0,0,0,.42));transform:translateZ(0)}.institute-crest p{max-width:30ch;margin-top:1.2rem;color:#d0d9e3;font-size:.86rem}.crest-halo{position:absolute;width:min(95%,350px);aspect-ratio:1;border:1px solid rgba(202,164,79,.3);border-radius:50%;box-shadow:inset 0 0 75px rgba(37,99,235,.14),0 0 90px rgba(37,99,235,.12)}.focus-mark{display:block;margin-bottom:.8rem;color:#f3aa35;font-size:.72rem}@media(max-width:850px){.institute-hero{grid-template-columns:1fr}.institute-crest{display:grid;max-width:15rem;justify-self:center}.institute-crest img{width:min(72vw,220px)}.crest-halo{width:min(78vw,260px)}}@media(max-width:600px){.institute-hero{min-height:40rem;padding:1.5rem;align-content:end}.institute-copy h1{font-size:clamp(2.35rem,12vw,4rem)}.institute-crest{display:none}.institute-overlay{background:linear-gradient(180deg,rgba(4,15,28,.15) 0%,rgba(4,15,28,.65) 48%,rgba(4,15,28,.97) 100%)}.institute-crest p{font-size:.8rem}}
</style>