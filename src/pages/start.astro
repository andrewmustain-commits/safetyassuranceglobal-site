---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const environments = [
  'Maritime or Port Operations',
  'Shipyard or Vessel Operations',
  'Government or Public Infrastructure',
  'Construction or Capital Project',
  'Critical Infrastructure or Facility',
  'Industrial or Process Operations',
  'Training or Workforce Development',
  'Other Defined Scope'
];

const needs = [
  'Operational Readiness',
  'Independent Assurance',
  'QA/QC and Quality Oversight',
  'Contractor Assurance',
  'Safety and Risk Management',
  'Compliance Readiness',
  'Incident Investigation',
  'Embedded HSE Support',
  'Emergency Preparedness',
  'Program Assurance',
  'Training and Workforce Development',
  'Not Sure Yet'
];

const stages = [
  'Planning or pre-solicitation',
  'Pre-mobilization or startup',
  'Active operations or execution',
  'Audit or verification preparation',
  'Corrective-action closeout',
  'Post-incident or lessons learned',
  'Not sure yet'
];

const outcomes = [
  'Readiness decision support',
  'Independent verification',
  'Gap and action visibility',
  'Corrective-action validation',
  'Executive reporting',
  'Contractor oversight',
  'Quality verification',
  'Defined training or workforce-development path',
  'Not Sure Yet'
];

const schedules = [
  'Immediate or urgent planning',
  'Within 30 days',
  'Within 90 days',
  'Future quarter planning',
  'Exploratory or pre-solicitation'
];
---

<BaseLayout
  title="Start a Scope"
  description="Build a preliminary Safety Assurance Global engagement path from your operating environment, assurance need, decision point, desired output, and schedule."
>
  <Container class="scope-builder-page">
    <HeroSection
      id="scope-builder-title"
      badge="Start With the Requirement"
      title="Build a preliminary assurance scope in a few minutes."
      image="/images/site-2026/home-hero.webp"
      imagePosition="center 52%"
    >
      <p>Choose the operating environment, decision point, assurance need, desired output, and timing. The builder will organize a preliminary engagement path without collecting your name, email, or project-sensitive free text.</p>
      <div class="ui-actions">
        <Button href="#scope-builder">Build Your Scope</Button>
        <Button href="/proof" variant="secondary">Review Evidence & Deliverables</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="scope-builder-section-title">
      <SectionHeader badge="Guided Scoping" id="scope-builder-section-title" title="Tell us what needs to be proven." />
      <div class="scope-builder-shell" id="scope-builder" data-scope-builder>
        <form class="scope-builder-form" data-scope-builder-form>
          <div class="scope-builder-grid">
            <label for="scope-environment">
              <span>1. Operating environment</span>
              <select id="scope-environment" name="environment" required>
                <option value="">Select environment</option>
                {environments.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label for="scope-stage">
              <span>2. Where are you in the lifecycle?</span>
              <select id="scope-stage" name="stage" required>
                <option value="">Select stage</option>
                {stages.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label for="scope-need">
              <span>3. What needs assurance?</span>
              <select id="scope-need" name="need" required>
                <option value="">Select need</option>
                {needs.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label for="scope-outcome">
              <span>4. What decision or output do you need?</span>
              <select id="scope-outcome" name="outcome" required>
                <option value="">Select outcome</option>
                {outcomes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label class="scope-builder-wide" for="scope-schedule">
              <span>5. When do you need support?</span>
              <select id="scope-schedule" name="schedule" required>
                <option value="">Select timing</option>
                {schedules.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
          </div>

          <div class="scope-builder-actions">
            <button class="ui-button ui-button-primary" type="submit">Build Preliminary Scope</button>
            <button class="ui-button ui-button-secondary" type="reset">Start Over</button>
          </div>
          <p class="scope-builder-state" data-scope-stale-status aria-live="polite"></p>
          <p class="scope-builder-privacy">This tool uses only the selections above in your browser. It does not transmit them until you choose to continue to a proposal request.</p>
        </form>

        <section class="scope-result" data-scope-result hidden aria-live="polite" aria-labelledby="scope-result-title">
          <p class="eyebrow">Preliminary engagement map</p>
          <h2 id="scope-result-title" data-result-title>Recommended starting point</h2>
          <p data-result-summary></p>
          <div class="scope-result-grid">
            <div><span>Operating environment</span><strong data-result-environment></strong></div>
            <div><span>Lifecycle stage</span><strong data-result-stage></strong></div>
            <div><span>Primary need</span><strong data-result-need></strong></div>
            <div><span>Decision / output</span><strong data-result-outcome></strong></div>
            <div><span>Timing</span><strong data-result-schedule></strong></div>
          </div>
          <div>
            <h3>Typical outputs to discuss</h3>
            <ul class="scope-output-list" data-result-outputs></ul>
          </div>
          <p class="scope-result-boundary">This is an informational routing aid, not an assurance conclusion, proposal, availability commitment, qualification decision, regulatory determination, or fixed scope. Final work is defined against the actual requirement and evidence.</p>
          <div class="ui-actions">
            <a class="ui-button ui-button-primary" href="/request-proposal" data-scope-proposal-link>Continue to Proposal Request</a>
            <a class="ui-button ui-button-secondary" href="/contact">Discuss It First</a>
          </div>
        </section>
      </div>
    </Section>

    <Section ariaLabelledby="scope-next-title">
      <SectionHeader badge="What Happens Next" id="scope-next-title" title="A simple path from preliminary scope to a defined engagement." />
      <div class="grid-four">
        <Card><span class="step-number">01</span><h3>Share context</h3><p>Add the location, scope details, procurement context, and required outcome through the proposal path.</p></Card>
        <Card><span class="step-number">02</span><h3>Confirm fit</h3><p>Safety Assurance Global evaluates the requested work, qualifications, availability, jurisdiction, evidence needs, and delivery assumptions.</p></Card>
        <Card><span class="step-number">03</span><h3>Define the work</h3><p>Scope, responsibilities, acceptance criteria, schedule, deliverables, and commercial terms are established before work begins.</p></Card>
        <Card><span class="step-number">04</span><h3>Execute against evidence</h3><p>The engagement follows the agreed requirement-to-evidence process and produces the defined work products.</p></Card>
      </div>
    </Section>
  </Container>
</BaseLayout>

<script is:inline src="/scripts/scope-builder.e639faf0074d.js" defer></script>

<style>
.scope-builder-page{display:grid;gap:.25rem}.scope-builder-shell{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(1.5rem,4vw,3rem);align-items:start}.scope-builder-form,.scope-result{border:1px solid rgba(148,163,184,.2);border-radius:1.2rem;background:linear-gradient(145deg,rgba(15,23,42,.94),rgba(9,18,31,.82));padding:clamp(1.1rem,3vw,2rem);box-shadow:var(--shadow-panel)}.scope-builder-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.scope-builder-grid label{display:grid;gap:.45rem}.scope-builder-grid label>span{font-size:.82rem;font-weight:800;color:#e2e8f0}.scope-builder-grid select{width:100%;min-height:3.15rem;padding:.7rem .75rem;border:1px solid rgba(148,163,184,.3);border-radius:.7rem;background:#0b1424;color:#fff;font:inherit}.scope-builder-grid select:focus{border-color:#60a5fa;outline:2px solid rgba(96,165,250,.25);outline-offset:1px}.scope-builder-wide{grid-column:1/-1}.scope-builder-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.25rem}.scope-builder-state{min-height:1.4em;margin:.7rem 0 0;color:#f8d88a;font-size:.86rem;font-weight:700}.scope-builder-privacy,.scope-result-boundary{font-size:.84rem;color:var(--color-text-soft);line-height:1.6}.scope-result{position:sticky;top:7rem}.scope-result h2{margin:.25rem 0 .75rem}.scope-result-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:1.25rem 0}.scope-result-grid>div{display:grid;gap:.2rem;padding:.75rem;border-top:1px solid rgba(148,163,184,.2)}.scope-result-grid span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8}.scope-result-grid strong{font-size:.9rem}.scope-output-list{display:grid;gap:.45rem;padding-left:1.2rem}.step-number{display:inline-block;margin-bottom:.6rem;color:var(--color-accent);font-weight:900;letter-spacing:.1em}@media(max-width:900px){.scope-builder-shell{grid-template-columns:1fr}.scope-result{position:static}}@media(max-width:640px){.scope-builder-grid,.scope-result-grid{grid-template-columns:1fr}.scope-builder-wide{grid-column:auto}}
</style>
