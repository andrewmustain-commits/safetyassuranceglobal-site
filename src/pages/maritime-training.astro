---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';

const audiences = [
  'Shipyard safety and operations teams',
  'Port and marine terminal supervisors',
  'Vessel-operations leadership and crews',
  'Marine contractor management and field teams',
  'Government maritime program stakeholders',
  'Workforce-development and compliance buyers'
];

const options = [
  'Corporate Delivery Available',
  'Available by Arrangement',
  'Not Currently Open for Enrollment'
] as const;

const categories = [
  { name: 'Maritime Safety Fundamentals', status: 'Corporate Delivery Available' as const },
  { name: 'Shipyard Safety', status: 'Available by Arrangement' as const },
  { name: 'Ports and Marine Terminals', status: 'Available by Arrangement' as const },
  { name: 'Vessel Operations', status: 'Available by Arrangement' as const },
  { name: 'Hazardous Work', status: 'Controlled Pilot' as const },
  { name: 'Emergency Preparedness', status: 'Corporate Delivery Available' as const },
  { name: 'Maritime Security', status: 'In Development' as const },
  { name: 'Cybersecurity Awareness', status: 'In Development' as const },
  { name: 'Environmental Compliance', status: 'Available by Arrangement' as const },
  { name: 'Maritime Risk Management', status: 'Corporate Delivery Available' as const },
  { name: 'Maritime QA/QC', status: 'Available by Arrangement' as const },
  { name: 'Contractor Assurance', status: 'Available by Arrangement' as const },
  { name: 'Operational Readiness', status: 'Corporate Delivery Available' as const },
  { name: 'Incident Investigation', status: 'Controlled Pilot' as const },
  { name: 'Maritime Safety Leadership', status: 'Coming Soon' as const }
];
---

<BaseLayout
  title="Maritime Training"
  description="Maritime workforce training support with controlled delivery statuses and inquiry-based scope confirmation."
>
  <Container>
    <Section class="hero-panel" ariaLabelledby="maritime-training-title">
      <Badge text="Maritime Training" />
      <h1 id="maritime-training-title">Maritime workforce training aligned to readiness priorities.</h1>
      <p>
        Maritime training is delivered as a supporting capability for consulting and assurance engagements.
        Program scope, availability, and delivery format are confirmed before enrollment or contract award.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Training Inquiry</Button>
        <Button href="/request-proposal" variant="secondary">Request a Proposal</Button>
      </div>
    </Section>

    <Section ariaLabelledby="mt-who-title">
      <SectionHeader badge="Who Training Is For" id="mt-who-title" title="Priority maritime audiences." />
      <div class="grid-three">
        {audiences.map((audience) => (
          <Card><h3>{audience}</h3></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="mt-delivery-options-title">
      <SectionHeader badge="Delivery Options" id="mt-delivery-options-title" title="How maritime training can be delivered." />
      <div class="grid-three">
        {options.map((option) => (
          <Card>
            <StatusBadge status={option} />
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="mt-availability-title">
      <SectionHeader badge="Current Availability" id="mt-availability-title" title="Status-controlled public availability model." />
      <NoticePanel tone="info" title="Current Availability Policy" class="qualification-notice">
        <p>
          Public listings reflect controlled statuses. Program availability is verified through inquiry,
          scope review, and resource confirmation.
        </p>
      </NoticePanel>
    </Section>

    <Section ariaLabelledby="mt-corporate-onsite-title">
      <SectionHeader
        badge="Corporate and Onsite Delivery"
        id="mt-corporate-onsite-title"
        title="Delivery planning is structured around site context and workforce needs."
      />
      <div class="grid-two">
        <Card>
          <h3>Corporate delivery</h3>
          <p>Configured for organizational teams with role-based priorities and implementation timelines.</p>
        </Card>
        <Card>
          <h3>Onsite delivery</h3>
          <p>Adapted to facility operations, safety controls, and practical execution constraints.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="mt-categories-title">
      <SectionHeader badge="Training Categories" id="mt-categories-title" title="Maritime training categories and current labels." />
      <div class="grid-three">
        {categories.map((category) => (
          <Card>
            <h3>{category.name}</h3>
            <StatusBadge status={category.status} />
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="mt-custom-programs-title">
      <SectionHeader badge="Custom Workforce Programs" id="mt-custom-programs-title" title="Programs can be tailored after training-needs assessment." />
      <Card>
        <p>
          Custom pathways are built from role expectations, risk profile, incident trends, and readiness goals.
          Final scope is documented before delivery.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="mt-status-title">
      <SectionHeader badge="Status Explanation" id="mt-status-title" title="What each controlled status means." />
      <div class="grid-two">
        <Card><h3>Available by Arrangement</h3><p>Deliverable when scope, team availability, and prerequisites are confirmed.</p></Card>
        <Card><h3>Corporate Delivery Available</h3><p>Ready for organization-led cohorts through inquiry and planning.</p></Card>
        <Card><h3>Controlled Pilot</h3><p>Limited-scope offering for selected implementations.</p></Card>
        <Card><h3>In Development / Coming Soon</h3><p>Not currently open for enrollment; listed for transparency only.</p></Card>
      </div>
    </Section>

    <Section ariaLabelledby="mt-standards-title">
      <SectionHeader badge="Delivery Standards" id="mt-standards-title" title="How delivery quality is governed." />
      <Card>
        <ul>
          <li>Defined scope and role fit before delivery</li>
          <li>Alignment with readiness and assurance objectives</li>
          <li>Documented assumptions, constraints, and prerequisites</li>
          <li>Post-delivery feedback and improvement tracking</li>
        </ul>
      </Card>
    </Section>

    <Section ariaLabelledby="mt-faq-title">
      <SectionHeader badge="FAQs" id="mt-faq-title" title="Common questions about maritime training availability." />
      <div class="grid-two">
        <Card>
          <h3>Do you publish open-enrollment schedules?</h3>
          <p>No. Availability is confirmed through inquiry and scope review.</p>
        </Card>
        <Card>
          <h3>Are certifications guaranteed?</h3>
          <p>No. Certification or recognition status varies by program and must be confirmed case-by-case.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="mt-cta-title">
      <div class="cta-band">
        <SectionHeader
          badge="Training Inquiry"
          id="mt-cta-title"
          title="Discuss maritime training scope and delivery options."
        />
        <div class="ui-actions">
          <Button href="/contact">Training Inquiry</Button>
        </div>
      </div>
    </Section>

    <Section ariaLabelledby="mt-disclaimer-title">
      <NoticePanel tone="warning" title="Required Disclaimer" class="qualification-notice" id="mt-disclaimer-title">
        <p>
          Course availability, delivery format, prerequisites, recognition, and certification status vary by program.
          Safety Assurance Global will confirm the applicable scope and status before enrollment or contract award.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>
