---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const records = [
  {
    requirement: 'Mobilization controls are assigned, documented, and supported by current evidence before critical work begins.',
    observed: 'The synthetic contractor readiness file contains the mobilization plan and control assignments, but two role-verification records are not present in the initial evidence set.',
    evidence: 'DEMO-EV-011 mobilization plan; DEMO-EV-014 training matrix; DEMO-EV-017 role-assignment register',
    owner: 'Demo Contractor Manager',
    action: 'Provide the missing role-verification records and update the controlled training matrix.',
    closure: 'DEMO-EV-021 updated training matrix; DEMO-EV-022 role-verification records; DEMO-EV-023 supervisor review',
    disposition: 'Verified closed in the synthetic example'
  },
  {
    requirement: 'Inspection hold points are defined and traceable to the applicable work package before execution.',
    observed: 'The synthetic work package identifies inspection requirements, but one hold point is not linked to a named acceptance record.',
    evidence: 'DEMO-EV-031 work package; DEMO-EV-034 inspection plan',
    owner: 'Demo Quality Lead',
    action: 'Assign the missing acceptance record and update the inspection plan revision.',
    closure: 'DEMO-EV-038 revised inspection plan; DEMO-EV-039 acceptance-record index',
    disposition: 'Verified closed in the synthetic example'
  },
  {
    requirement: 'Open readiness actions have an owner, due date, required closure evidence, and current disposition.',
    observed: 'The synthetic action register contains all required fields and no unassigned high-priority action.',
    evidence: 'DEMO-EV-044 readiness action register',
    owner: 'Demo Project Controls Lead',
    action: 'No corrective action required for this demonstration item.',
    closure: 'Not applicable',
    disposition: 'Conforming demonstration item'
  }
];
---

<BaseLayout
  title="Completed Demonstration"
  description="A completed synthetic Safety Assurance Global assurance work-product example showing requirement, evidence, finding, action, closure evidence, and disposition without implying customer past performance."
  image="/images/site-2026/capabilities-hero.webp"
>
  <Container class="completed-example-page">
    <HeroSection
      id="completed-example-title"
      badge="Synthetic Demonstration"
      title="Inspect a completed example from requirement through verified disposition."
      image="/images/site-2026/capabilities-hero.webp"
      imagePosition="center 48%"
    >
      <p>This demonstration uses invented project names, record numbers, people, conditions, and outcomes so a buyer can evaluate the structure and level of detail without mistaking the example for Safety Assurance Global corporate past performance.</p>
      <div class="ui-actions">
        <Button href="/downloads/completed-readiness-demonstration.csv">Download Demonstration CSV</Button>
        <Button href="/start" variant="secondary">Build a Scope</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="demo-summary-title">
      <SectionHeader badge="Demonstration Executive Summary" id="demo-summary-title" title="Synthetic pre-mobilization readiness review." />
      <div class="demo-summary">
        <Card><span>Decision point</span><strong>Pre-mobilization readiness review</strong><p>Illustrative only</p></Card>
        <Card><span>Evidence set</span><strong>9 synthetic records</strong><p>Invented identifiers</p></Card>
        <Card><span>Initial gaps</span><strong>2 demonstration gaps</strong><p>Both carried to action</p></Card>
        <Card><span>Final disposition</span><strong>2 verified closures</strong><p>Demonstration outcome only</p></Card>
      </div>
      <p class="demo-boundary"><strong>Synthetic data:</strong> no customer, shipyard, vessel, agency, contractor, project, inspection, incident, or actual business result is represented on this page.</p>
    </Section>

    <Section ariaLabelledby="demo-record-title">
      <SectionHeader badge="Traceable Records" id="demo-record-title" title="The buyer can follow each item from requirement to disposition." />
      <div class="demo-records">
        {records.map((record, index) => (
          <article class="demo-record">
            <header><span>{String(index + 1).padStart(2, '0')}</span><div><p>Synthetic assurance record</p><h3>{record.requirement}</h3></div></header>
            <dl>
              <div><dt>Observed condition</dt><dd>{record.observed}</dd></div>
              <div><dt>Supporting evidence</dt><dd>{record.evidence}</dd></div>
              <div><dt>Action owner</dt><dd>{record.owner}</dd></div>
              <div><dt>Corrective action</dt><dd>{record.action}</dd></div>
              <div><dt>Closure evidence</dt><dd>{record.closure}</dd></div>
              <div><dt>Disposition</dt><dd><strong>{record.disposition}</strong></dd></div>
            </dl>
          </article>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="demo-buyer-title">
      <SectionHeader badge="What This Shows" id="demo-buyer-title" title="A finished work product is more than a list of fields." />
      <div class="grid-two">
        <Card><h3>Traceability</h3><p>The requirement, observed condition, evidence reference, action owner, corrective action, closure evidence, and disposition stay connected.</p></Card>
        <Card><h3>Decision context</h3><p>The work product explains what decision it supports and separates an open gap from a verified closure.</p></Card>
        <Card><h3>Evidence discipline</h3><p>Closure depends on identified evidence rather than a status label alone.</p></Card>
        <Card><h3>Truth boundary</h3><p>This demonstration explains delivery quality without inventing a customer relationship or claiming that the synthetic outcome occurred in the field.</p></Card>
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
.completed-example-page{display:grid;gap:.25rem}.demo-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.demo-summary .ui-card{min-height:9.5rem}.demo-summary span{display:block;color:#94a3b8;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.demo-summary strong{display:block;margin:.5rem 0;color:#fff;font-size:1.08rem}.demo-summary p{font-size:.82rem}.demo-boundary{margin-top:1rem;padding:.85rem 1rem;border-left:3px solid #d6ad55;background:rgba(214,173,85,.08);font-size:.9rem}.demo-records{display:grid;gap:1rem}.demo-record{padding:clamp(1.1rem,3vw,1.8rem);border:1px solid rgba(148,163,184,.22);border-radius:1rem;background:linear-gradient(145deg,rgba(15,23,42,.94),rgba(9,18,31,.86))}.demo-record header{display:grid;grid-template-columns:3rem 1fr;gap:1rem}.demo-record header>span{color:#f1d493;font-size:.72rem;font-weight:900;letter-spacing:.1em}.demo-record header p{margin:0 0 .25rem;color:#94a3b8;font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.demo-record h3{margin:0;font-size:clamp(1.15rem,2vw,1.55rem)}.demo-record dl{margin:1.15rem 0 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1.25rem}.demo-record dl>div{padding:.9rem 0;border-top:1px solid rgba(148,163,184,.2)}.demo-record dt{color:#94a3b8;font-size:.72rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.demo-record dd{margin:.35rem 0 0;color:#e2e8f0}.demo-record dd strong{color:#f8fafc}@media(max-width:820px){.demo-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.demo-summary,.demo-record dl{grid-template-columns:1fr}}
</style>
