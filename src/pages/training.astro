---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const deliveryModes = [
  {
    title: 'Corporate delivery',
    detail: 'Programs scoped for employer teams, operations groups, and project organizations with readiness goals.'
  },
  {
    title: 'Onsite delivery',
    detail: 'Site-aware delivery aligned to operational constraints, safety controls, and role responsibilities.'
  },
  {
    title: 'Custom workforce programs',
    detail: 'Role-based pathways built from training-needs assessments, assurance findings, and workforce requirements.'
  }
];

const availabilityStates = [
  {
    title: 'Confirmed for proposal',
    detail: 'Used only when the specific program, delivery format, prerequisites, assessment expectations, and delivery assumptions have been verified for the proposed engagement.'
  },
  {
    title: 'Custom development',
    detail: 'Used when training must be created or adapted around a defined workforce need. Scope, review, schedule, and delivery assumptions are confirmed before a commitment is made.'
  },
  {
    title: 'Pilot or controlled program',
    detail: 'Used when a program is being evaluated in a limited or controlled context. Pilot status and limitations are stated before the organization relies on the offering.'
  },
  {
    title: 'Not open for enrollment',
    detail: 'Programs without confirmed public enrollment status are not represented as open or generally available on this site.'
  }
];

const buyerSafeguards = [
  'Training-needs assessment before final scope where needed',
  'Role-based delivery planning and prerequisites review',
  'Program status confirmed before enrollment or delivery claims',
  'Inquiry and proposal review before delivery commitments',
  'Accreditation, approval, recognition, and credential claims limited to verified evidence'
];
---

<BaseLayout
  title="Training"
  description="Training and workforce-development offerings governed through the Safety Assurance Global Institute of Assurance and aligned to operational readiness, assurance, safety, quality, and risk needs."
>
  <Container>
    <HeroSection
      id="training-title"
      badge="Institute Training Hub"
      title="Workforce development connected to assurance and operational readiness."
    >
      <p>
        Safety Assurance Global delivers training through the Institute of Assurance as a supporting capability
        for organizations and professionals. Public offerings are scoped around roles, risks, operating context, and
        readiness outcomes rather than presented as universally available or automatically credential-bearing.
      </p>
      <div class="ui-actions">
        <Button href="/maritime-training">Explore Maritime Training</Button>
        <Button href="mailto:academy@safetyassuranceglobal.com?subject=Training%20and%20Workforce%20Development%20Inquiry" variant="secondary">Email the Institute</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="training-delivery-title">
      <SectionHeader
        badge="Delivery Model"
        id="training-delivery-title"
        title="Corporate, onsite, and custom program delivery options."
      />
      <div class="grid-three">
        {deliveryModes.map((mode) => (
          <Card>
            <h3>{mode.title}</h3>
            <p>{mode.detail}</p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="training-availability-title">
      <SectionHeader
        badge="Availability Status"
        id="training-availability-title"
        title="Every program should fit one clear status before a buyer relies on it."
      />
      <div class="grid-two">
        {availabilityStates.map((state) => (
          <Card>
            <h3>{state.title}</h3>
            <p>{state.detail}</p>
          </Card>
        ))}
      </div>
      <p class="availability-note">These are status definitions, not a representation that every course or program currently occupies a particular status. Specific availability is confirmed during the inquiry or proposal process.</p>
    </Section>

    <Section ariaLabelledby="training-process-title">
      <SectionHeader
        badge="Inquiry Process"
        id="training-process-title"
        title="How training scope is confirmed."
      />
      <div class="grid-two">
        <Card>
          <h3>1. Clarify workforce objectives</h3>
          <p>Confirm roles, risk profile, operating conditions, and expected readiness outcomes.</p>
        </Card>
        <Card>
          <h3>2. Confirm delivery constraints</h3>
          <p>Define onsite, corporate, and custom requirements, including delivery status and prerequisites.</p>
        </Card>
        <Card>
          <h3>3. Align with assurance priorities</h3>
          <p>Connect learning scope to verified control gaps, role requirements, and operational-improvement priorities.</p>
        </Card>
        <Card>
          <h3>4. Finalize the scoped offering</h3>
          <p>Confirm program status, delivery assumptions, assessment expectations, and applicable qualification notices.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="training-contact-title">
      <SectionHeader badge="Institute Contact" id="training-contact-title" title="Training and workforce-development inquiries." />
      <Card><p>Email <a href="mailto:academy@safetyassuranceglobal.com">academy@safetyassuranceglobal.com</a> for Institute and Academy inquiries.</p></Card>
    </Section>

    <Section ariaLabelledby="training-controls-title">
      <SectionHeader
        badge="Buyer Safeguards"
        id="training-controls-title"
        title="What is checked before a training commitment is made."
      />
      <Card>
        <ul>
          {buyerSafeguards.map((control) => (
            <li>{control}</li>
          ))}
        </ul>
      </Card>
    </Section>

    <Section ariaLabelledby="training-boundary-title">
      <SectionHeader
        badge="Boundary Notice"
        id="training-boundary-title"
        title="Program, enrollment, and credential status remain offering-specific."
      />
      <NoticePanel tone="warning" title="Qualification Notice" class="qualification-notice">
        <p>
          This site does not represent every program as open for enrollment and does not publish unsupported claims about
          external accreditation, regulatory approval, universal recognition, or automatic credential issuance. Delivery
          status and applicable requirements are confirmed per program before enrollment or contract award.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>

<style>
  .availability-note { max-width:82ch; margin-top:1rem; color:var(--color-text-soft); font-size:.9rem; line-height:1.65; }
</style>
