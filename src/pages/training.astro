---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const deliveryModes = [
  {
    title: 'Corporate delivery',
    detail: 'Programs scoped for employer teams, operations groups, and project organizations with readiness goals.'
  },
  {
    title: 'Onsite delivery',
    detail: 'Site-aware delivery aligned to operational constraints, safety controls, and role responsibilities.'
  },
  {
    title: 'Custom workforce programs',
    detail: 'Role-based pathways built from training-needs assessments, assurance findings, and workforce requirements.'
  }
];

const controls = [
  'Training-needs assessments before final scope',
  'Role-based delivery planning and prerequisites review',
  'Program status controls before public enrollment claims',
  'Inquiry and proposal process before delivery commitments',
  'Conservative public language for approvals, accreditation, and credential claims'
];
---

<BaseLayout
  title="Training"
  description="Training and workforce-development offerings governed through the Safety Assurance Global Institute of Assurance and aligned to operational readiness, assurance, safety, quality, and risk needs."
>
  <Container>
    <HeroSection
      id="training-title"
      badge="Institute Training Hub"
      title="Workforce development connected to assurance and operational readiness."
    >
      <p>
        Safety Assurance Global delivers training through the Institute of Assurance as a governed supporting capability
        for organizations and professionals. Public offerings are scoped around roles, risks, operating context, and
        readiness outcomes rather than presented as universally available or automatically credential-bearing.
      </p>
      <div class="ui-actions">
        <Button href="/maritime-training">Explore Maritime Training</Button>
        <Button href="/institute" variant="secondary">About the Institute</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="training-delivery-title">
      <SectionHeader
        badge="Delivery Model"
        id="training-delivery-title"
        title="Corporate, onsite, and custom program delivery options."
      />
      <div class="grid-three">
        {deliveryModes.map((mode) => (
          <Card>
            <h3>{mode.title}</h3>
            <p>{mode.detail}</p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="training-process-title">
      <SectionHeader
        badge="Inquiry Process"
        id="training-process-title"
        title="How training scope is confirmed."
      />
      <div class="grid-two">
        <Card>
          <h3>1. Clarify workforce objectives</h3>
          <p>Confirm roles, risk profile, operating conditions, and expected readiness outcomes.</p>
        </Card>
        <Card>
          <h3>2. Confirm delivery constraints</h3>
          <p>Define onsite, corporate, and custom requirements, including delivery status and prerequisites.</p>
        </Card>
        <Card>
          <h3>3. Align with assurance priorities</h3>
          <p>Connect learning scope to verified control gaps, role requirements, and operational-improvement priorities.</p>
        </Card>
        <Card>
          <h3>4. Finalize governed scope</h3>
          <p>Confirm program status, delivery assumptions, assessment expectations, and applicable qualification notices.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="training-controls-title">
      <SectionHeader
        badge="Governance Controls"
        id="training-controls-title"
        title="Controls used to keep public training claims accurate."
      />
      <Card>
        <ul>
          {controls.map((control) => (
            <li>{control}</li>
          ))}
        </ul>
      </Card>
    </Section>

    <Section ariaLabelledby="training-boundary-title">
      <SectionHeader
        badge="Boundary Notice"
        id="training-boundary-title"
        title="Program, enrollment, and credential status remain controlled."
      />
      <NoticePanel tone="warning" title="Qualification Notice" class="qualification-notice">
        <p>
          This site does not represent every program as open for enrollment and does not publish unsupported claims about
          external accreditation, regulatory approval, universal recognition, or automatic credential issuance. Delivery
          status and applicable requirements are confirmed per program before enrollment or contract award.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>
