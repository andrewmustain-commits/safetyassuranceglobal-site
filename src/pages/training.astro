---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Training" description="Practical safety assurance training programs for leaders, practitioners, and operational teams.">
  <section class="hero training-hero">
    <div class="container">
      <p class="training-eyebrow">Executive Education</p>
      <h1>Training</h1>
      <p>Role-based programs that build confidence in assurance methods, governance responsibilities, and operational decision-making.</p>
    </div>
  </section>

  <section class="section training-programs">
    <div class="container">
      <div class="training-section-head">
        <p class="training-section-label">Program Formats</p>
        <h2>Professional pathways for leaders and assurance teams.</h2>
      </div>
      <div class="grid">
        <div class="card training-card"><h3>Executive Briefings</h3><p>Focused sessions for leaders on accountability, assurance governance, and decision quality.</p></div>
        <div class="card training-card"><h3>Practitioner Bootcamps</h3><p>Hands-on training in assurance planning, evidence management, and review techniques.</p></div>
        <div class="card training-card"><h3>Team Workshops</h3><p>Scenario-based facilitation to align cross-functional teams around practical controls.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-hero {
    position: relative;
    overflow: hidden;
  }

  .training-hero::before {
    content: '';
    position: absolute;
    inset: 0.8rem auto 0.8rem clamp(0.8rem, 3vw, 1.2rem);
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(234, 216, 168, 0.88), rgba(105, 174, 255, 0.08));
  }

  .training-eyebrow {
    margin: 0 0 0.6rem;
    color: var(--color-accent-gold);
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.75rem;
    font-weight: 650;
  }

  .training-programs {
    padding-top: var(--space-5);
  }

  .training-section-head {
    margin-bottom: var(--space-2);
    padding-bottom: 0.72rem;
    border-bottom: 1px solid rgba(141, 184, 240, 0.24);
  }

  .training-section-label {
    margin: 0;
    color: var(--color-accent-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.74rem;
    font-weight: 650;
  }

  .training-section-head h2 {
    margin: 0.58rem 0 0;
    max-width: 30ch;
    font-size: clamp(1.35rem, 2.6vw, 1.92rem);
  }

  .training-card {
    position: relative;
    border-color: rgba(138, 182, 242, 0.4);
    background: linear-gradient(175deg, rgba(8, 21, 40, 0.92), rgba(6, 16, 31, 0.9));
  }

  .training-card::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0.78rem;
    width: 2.15rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(234, 216, 168, 0.88), rgba(234, 216, 168, 0.08));
  }

  .training-card h3 {
    margin-top: 0.3rem;
  }
</style>
