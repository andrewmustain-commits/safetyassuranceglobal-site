---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const trainingFormats = [
  'Awareness training',
  'Site-specific training',
  'Professional development',
  'Readiness-focused training',
  'Employer-supported training'
];
---

<BaseLayout title="Training" description="Safety Assurance Global training for awareness, readiness, site-specific learning, and professional development.">
  <Container>
    <Section class="training-hero" ariaLabelledby="training-title">
      <Badge text="Training" />
      <h1 id="training-title">Training that supports readiness without claiming accreditation.</h1>
      <p>We keep training distinct from institutional governance, Course Factory development, SAG Command, and any credentialing systems. Public language stays within the evidence that is approved for release.</p>
      <div class="hero-actions">
        <Button href="/maritime-training">Explore maritime training</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </Section>

    <Section ariaLabelledby="formats-title">
      <div class="section-head">
        <Badge text="Permitted language" />
        <h2 id="formats-title">Training formats available on the public site.</h2>
      </div>
      <div class="format-grid">
        {trainingFormats.map((format) => <Card><h3>{format}</h3></Card>)}
      </div>
    </Section>

    <Section ariaLabelledby="distinction-title">
      <div class="section-head">
        <Badge text="Boundary Control" />
        <h2 id="distinction-title">What this page does not claim.</h2>
      </div>
      <Card>
        <p>This page does not claim USCG approval, STCW approval, OSHA authorization, accreditation, license issuance, or certification authority. It describes training as workforce development and compliance support only.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .training-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .training-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 19ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .format-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .format-grid {
      grid-template-columns: 1fr;
    }
  }
</style>