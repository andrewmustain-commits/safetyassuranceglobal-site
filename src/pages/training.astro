---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';

const deliveryModes = [
  {
    title: 'Corporate delivery',
    detail: 'Programs scoped for employer teams, operations groups, and project organizations with readiness goals.'
  },
  {
    title: 'Onsite delivery',
    detail: 'Site-aware delivery aligned to operational constraints, safety controls, and role responsibilities.'
  },
  {
    title: 'Custom workforce programs',
    detail: 'Role-based pathways built from training-needs assessments and assurance findings.'
  }
];

const controls = [
  'Training-needs assessments before final scope',
  'Role-based delivery planning and prerequisites review',
  'Status controls per program before publication',
  'Inquiry and proposal process before commitment',
  'Conservative public language for approvals and certification claims'
];
---

<BaseLayout
  title="Training"
  description="Workforce training that supports Safety Assurance Global consulting and independent assurance delivery through corporate, onsite, and custom programs."
>
  <Container>
    <Section class="hero-panel" ariaLabelledby="training-title">
      <Badge text="Training Hub" />
      <h1 id="training-title">Training that supports assurance and operational readiness.</h1>
      <p>
        Safety Assurance Global presents training as a supporting capability within consulting and independent
        assurance delivery. Training is scoped through inquiry, role requirements, and readiness outcomes.
      </p>
      <div class="ui-actions">
        <Button href="/maritime-training">Explore Maritime Training</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </Section>

    <Section ariaLabelledby="training-delivery-title">
      <SectionHeader
        badge="Delivery Model"
        id="training-delivery-title"
        title="Corporate, onsite, and custom program delivery options."
      />
      <div class="grid-three">
        {deliveryModes.map((mode) => (
          <Card>
            <h3>{mode.title}</h3>
            <p>{mode.detail}</p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="training-process-title">
      <SectionHeader
        badge="Inquiry Process"
        id="training-process-title"
        title="How training scope is confirmed."
      />
      <div class="grid-two">
        <Card>
          <h3>1. Clarify workforce objectives</h3>
          <p>Confirm roles, risk profile, and expected readiness outcomes.</p>
        </Card>
        <Card>
          <h3>2. Confirm delivery constraints</h3>
          <p>Define onsite, corporate, and custom requirements, including delivery status and prerequisites.</p>
        </Card>
        <Card>
          <h3>3. Align with assurance priorities</h3>
          <p>Connect training scope to verified control gaps and operational-improvement priorities.</p>
        </Card>
        <Card>
          <h3>4. Finalize scope and proposal</h3>
          <p>Issue a controlled scope with delivery assumptions and status qualifiers.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="training-controls-title">
      <SectionHeader
        badge="Delivery Status Controls"
        id="training-controls-title"
        title="Controls used to keep public training claims accurate."
      />
      <Card>
        <ul>
          {controls.map((control) => (
            <li>{control}</li>
          ))}
        </ul>
      </Card>
    </Section>

    <Section ariaLabelledby="training-boundary-title">
      <SectionHeader
        badge="Boundary Notice"
        id="training-boundary-title"
        title="Public training language is intentionally conservative."
      />
      <NoticePanel tone="warning" title="Qualification Notice" class="qualification-notice">
        <p>
          This site does not publish unsupported claims about open enrollment, credential issuance, accreditation,
          recognition, or certification authority. Delivery status is confirmed per program before enrollment or contract award.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>
