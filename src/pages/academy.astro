---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout title="Training" description="Training now lives on the public training routes. This page remains as a safe transition page for older links.">
  <Container>
    <Section class="transition-hero" ariaLabelledby="academy-title">
      <Badge text="Legacy Route" />
      <h1 id="academy-title">Training has moved to the public training routes.</h1>
      <p>The public site no longer presents Academy as a fully operational integrated system. Use the training pages for the current public offer.</p>
      <div class="hero-actions">
        <Button href="/training">Go to Training</Button>
        <Button href="/maritime-training" variant="secondary">Maritime Training</Button>
      </div>
    </Section>

    <Section>
      <Card>
        <p>This transition page avoids unsupported claims and simply points visitors to the public training offer.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .transition-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .transition-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }
</style>