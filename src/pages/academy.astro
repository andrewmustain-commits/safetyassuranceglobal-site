---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import HeroSection from '../components/ui/HeroSection.astro';
---

<BaseLayout
  title="Institute of Assurance"
  description="The former Academy route now points visitors to the Safety Assurance Global Institute of Assurance and current public training pages."
  noIndex={true}
>
  <Container>
    <HeroSection
      id="academy-title"
      badge="Route Transition"
      title="SAG learning now operates under the Institute of Assurance identity."
    >
      <p>
        The Academy name has been superseded in the public experience by the Safety Assurance Global Institute of Assurance,
        SAG's governed learning and workforce-development division. Existing links are preserved here for continuity.
      </p>
      <div class="ui-actions">
        <Button href="/institute">Visit the Institute</Button>
        <Button href="/training" variant="secondary">Explore Training</Button>
      </div>
    </HeroSection>

    <Section>
      <Card>
        <p>
          Program availability, delivery status, assessments, enrollment, and credential decisions remain subject to the
          applicable governance process and are not implied by this transition page.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>
