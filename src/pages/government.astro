---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';

const audiences = [
  'Contracting officers',
  'Program managers',
  'Prime contractors',
  'Small-business specialists',
  'Public infrastructure owners',
  'Port authorities',
  'Engineering teams',
  'Construction teams'
];

const missionSupport = [
  'Operational-readiness support',
  'Independent assurance and evidence review',
  'QA/QC and contractor-assurance support',
  'Field assurance and validation support',
  'Workforce training support aligned to assurance objectives'
];
---

<BaseLayout
  title="Government"
  description="Conservative, evidence-based government and infrastructure support for readiness, assurance, QA/QC, and contractor oversight."
>
  <Container>
    <Section class="hero-panel" ariaLabelledby="government-title">
      <p class="ui-badge">Government and Infrastructure</p>
      <h1 id="government-title">Conservative support posture for public-sector and infrastructure programs.</h1>
      <p>
        Safety Assurance Global provides consulting and independent-assurance support for maritime and
        critical-infrastructure programs. Public claims remain limited to verified, capability-oriented language.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/request-proposal" variant="secondary">Teaming or Proposal Inquiry</Button>
      </div>
    </Section>

    <Section ariaLabelledby="government-audience-title">
      <SectionHeader badge="Audience" id="government-audience-title" title="Stakeholders this page supports." />
      <div class="grid-four">
        {audiences.map((audience) => (
          <Card><h3>{audience}</h3></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-capabilities-title">
      <SectionHeader
        badge="Mission Support"
        id="government-capabilities-title"
        title="Maritime and infrastructure support capabilities."
      />
      <div class="grid-two">
        {missionSupport.map((item) => (
          <Card><p>{item}</p></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-prime-title">
      <SectionHeader
        badge="Prime-Contractor Support"
        id="government-prime-title"
        title="Support available for prime-led and multi-party execution environments."
      />
      <Card>
        <p>
          Support is focused on control verification, readiness evidence, QA/QC oversight, and contractor-assurance
          discipline. No contract vehicle, award, or agency-customer claim is made on this page.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-capability-statement-title">
      <SectionHeader
        badge="Capability Statement"
        id="government-capability-statement-title"
        title="Current public approach"
      />
      <Card>
        <p>
          A capability-statement download is not published because no approved current file is available in the
          repository. Use consultation or teaming inquiry pathways for capability discussion.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-claims-title">
      <NoticePanel tone="warning" title="Government Claims Control" class="qualification-notice" id="government-claims-title">
        <p>
          This page does not publish UEI, CAGE, NAICS, PSC, set-aside status, contract vehicles, awards, clearances,
          agency customers, or endorsements. Those claims require explicit evidence approval before publication.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>
