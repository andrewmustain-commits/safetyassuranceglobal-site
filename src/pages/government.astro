---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const audiences = [
  'Contracting officers',
  'Program managers',
  'Prime contractors',
  'Small-business specialists',
  'Public infrastructure owners',
  'Port authorities',
  'Engineering teams',
  'Construction teams'
];

const missionSupport = [
  'Operational-readiness support',
  'Independent assurance and evidence review',
  'QA/QC and contractor-assurance support',
  'Field assurance and validation support',
  'Workforce training support aligned to assurance objectives'
];

const procurementIdentity = [
  ['Legal Name', 'Safety Assurance Global LLC'],
  ['UEI', 'RCUUJLWEBGD4'],
  ['CAGE', '16NM4'],
  ['SBA VetCert Status', 'SDVOSB and VOSB'],
  ['Primary NAICS', '541611'],
  ['Business Base', 'Oregon']
];
---

<BaseLayout
  title="Government"
  description="Government and public-infrastructure assurance support from Safety Assurance Global, including operational readiness, QA/QC, contractor oversight, evidence-based risk support, and published procurement identifiers."
>
  <Container class="government-page">
    <HeroSection
      id="government-title"
      badge="Government & Public Infrastructure"
      title="Independent assurance support for public-sector and infrastructure programs."
    >
      <p>
        Safety Assurance Global supports public owners, agencies, prime contractors, and infrastructure teams with
        operational-readiness, independent-assurance, QA/QC, contractor-assurance, and evidence-based risk support.
      </p>
      <div class="ui-actions">
        <Button href="/capabilities">View Capabilities</Button>
        <Button href="/request-proposal" variant="secondary">Teaming or Proposal Inquiry</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="government-identity-title">
      <SectionHeader
        badge="Procurement Identity"
        id="government-identity-title"
        title="Published corporate identifiers for buyer and teaming reference."
      />
      <div class="identity-grid" role="list">
        {procurementIdentity.map(([label, value]) => (
          <Card role="listitem" class="identity-card">
            <span>{label}</span>
            <strong>{value}</strong>
          </Card>
        ))}
      </div>
      <p class="identity-note">
        These identifiers are reproduced from SAG's dated August 2026 capabilities statement. Their publication does not imply
        an agency endorsement, contract award, contract vehicle, or universal qualification for every scope.
      </p>
    </Section>

    <Section ariaLabelledby="government-audience-title">
      <SectionHeader badge="Who We Support" id="government-audience-title" title="Stakeholders across public-sector and infrastructure delivery." />
      <div class="grid-four">
        {audiences.map((audience) => (
          <Card><h3>{audience}</h3></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-capabilities-title">
      <SectionHeader
        badge="Mission Support"
        id="government-capabilities-title"
        title="Assurance capabilities for complex programs and operating environments."
      />
      <div class="grid-two">
        {missionSupport.map((item) => (
          <Card><p>{item}</p></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-prime-title">
      <SectionHeader
        badge="Prime & Teaming Support"
        id="government-prime-title"
        title="Support for prime-led, owner-led, and multi-party execution environments."
      />
      <Card>
        <p>
          SAG can support programs that require control verification, readiness evidence, QA/QC oversight,
          contractor-assurance discipline, field validation, or independent review within a defined scope of work.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-capability-statement-title">
      <SectionHeader
        badge="Capabilities Statement"
        id="government-capability-statement-title"
        title="Review SAG's current public capability profile."
      />
      <Card>
        <p>
          The August 2026 capabilities statement summarizes SAG's company overview, core capabilities,
          requirement-to-evidence delivery cycle, relevant individual experience base, differentiators,
          corporate data, points of contact, and delivery boundaries.
        </p>
        <p><a href="/capabilities">Open the SAG capabilities statement</a>.</p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-claims-title">
      <NoticePanel tone="warning" title="Public Claims Notice" class="qualification-notice" id="government-claims-title">
        <p>
          Contract vehicles, awards, agency relationships, set-aside status, identifiers, certifications, and other
          procurement-specific representations are published only when supported by current approved evidence.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>

<style>
  .government-page { display: grid; gap: .25rem; }
  .identity-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .identity-card { min-height: 112px; display: grid; align-content: space-between; gap: .85rem; }
  .identity-card span { color: #94a3b8; font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .identity-card strong { color: #f8fafc; font-size: 1.05rem; overflow-wrap: anywhere; }
  .identity-note { max-width: 900px; margin-top: 1rem; font-size: .9rem; color: #94a3b8; }
  @media (max-width: 820px) { .identity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .identity-grid { grid-template-columns: 1fr; } .identity-card { min-height: auto; } }
</style>