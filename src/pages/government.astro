---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const audiences = [
  'Contracting officers',
  'Program managers',
  'Prime contractors',
  'Small-business specialists',
  'Public infrastructure owners',
  'Port authorities',
  'Engineering teams',
  'Construction teams'
];

const missionSupport = [
  'Operational-readiness support',
  'Independent assurance and evidence review',
  'QA/QC and contractor-assurance support',
  'Field assurance and validation support',
  'Workforce training support aligned to assurance objectives'
];
---

<BaseLayout
  title="Government"
  description="Government and infrastructure support for readiness, assurance, QA/QC, contractor oversight, and evidence-based risk management."
>
  <Container>
    <HeroSection
      id="government-title"
      badge="Government & Public Infrastructure"
      title="Independent assurance support for public-sector and infrastructure programs."
    >
      <p>
        Safety Assurance Global supports public owners, agencies, prime contractors, and infrastructure teams with
        operational-readiness, independent-assurance, QA/QC, contractor-assurance, and evidence-based risk support.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/request-proposal" variant="secondary">Teaming or Proposal Inquiry</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="government-audience-title">
      <SectionHeader badge="Who We Support" id="government-audience-title" title="Stakeholders across public-sector and infrastructure delivery." />
      <div class="grid-four">
        {audiences.map((audience) => (
          <Card><h3>{audience}</h3></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-capabilities-title">
      <SectionHeader
        badge="Mission Support"
        id="government-capabilities-title"
        title="Assurance capabilities for complex programs and operating environments."
      />
      <div class="grid-two">
        {missionSupport.map((item) => (
          <Card><p>{item}</p></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="government-prime-title">
      <SectionHeader
        badge="Prime & Teaming Support"
        id="government-prime-title"
        title="Support for prime-led, owner-led, and multi-party execution environments."
      />
      <Card>
        <p>
          SAG can support programs that require control verification, readiness evidence, QA/QC oversight,
          contractor-assurance discipline, field validation, or independent review within a defined scope of work.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-capability-statement-title">
      <SectionHeader
        badge="Capability Discussion"
        id="government-capability-statement-title"
        title="Need a capability, teaming, or procurement discussion?"
      />
      <Card>
        <p>
          Contact SAG for current capability information, teaming discussions, procurement support, or a scoped response
          aligned to your program requirements.
        </p>
        <p><a href="/contact">Start a government or teaming inquiry</a>.</p>
      </Card>
    </Section>

    <Section ariaLabelledby="government-claims-title">
      <NoticePanel tone="warning" title="Public Claims Notice" class="qualification-notice" id="government-claims-title">
        <p>
          Contract vehicles, awards, agency relationships, set-aside status, identifiers, certifications, and other
          procurement-specific representations are published only when supported by current approved evidence.
        </p>
      </NoticePanel>
    </Section>
  </Container>
</BaseLayout>