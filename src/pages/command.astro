---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout title="Command" description="Legacy route retained for compatibility. Review the conservative SAG Command status page.">
  <Container>
    <Section class="transition-hero" ariaLabelledby="command-title">
      <Badge text="Legacy Route" />
      <h1 id="command-title">This legacy route points to the current SAG Command public status page.</h1>
      <p>The current conservative public treatment is published at /sag-command.</p>
      <div class="hero-actions">
        <Button href="/sag-command">Go to SAG Command Status</Button>
        <Button href="/contact" variant="secondary">Discuss an Assurance Technology Pilot</Button>
      </div>
    </Section>

    <Section>
      <Card>
        <p>
          This route is retained for compatibility and should redirect to /sag-command in edge configuration.
          No commercial-availability claim is made here.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .transition-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .transition-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }
</style>