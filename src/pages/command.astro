---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout title="Command" description="SAG Command remains a gated internal concept and is not presented here as a fully operational public system.">
  <Container>
    <Section class="transition-hero" ariaLabelledby="command-title">
      <Badge text="Gated Concept" />
      <h1 id="command-title">SAG Command is not part of the public Phase 2 offer.</h1>
      <p>This page avoids product-style claims and only confirms that command-system concepts remain gated pending executive decision and evidence review.</p>
      <div class="hero-actions">
        <Button href="/method">Review method</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </Section>

    <Section>
      <Card>
        <p>The public site does not present SAG Command as an operational integrated system, and it does not invite demonstration requests as a public CTA.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .transition-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .transition-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }
</style>