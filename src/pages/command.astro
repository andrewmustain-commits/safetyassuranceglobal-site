---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import HeroSection from '../components/ui/HeroSection.astro';
---

<BaseLayout title="Command" description="Legacy route retained for compatibility. Review the conservative SAG Command status page.">
  <Container>
    <HeroSection
      id="command-title"
      badge="Legacy Route"
      title="This legacy route points to the current SAG Command public status page."
    >
      <p>The current conservative public treatment is published at /sag-command.</p>
      <div class="ui-actions">
        <Button href="/sag-command">Go to SAG Command Status</Button>
        <Button href="/contact" variant="secondary">Discuss an Assurance Technology Pilot</Button>
      </div>
    </HeroSection>

    <Section>
      <Card>
        <p>
          This route is retained for compatibility and should redirect to /sag-command in edge configuration.
          No commercial-availability claim is made here.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>
