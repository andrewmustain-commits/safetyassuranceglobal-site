---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import HeroSection from '../components/ui/HeroSection.astro';
---

<BaseLayout title="Page not found" description="The page you requested was not found. Return to the Safety Assurance Global home page or explore the primary routes.">
  <Container>
    <HeroSection id="error-title" badge="404" title="Page not found">
      <p>The route may have moved or never existed. Use the links below to continue browsing.</p>
      <div class="ui-actions">
        <Button href="/">Home</Button>
        <Button href="/maritime" variant="secondary">Maritime</Button>
        <Button href="/contact" variant="secondary">Contact</Button>
      </div>
    </HeroSection>

    <Section>
      <Card>
        <p>If you were expecting a service page, try <a href="/services">Services</a> or <a href="/request-proposal">Request a Proposal</a>.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>
