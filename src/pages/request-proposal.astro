---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ProposalRequestForm from '../components/forms/ProposalRequestForm.astro';
---

<BaseLayout title="Request a Proposal" description="Request a proposal from Safety Assurance Global for maritime and critical infrastructure consulting.">
  <Container>
    <HeroSection id="proposal-title" badge="Request a Proposal" title="Start a proposal-ready conversation.">
      <p>Use this workflow when you need a clearer scope, schedule, and procurement context for commercial scoping.</p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="mailto:contact@safetyassuranceglobal.com" variant="secondary">Email the team</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="proposal-lead-title">
      <ProposalRequestForm />
    </Section>

    <Section ariaLabelledby="proposal-expectations-title">
      <SectionHeader id="proposal-expectations-title" badge="What Happens Next" title="Controlled proposal handling." />
      <Card>
        <p>We review the request, confirm fit, and then decide whether the next step should be a consultation, an evidence-gathering discussion, or a scoped proposal response.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>