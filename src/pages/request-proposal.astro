---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ProposalRequestForm from '../components/forms/ProposalRequestForm.astro';
---

<BaseLayout title="Request a Proposal" description="Request a proposal from Safety Assurance Global for maritime, government, commercial, infrastructure, safety, QA/QC, risk, and operational-readiness support.">
  <Container>
    <section class="oa-page-intro" aria-labelledby="proposal-oa-title"><div><p class="eyebrow">Proposal context</p><h2 id="proposal-oa-title">Bring the requirement, context, and expected outcome.</h2></div><p>A useful proposal request defines the operating environment, scope, schedule, procurement or teaming context, and the evidence the decision will require.</p></section>

    <HeroSection id="proposal-title" badge="Request a Proposal" title="Bring us the scope. We will evaluate the fit.">
      <p>
        Use this workflow when you have a defined operating need, procurement context, schedule, location, or teaming requirement.
        Maritime is Safety Assurance Global's primary market, with broader support considered where the requested scope is supported by verified capability and evidence.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Start with a Consultation</Button>
        <Button href="/capabilities" variant="secondary">Review Capabilities</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="proposal-ready-title">
      <SectionHeader id="proposal-ready-title" badge="Proposal-Ready Inputs" title="The most useful requests give us enough context to evaluate the work responsibly." />
      <div class="proposal-grid">
        <Card><h3>Operating environment</h3><p>Maritime, construction, infrastructure, industrial, government, or another defined high-consequence setting.</p></Card>
        <Card><h3>Required outcome</h3><p>Readiness assessment, independent assurance, QA/QC, contractor oversight, safety or risk support, incident review, training, or another specific result.</p></Card>
        <Card><h3>Schedule & location</h3><p>Expected start, duration, mobilization constraints, geographic location, site access, and known operating conditions.</p></Card>
        <Card><h3>Procurement context</h3><p>Prime, subcontract, teaming, direct commercial engagement, public procurement, RFP/RFQ, or exploratory planning.</p></Card>
      </div>
    </Section>

    <Section ariaLabelledby="proposal-authority-title">
      <div class="oa-editorial-split">
        <div><p class="eyebrow">Evidence before commitment</p><h2 id="proposal-authority-title">A proposal follows capability fit and scope definition.</h2></div>
        <ul class="oa-rule-list"><li>No unsupported outcome commitments</li><li>Qualification claims remain evidence-controlled</li><li>Delivery assumptions are defined before commitment</li><li>Institute authority remains separate for learning and credential decisions</li></ul>
      </div>
    </Section>

    <Section ariaLabelledby="proposal-lead-title">
      <ProposalRequestForm />
    </Section>

    <Section ariaLabelledby="proposal-expectations-title">
      <SectionHeader id="proposal-expectations-title" badge="What Happens Next" title="Fit, evidence, scope, then proposal." />
      <div class="proposal-grid">
        <Card><h3>1. Intake review</h3><p>We review the submitted requirement and identify missing information needed to evaluate the engagement.</p></Card>
        <Card><h3>2. Capability fit</h3><p>We assess whether the requested work is supported by the appropriate personnel capability, evidence, delivery model, contractual authority, and jurisdictional requirements.</p></Card>
        <Card><h3>3. Scope clarification</h3><p>When appropriate, Safety Assurance Global may request a consultation or evidence-gathering discussion before preparing commercial terms.</p></Card>
        <Card><h3>4. Proposal decision</h3><p>If the opportunity is a responsible fit, Safety Assurance Global may provide a scoped proposal or teaming response. Submission of this form does not guarantee acceptance or award.</p></Card>
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
  .proposal-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-2); }
  @media (max-width:760px) { .proposal-grid { grid-template-columns:1fr; } }
</style>