---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import ProposalRequestForm from '../components/forms/ProposalRequestForm.astro';
---

<BaseLayout title="Request a Proposal" description="Request a proposal from Safety Assurance Global for maritime and critical infrastructure consulting.">
  <Container>
    <Section class="proposal-hero" ariaLabelledby="proposal-title">
      <Badge text="Request a Proposal" />
      <h1 id="proposal-title">Start a proposal-ready conversation.</h1>
      <p>Use this workflow when you need a clearer scope, schedule, and procurement context for commercial scoping.</p>
      <div class="hero-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="mailto:contact@safetyassuranceglobal.com" variant="secondary">Email the team</Button>
      </div>
    </Section>

    <Section ariaLabelledby="proposal-lead-title">
      <ProposalRequestForm />
    </Section>

    <Section ariaLabelledby="proposal-expectations-title">
      <div class="section-head">
        <Badge text="What Happens Next" />
        <h2 id="proposal-expectations-title">Controlled proposal handling.</h2>
      </div>
      <Card>
        <p>We review the request, confirm fit, and then decide whether the next step should be a consultation, an evidence-gathering discussion, or a scoped proposal response.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .proposal-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .proposal-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 19ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }
</style>