---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import { serviceDetails } from '../data/services';

const serviceAreas = serviceDetails.map((service) => ({
  href: `/services/${service.slug}`,
  title: service.title,
  summary: service.summary,
  problem: service.customerProblem,
  result: service.expectedResult
}));
---

<BaseLayout
  title="Services"
  description="Maritime-first operational-readiness, independent-assurance, QA/QC, contractor-assurance, safety, risk, and governance services for high-consequence operations."
>
  <Container>
    <HeroSection
      id="services-title"
      badge="Maritime-First Assurance Services"
      title="Practical assurance support for complex, high-consequence operations."
    >
      <p>
        Maritime is Safety Assurance Global's primary market. SAG helps owners, contractors, and public-sector
        organizations verify readiness, strengthen controls, improve quality oversight, and prioritize defensible
        risk-reduction actions, with related capability available for other defined high-consequence sectors.
      </p>
      <div class="ui-actions">
        <Button href="/maritime">Explore Maritime Services</Button>
        <Button href="/request-proposal" variant="secondary">Request a Proposal</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="services-priority-title">
      <SectionHeader
        badge="Core Service Areas"
        id="services-priority-title"
        title="Choose the service path that best matches your operating challenge."
      />
      <div class="grid-two">
        {serviceAreas.map((service) => (
          <ServiceCard>
            <h3><a href={service.href}>{service.title}</a></h3>
            <p><strong>Customer challenge:</strong> {service.problem}</p>
            <p><strong>Expected result:</strong> {service.result}</p>
            <p><a href={service.href}>View service detail</a></p>
          </ServiceCard>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="services-commercial-title">
      <SectionHeader
        badge="How to Engage"
        id="services-commercial-title"
        title="Start with the level of scoping that fits your need."
      />
      <div class="grid-two">
        <Card>
          <h3>Consultation</h3>
          <p>Best for early-stage scope definition, readiness concerns, assurance priorities, or a focused operational challenge.</p>
          <p><a href="/contact">Start a consultation</a>.</p>
        </Card>
        <Card>
          <h3>Proposal request</h3>
          <p>Best when procurement context, schedule, deliverables, or delivery model require a structured response.</p>
          <p><a href="/request-proposal">Start a proposal request</a>.</p>
        </Card>
      </div>
      <Card>
        <p>
          Service descriptions are capability statements, not claims of universal certification, accreditation,
          regulatory approval, licensure, or authority. Each engagement is scoped to the applicable jurisdiction,
          client requirements, personnel qualifications, and available evidence.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>