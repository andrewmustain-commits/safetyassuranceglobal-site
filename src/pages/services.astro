---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import { serviceDetails } from '../data/services';

const serviceImages = [
  '/images/site-2026/home-hero.webp',
  '/images/site-2026/about-hero.webp',
  '/images/site-2026/maritime-hero.webp',
  '/images/site-2026/contact-hero.webp',
  '/images/site-2026/capabilities-hero.webp',
  '/images/site-2026/industries-hero.webp',
  '/images/site-2026/insights-hero.webp',
  '/images/site-2026/institute-hero.webp',
  '/images/site-2026/government-hero.webp',
  '/images/site-2026/services-hero.webp'
];

const serviceAreas = serviceDetails.map((service, index) => ({
  slug: service.slug,
  href: `/services/${service.slug}`,
  title: service.title,
  summary: service.summary,
  problem: service.customerProblem,
  result: service.expectedResult,
  image: serviceImages[index % serviceImages.length]
}));

const flagshipSlugs = new Set(['operational-readiness', 'independent-assurance', 'qa-qc', 'contractor-assurance']);
const flagshipServices = serviceAreas.filter((service) => flagshipSlugs.has(service.slug));
const additionalServices = serviceAreas.filter((service) => !flagshipSlugs.has(service.slug));
---

<BaseLayout
  title="Services"
  description="Maritime-first operational-readiness, independent-assurance, QA/QC, contractor-assurance, safety, risk, and governance services for high-consequence operations."
>
  <Container>
    <HeroSection
      id="services-title"
      badge="Maritime-First Assurance Services"
      title="Practical assurance support for complex, high-consequence operations."
      image="/images/site-2026/services-hero.webp"
      imagePosition="center 52%"
    >
      <p>
        Maritime is Safety Assurance Global's primary market. SAG helps owners, contractors, and public-sector
        organizations verify readiness, strengthen controls, improve quality oversight, and prioritize defensible
        risk-reduction actions, with related capability available for other defined high-consequence sectors.
      </p>
      <div class="ui-actions">
        <Button href="/maritime">Explore Maritime Services</Button>
        <Button href="/request-proposal" variant="secondary">Request a Proposal</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="services-flagship-title">
      <SectionHeader
        badge="Flagship Engagements"
        id="services-flagship-title"
        title="Start with four core assurance paths."
      />
      <p class="section-intro">These core engagements address readiness, independent verification, quality, and contractor oversight. Each can stand alone or form part of a broader assurance program.</p>
      <div class="grid-two flagship-grid">
        {flagshipServices.map((service) => (
          <ServiceCard class="image-forward-card image-forward-card-tall image-forward-card-gold" style={`--card-image:url(${service.image})`}>
            <p class="service-kicker">Core engagement</p>
            <h3><a href={service.href}>{service.title}</a></h3>
            <p>{service.summary}</p>
            <p><strong>Customer challenge:</strong> {service.problem}</p>
            <p><strong>Expected result:</strong> {service.result}</p>
            <p><a href={service.href}>View service detail</a></p>
          </ServiceCard>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="services-additional-title">
      <SectionHeader
        badge="Additional Assurance Support"
        id="services-additional-title"
        title="Extend the engagement where operating risk or delivery context requires it."
      />
      <div class="grid-three additional-grid">
        {additionalServices.map((service) => (
          <ServiceCard class="image-forward-card image-forward-card-compact" style={`--card-image:url(${service.image})`}>
            <h3><a href={service.href}>{service.title}</a></h3>
            <p>{service.summary}</p>
            <p><a href={service.href}>Explore capability →</a></p>
          </ServiceCard>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="services-commercial-title">
      <SectionHeader
        badge="How to Engage"
        id="services-commercial-title"
        title="Start with the level of scoping that fits your need."
      />
      <div class="grid-two">
        <Card class="image-forward-card image-forward-card-compact" style="--card-image:url(/images/site-2026/contact-hero.webp)">
          <h3>Consultation</h3>
          <p>Best for early-stage scope definition, readiness concerns, assurance priorities, or a focused operational challenge.</p>
          <p><a href="/contact">Start a consultation</a>.</p>
        </Card>
        <Card class="image-forward-card image-forward-card-compact" style="--card-image:url(/images/site-2026/capabilities-hero.webp)">
          <h3>Proposal request</h3>
          <p>Best when procurement context, schedule, deliverables, or delivery model require a structured response.</p>
          <p><a href="/request-proposal">Start a proposal request</a>.</p>
        </Card>
      </div>
      <Card>
        <p>
          Service descriptions are capability statements, not claims of universal certification, accreditation,
          regulatory approval, licensure, or authority. Each engagement is scoped to the applicable jurisdiction,
          client requirements, personnel qualifications, and available evidence.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .section-intro { max-width:72ch; margin:-.4rem 0 1.25rem; color:var(--color-text-muted); font-size:.96rem; line-height:1.7; }
  .flagship-grid :global(.service-card) { min-height:26rem; }
  .service-kicker { margin:0 0 .45rem; color:#f3aa35; font-size:.72rem; font-weight:850; letter-spacing:.14em; text-transform:uppercase; }
  .additional-grid :global(.service-card) { min-height:15.5rem; }
  @media (max-width:900px) { .additional-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:640px) { .additional-grid { grid-template-columns:1fr; } .flagship-grid :global(.service-card) { min-height:22rem; } }
</style>