---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { serviceDetails } from '../data/services';

const serviceAreas = serviceDetails.map((service) => ({
  href: `/services/${service.slug}`,
  title: service.title,
  summary: service.summary,
  problem: service.customerProblem,
  result: service.expectedResult
}));
---

<BaseLayout
  title="Services"
  description="Operational-readiness, independent-assurance, maritime-compliance, QA/QC, contractor-assurance, and safety-risk services for maritime and critical infrastructure."
>
  <Container>
    <Section class="hero-panel" ariaLabelledby="services-title">
      <p class="ui-badge">Services Architecture</p>
      <h1 id="services-title">Service pathways organized around customer problems and decision outcomes.</h1>
      <p>
        Safety Assurance Global provides consulting and independent-assurance services that help organizations
        verify readiness, improve controls, and prioritize practical risk-reduction actions.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/request-proposal" variant="secondary">Request a Proposal</Button>
      </div>
    </Section>

    <Section ariaLabelledby="services-priority-title">
      <SectionHeader
        badge="Priority Service Areas"
        id="services-priority-title"
        title="Commercial architecture for Phase 3."
      />
      <div class="grid-two">
        {serviceAreas.map((service) => (
          <Card>
            <h3><a href={service.href}>{service.title}</a></h3>
            <p><strong>Customer problem:</strong> {service.problem}</p>
            <p><strong>Expected result:</strong> {service.result}</p>
            <p><a href={service.href}>View service detail</a></p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="services-commercial-title">
      <SectionHeader
        badge="Commercial Guidance"
        id="services-commercial-title"
        title="How to engage for service scoping."
      />
      <div class="grid-two">
        <Card>
          <h3>Consultation pathway</h3>
          <p>Use consultation for early scope, constraints, and readiness-priority alignment.</p>
          <p><a href="/contact">Start consultation intake</a>.</p>
        </Card>
        <Card>
          <h3>Proposal pathway</h3>
          <p>Use proposal intake when procurement context, schedule, and delivery model require structured scoping.</p>
          <p><a href="/request-proposal">Start proposal intake</a>.</p>
        </Card>
      </div>
    </Section>
  </Container>
</BaseLayout>
