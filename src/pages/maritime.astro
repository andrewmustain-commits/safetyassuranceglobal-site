---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const maritimeImages = [
  '/images/site-2026/maritime-hero.webp',
  '/images/site-2026/services-hero.webp',
  '/images/site-2026/home-hero.webp',
  '/images/site-2026/industries-hero.webp',
  '/images/site-2026/government-hero.webp',
  '/images/site-2026/about-hero.webp'
];

const pathways = [
  {
    audience: 'Shipyards',
    challenge: 'Coordinating safety, quality, contractor execution, and turnover readiness across concurrent work fronts.',
    approach: 'Independent readiness review, QA/QC sampling, contractor-assurance checks, and corrective-action prioritization.',
    evidence: 'Work-pack controls, inspection logs, permit records, closeout evidence, and contractor documentation.',
    deliverables: 'Assurance findings, risk-ranked action list, QA/QC readiness summary, and validation follow-up plan.',
    outcome: 'Clearer confidence in field execution quality and reduced readiness uncertainty before critical milestones.',
    cta: '/contact'
  },
  {
    audience: 'Ports and marine terminals',
    challenge: 'Maintaining operational continuity while strengthening safety-management and emergency-readiness controls.',
    approach: 'Operational-readiness and safety-management review aligned to terminal realities and contractor interfaces.',
    evidence: 'Operating procedures, drill records, contractor onboarding controls, and incident-management artifacts.',
    deliverables: 'Readiness gap assessment, prioritized control-improvement roadmap, and validation checkpoints.',
    outcome: 'Improved operational preparedness and more defensible oversight evidence.',
    cta: '/contact'
  },
  {
    audience: 'Vessel operators',
    challenge: 'Balancing day-to-day operations with reliable safety, compliance-readiness, and incident-response performance.',
    approach: 'Targeted assurance support for operational controls, risk management, and incident-response readiness.',
    evidence: 'Safety procedures, risk registers, corrective-action histories, and training/competency records.',
    deliverables: 'Control-gap analysis, readiness scorecard, and prioritized action plan.',
    outcome: 'Better decision support for readiness and operational-risk reduction.',
    cta: '/contact'
  },
  {
    audience: 'Marine contractors',
    challenge: 'Demonstrating reliable control of field execution, subcontractor quality, and safety performance.',
    approach: 'Contractor-assurance and QA/QC review with emphasis on traceable evidence and corrective discipline.',
    evidence: 'Subcontractor controls, field verification records, QA/QC artifacts, and incident-prevention measures.',
    deliverables: 'Contractor-assurance summary, improvement roadmap, and validation report.',
    outcome: 'Stronger evidence of execution control for owners and prime stakeholders.',
    cta: '/request-proposal'
  },
  {
    audience: 'Government maritime programs',
    challenge: 'Needing evidence-based readiness, assurance, and oversight support within a defined program scope.',
    approach: 'Independent assurance and readiness support aligned to program controls, oversight needs, and accepted evidence.',
    evidence: 'Program controls, oversight records, readiness documentation, and accepted compliance artifacts.',
    deliverables: 'Assurance case inputs, evidence package structure, and corrective-action priorities.',
    outcome: 'More transparent readiness posture for internal and external oversight.',
    cta: '/government'
  },
  {
    audience: 'Workforce training buyers',
    challenge: 'Aligning workforce development with operational risks instead of generic training content.',
    approach: 'Role-based and site-aware training support connected to consulting and assurance priorities.',
    evidence: 'Role/task requirements, incident trends, workforce feedback, and competency observations.',
    deliverables: 'Training-needs summary, delivery recommendation, and readiness-aligned learning roadmap.',
    outcome: 'Training effort tied to measurable readiness and risk-control objectives.',
    cta: '/maritime-training'
  }
];

const primaryFocusAreas = [
  { label: 'Shipyard assurance', href: '/industries/shipyards', image: '/images/site-2026/services-hero.webp' },
  { label: 'Port and terminal readiness', href: '/industries/ports-marine-terminals', image: '/images/site-2026/maritime-hero.webp' },
  { label: 'Vessel-operator support', href: '/industries/vessel-operators', image: '/images/site-2026/home-hero.webp' },
  { label: 'Marine-contractor oversight', href: '/industries/marine-contractors', image: '/images/site-2026/industries-hero.webp' },
  { label: 'Government maritime support', href: '/government', image: '/images/site-2026/government-hero.webp' },
  { label: 'Workforce training', href: '/maritime-training', image: '/images/site-2026/institute-hero.webp' }
];

const supportingFocusAreas = [
  { label: 'Maritime safety management', href: '/services/safety-risk-management' },
  { label: 'Maritime risk management', href: '/services/safety-risk-management' },
  { label: 'QA/QC', href: '/services/qa-qc' },
  { label: 'Compliance readiness', href: '/services/maritime-compliance' },
  { label: 'Maritime cybersecurity readiness', href: '/contact' },
  { label: 'Safety-management readiness', href: '/services/operational-readiness' },
  { label: 'Contractor assurance', href: '/services/contractor-assurance' },
  { label: 'Emergency preparedness', href: '/services/emergency-preparedness' },
  { label: 'Drills and exercises', href: '/services/emergency-preparedness' },
  { label: 'Incident investigation', href: '/services/incident-investigation' }
];
---

<BaseLayout
  title="Maritime"
  description="Independent maritime assurance and readiness consulting for shipyards, ports, vessel operators, marine contractors, government maritime programs, and workforce training buyers."
>
  <Container>
    <HeroSection
      id="maritime-title"
      badge="Maritime Assurance"
      title="Independent assurance for maritime operations, projects, and readiness."
      image="/images/site-2026/maritime-hero.webp"
      imagePosition="center 54%"
    >
      <p>
        Safety Assurance Global supports shipyards, ports, vessel operators, marine contractors, and public-sector
        maritime programs with readiness, risk, QA/QC, contractor-assurance, compliance-readiness, and workforce support.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/services" variant="secondary">Review Services</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="maritime-focus-title">
      <SectionHeader
        badge="Primary Maritime Pathways"
        id="maritime-focus-title"
        title="Start with the operating environment that best matches your need."
      />
      <p class="section-intro">Safety Assurance Global's maritime work is organized around the buyer, operating environment, and decision that needs evidence—not around a generic service menu.</p>
      <div class="grid-three maritime-focus-grid">
        {primaryFocusAreas.map((item) => (
          <a class="maritime-focus-link" href={item.href} aria-label={`Explore ${item.label}`}>
            <Card as="div" class="maritime-focus-card image-forward-card image-forward-card-tall image-forward-card-gold" style={`--card-image:url(${item.image})`}>
              <h3>{item.label}</h3>
              <span class="maritime-focus-action" aria-hidden="true">Explore pathway →</span>
            </Card>
          </a>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="maritime-support-title">
      <SectionHeader
        badge="Supporting Capabilities"
        id="maritime-support-title"
        title="Add focused assurance support where the operating context requires it."
      />
      <div class="capability-index" aria-label="Additional maritime capabilities">
        {supportingFocusAreas.map((item) => (
          <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="maritime-pathways-title">
      <SectionHeader
        badge="How We Support You"
        id="maritime-pathways-title"
        title="Practical engagement paths by maritime operating context."
      />
      <div class="pathway-stack">
        {pathways.map((pathway, index) => (
          <Card class="pathway-card photo-backed-band" style={`--band-image:url(${maritimeImages[index % maritimeImages.length]});--band-position:center 55%`}>
            <div class="pathway-heading">
              <div><p class="pathway-kicker">Operating context</p><h3>{pathway.audience}</h3></div>
              <p class="pathway-outcome"><strong>Decision value:</strong> {pathway.outcome}</p>
            </div>
            <div class="grid-two pathway-grid">
              <div>
                <h4>Customer challenge</h4>
                <p>{pathway.challenge}</p>
              </div>
              <div>
                <h4>Safety Assurance Global approach</h4>
                <p>{pathway.approach}</p>
              </div>
              <div>
                <h4>Evidence reviewed</h4>
                <p>{pathway.evidence}</p>
              </div>
              <div>
                <h4>Typical deliverables</h4>
                <p>{pathway.deliverables}</p>
              </div>
            </div>
            <div class="ui-actions">
              <Button href={pathway.cta}>Discuss This Need</Button>
            </div>
          </Card>
        ))}
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
  .section-intro { max-width:72ch; margin:-.4rem 0 1.25rem; color:var(--color-text-muted); font-size:.96rem; line-height:1.7; }
  .maritime-focus-link { display:block; color:inherit; text-decoration:none; border-radius:var(--radius-lg); }
  .maritime-focus-link:focus-visible { outline:3px solid var(--color-accent); outline-offset:3px; }
  .maritime-focus-card { min-height:19rem; height:100%; display:flex; flex-direction:column; justify-content:flex-end; gap:1rem; transition:transform 160ms ease,border-color 160ms ease,box-shadow 160ms ease; }
  .maritime-focus-link:hover .maritime-focus-card,.maritime-focus-link:focus-visible .maritime-focus-card { transform:translateY(-2px); border-color:rgba(211,154,50,.7); box-shadow:0 12px 28px rgba(0,0,0,.18); }
  .maritime-focus-card h3 { margin:0; }
  .maritime-focus-action { color:var(--color-accent); font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .capability-index { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; }
  .capability-index a { display:flex; align-items:center; justify-content:space-between; gap:1rem; min-height:3.4rem; padding:.85rem 1rem; border:1px solid rgba(148,163,184,.22); border-radius:.65rem; background:rgba(9,24,40,.72); color:#e7edf5; text-decoration:none; font-weight:720; transition:border-color .18s ease,background .18s ease,transform .18s ease; }
  .capability-index a span { color:var(--color-accent); }
  .capability-index a:hover,.capability-index a:focus-visible { border-color:rgba(211,154,50,.62); background:rgba(12,35,58,.9); transform:translateY(-1px); }
  .pathway-stack { display:grid; gap:var(--space-2); }
  .pathway-card { min-height:24rem; padding:clamp(1.5rem,4vw,2.3rem); }
  .pathway-heading { display:grid; grid-template-columns:minmax(0,1fr) minmax(260px,.72fr); gap:1.5rem; align-items:end; margin-bottom:1.15rem; }
  .pathway-kicker { margin:0 0 .3rem; color:#f3aa35; font-size:.7rem; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .pathway-card h3{font-size:clamp(1.45rem,2.4vw,2rem)}
  .pathway-card h4 { margin:0 0 .4rem; font-size:1rem; color:var(--color-text-soft); }
  .pathway-outcome { margin:0; padding:.8rem 1rem; border-left:2px solid rgba(211,154,50,.7); background:rgba(4,15,28,.58); color:#e4ebf2; font-size:.88rem; line-height:1.55; }
  .pathway-grid { margin-bottom:var(--space-1); }
  @media (max-width:800px) { .capability-index { grid-template-columns:1fr; } .pathway-heading { grid-template-columns:1fr; } }
  @media (max-width:640px) { .maritime-focus-grid { grid-template-columns:1fr; } .maritime-focus-card { min-height:17rem; } }
</style>