---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

---

<BaseLayout title="About" description="Learn how Safety Assurance Global delivers independent assurance for maritime and critical infrastructure buyers.">
  <Container>
    <Section class="about-hero" ariaLabelledby="about-title">
      <Badge text="About SAG" />
      <h1 id="about-title">Independent assurance with a consulting-first delivery model.</h1>
      <p>Safety Assurance Global helps organizations improve readiness, quality, and control without presenting software platforms or integrated systems as the core offer.</p>
      <div class="hero-actions">
        <Button href="/services">Explore Services</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </Section>

    <Section ariaLabelledby="values-title">
      <div class="section-head">
        <Badge text="What We Stand For" />
        <h2 id="values-title">Evidence, clarity, and disciplined execution.</h2>
      </div>
      <div class="about-grid">
        <Card><h3>Independent</h3><p>We assess what is actually happening and avoid overstating outcomes or public capabilities.</p></Card>
        <Card><h3>Practical</h3><p>We focus on the next action, the next control, and the next improvement a team can sustain.</p></Card>
        <Card><h3>Controlled</h3><p>Public claims remain aligned to the claims register, and unsupported systems stay out of the sales narrative.</p></Card>
      </div>
    </Section>

    <Section ariaLabelledby="what-title">
      <div class="section-head">
        <Badge text="What SAG Does" />
        <h2 id="what-title">Consulting, assurance, and training support.</h2>
      </div>
      <Card>
        <p>Our work typically includes maritime compliance readiness, operational readiness, QA/QC, contractor assurance, safety and risk management, incident investigation, emergency preparedness, embedded HSE support, and workforce training.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
  .about-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .about-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 20ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .about-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>