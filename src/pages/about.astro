---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const lifecycle = ['Discover', 'Assess', 'Verify', 'Prioritize', 'Improve', 'Validate', 'Assure', 'Sustain'];
---

<BaseLayout
  title="About"
  description="Safety Assurance Global is an independent-assurance and consulting organization focused on maritime and critical infrastructure readiness, safety, risk, QA/QC, and compliance support."
>
  <Container>
    <Section class="hero-panel" ariaLabelledby="about-title">
      <p class="ui-badge">About Safety Assurance Global</p>
      <h1 id="about-title">Independent assurance for maritime and critical infrastructure operations.</h1>
      <p>
        Safety Assurance Global is a consulting and independent-assurance organization focused on operational
        readiness, safety, risk management, QA/QC, contractor assurance, compliance readiness, and workforce
        training support.
      </p>
      <div class="ui-actions">
        <Button href="/services">Explore Services</Button>
        <Button href="/contact" variant="secondary">Request a Consultation</Button>
      </div>
    </Section>

    <Section ariaLabelledby="about-purpose-title">
      <SectionHeader badge="Company Purpose" id="about-purpose-title" title="Help organizations turn risk into disciplined readiness decisions." />
      <Card>
        <p>
          Our purpose is to strengthen operational control performance through evidence-first review, practical
          corrective-action planning, and sustained assurance governance.
        </p>
      </Card>
    </Section>

    <Section ariaLabelledby="about-philosophy-title">
      <SectionHeader badge="Assurance Philosophy" id="about-philosophy-title" title="Evidence before assumption." />
      <div class="grid-two">
        <Card>
          <h3>Evidence-first approach</h3>
          <p>We prioritize what can be verified through records, controls, and operational observation.</p>
        </Card>
        <Card>
          <h3>Execution-focused improvement</h3>
          <p>We emphasize practical action plans that teams can implement and sustain in real operations.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="about-focus-title">
      <SectionHeader badge="Market Focus" id="about-focus-title" title="Maritime and critical-infrastructure support." />
      <div class="grid-two">
        <Card>
          <h3>Maritime focus</h3>
          <p>Support for shipyards, ports and terminals, vessel operators, and marine-contractor environments.</p>
        </Card>
        <Card>
          <h3>Critical-infrastructure focus</h3>
          <p>Support for high-consequence operations requiring reliable readiness and assurance controls.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="about-lifecycle-title">
      <SectionHeader badge="Assurance Lifecycle" id="about-lifecycle-title" title="The method used to structure engagement delivery." />
      <div class="grid-four">
        {lifecycle.map((step) => (
          <Card><h3>{step}</h3></Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="about-posture-title">
      <SectionHeader badge="Ownership and Delivery Posture" id="about-posture-title" title="Public claim limits and verified positioning." />
      <Card>
        <p>
          This site publishes conservative, verified claims only. It does not publish unsupported biographies,
          credentials, board titles, geographic-reach assertions, or authority claims without explicit evidence approval.
        </p>
      </Card>
    </Section>
  </Container>
</BaseLayout>
