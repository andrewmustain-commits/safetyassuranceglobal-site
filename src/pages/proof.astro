---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';

const proofPaths = [
  {
    title: 'Sample deliverables',
    copy: 'Inspect sanitized structures for readiness assessments, finding/action/closure records, inspection summaries, corrective-action validation, and management reporting.',
    href: '/sample-deliverables',
    action: 'See sample structures'
  },
  {
    title: 'Service sheets',
    copy: 'Review concise buyer-facing summaries of the problem, scope, evidence reviewed, engagement process, expected result, and typical deliverables for each service.',
    href: '/service-sheets',
    action: 'Review service sheets'
  },
  {
    title: 'Evidence standard',
    copy: 'See how Safety Assurance Global keeps requirements, field evidence, findings, corrective actions, validation, and reporting connected.',
    href: '/method',
    action: 'Review the method'
  },
  {
    title: 'Corporate capability profile',
    copy: 'Review public corporate capabilities, scope boundaries, procurement information, and the current downloadable capability statement.',
    href: '/capabilities',
    action: 'Review capabilities'
  },
  {
    title: 'Illustrative engagements',
    copy: 'See clearly labeled scenarios that connect an operating problem to evidence review, assurance activity, deliverables, and decision support without inventing customers or outcomes.',
    href: '/engagement-examples',
    action: 'View engagement examples'
  },
  {
    title: 'Leadership accountability',
    copy: 'See who is accountable for business and technical conversations and how opportunity-specific qualifications are handled.',
    href: '/leadership',
    action: 'Meet leadership'
  }
];

const deliverableExamples = [
  ['Readiness Assessment', 'Decision criteria, evidence reviewed, gaps, actions, and readiness status.'],
  ['Gap Register', 'A controlled view of what is missing, why it matters, who owns it, and what closes it.'],
  ['Corrective-Action Tracker', 'Finding-to-action traceability with required evidence, due dates, and verification status.'],
  ['Validation Report', 'Documented review of whether agreed corrective action and evidence support closure.'],
  ['Executive Dashboard', 'Decision-focused view of status, priority issues, aging actions, and items requiring leadership attention.'],
  ['QA/QC Verification Record', 'Criteria, observations, records, nonconformance themes, actions, and follow-up evidence.']
];
---

<BaseLayout
  title="Evidence & Results"
  description="Safety Assurance Global evidence center with sanitized deliverable structures, service sheets, assurance method, capability information, and clear engagement boundaries."
>
  <Container class="proof-page">
    <HeroSection
      id="proof-title"
      badge="Evidence Before Claims"
      title="See how assurance becomes decision-ready evidence."
      image="/images/site-2026/capabilities-hero.webp"
      imagePosition="center 46%"
    >
      <p>Buyers should be able to understand what an engagement is intended to examine, how findings stay connected to evidence, and what work products may be delivered before they start a commercial conversation.</p>
      <div class="ui-actions">
        <Button href="/sample-deliverables">See Sample Deliverables</Button>
        <Button href="/start" variant="secondary">Start a Scope</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="proof-paths-title">
      <SectionHeader badge="Proof Center" id="proof-paths-title" title="Evaluate the work before you evaluate the proposal." />
      <div class="proof-path-grid">
        {proofPaths.map((item, index) => (
          <Card class="proof-path-card">
            <span class="proof-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <p><a href={item.href}>{item.action} →</a></p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="deliverable-proof-title">
      <SectionHeader badge="What the Buyer May Receive" id="deliverable-proof-title" title="Work products designed around decisions, actions, and traceability." />
      <div class="deliverable-ledger">
        {deliverableExamples.map(([title, copy], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{copy}</p></div>
          </article>
        ))}
      </div>
      <p class="proof-boundary">These are representative work-product types, not promises that every engagement includes every deliverable. The contracted scope controls actual outputs.</p>
    </Section>

    <Section ariaLabelledby="proof-cycle-title">
      <div class="proof-cycle">
        <div>
          <p class="eyebrow">Traceable assurance</p>
          <h2 id="proof-cycle-title">Requirement → evidence → finding → action → closure.</h2>
          <p>A result is useful only when the decision-maker can understand what was required, what was observed or reviewed, what gap was identified, what action was taken, and what evidence supports the final disposition.</p>
        </div>
        <ol>
          <li><span>01</span><strong>Define</strong><small>Requirement and decision boundary</small></li>
          <li><span>02</span><strong>Verify</strong><small>Records, controls, field conditions</small></li>
          <li><span>03</span><strong>Find</strong><small>Evidence-backed gaps</small></li>
          <li><span>04</span><strong>Correct</strong><small>Owned actions and required evidence</small></li>
          <li><span>05</span><strong>Validate</strong><small>Closure evidence and follow-through</small></li>
          <li><span>06</span><strong>Report</strong><small>Decision-ready status</small></li>
        </ol>
      </div>
    </Section>

    <Section ariaLabelledby="proof-tools-title">
      <SectionHeader badge="Use the Method Yourself" id="proof-tools-title" title="Practical tools for organizing readiness evidence before an engagement." />
      <div class="grid-two">
        <Card><h3>Readiness Snapshot</h3><p>Use ten evidence-focused questions to identify where current readiness visibility may be incomplete or unknown.</p><p><a href="/readiness-check">Run the readiness snapshot →</a></p></Card>
        <Card><h3>Customer Resource Center</h3><p>Download generic evidence matrices, corrective-action registers, contractor-readiness checklists, and QA/QC verification logs.</p><p><a href="/resources">Open customer resources →</a></p></Card>
      </div>
    </Section>

    <Section ariaLabelledby="proof-government-title">
      <SectionHeader badge="Procurement Evidence" id="proof-government-title" title="Government and prime-contractor buyers can move directly to procurement facts." />
      <Card class="photo-backed-band" style="--band-image:url(/images/site-2026/government-hero.webp);--band-position:center 52%">
        <p>Review the published capability profile, current procurement identifiers, buyer paths, teaming information, and downloadable capability statement without navigating the entire site.</p>
        <div class="ui-actions">
          <Button href="/government">Government Acquisition Center</Button>
          <Button href="/partners" variant="secondary">Prime & Teaming Path</Button>
        </div>
      </Card>
    </Section>

    <Section ariaLabelledby="proof-boundary-title">
      <SectionHeader badge="Truth Boundary" id="proof-boundary-title" title="Examples explain the method without inventing performance." />
      <Card>
        <p>Illustrative structures and examples do not represent fictional customers, awards, project outcomes, agency relationships, or corporate past performance. Where prior individual experience is referenced elsewhere, it must remain attributed to the individual and the applicable prior employer or assignment context.</p>
      </Card>
    </Section>
  </Container>
</BaseLayout>

<style>
.proof-page{display:grid;gap:.25rem}.proof-path-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.proof-path-card{min-height:15rem}.proof-number{display:inline-block;margin-bottom:.8rem;color:var(--color-accent);font-size:.72rem;font-weight:900;letter-spacing:.12em}.deliverable-ledger{display:grid;border-top:1px solid rgba(148,163,184,.24)}.deliverable-ledger article{display:grid;grid-template-columns:4rem 1fr;gap:1rem;padding:1.35rem 0;border-bottom:1px solid rgba(148,163,184,.24)}.deliverable-ledger article>span{color:#f1d493;font-size:.75rem;letter-spacing:.1em}.deliverable-ledger h3{margin:0 0 .35rem;font-size:clamp(1.2rem,2vw,1.65rem)}.deliverable-ledger p{margin:0;max-width:72ch}.proof-boundary{max-width:80ch;margin-top:1rem;color:var(--color-text-soft);font-size:.88rem}.proof-cycle{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(2rem,5vw,5rem);align-items:start}.proof-cycle h2{font-size:clamp(2rem,4vw,3.6rem);line-height:1}.proof-cycle ol{list-style:none;margin:0;padding:0}.proof-cycle li{display:grid;grid-template-columns:3rem 8rem 1fr;gap:.75rem;padding:1rem 0;border-top:1px solid rgba(148,163,184,.24)}.proof-cycle li>span{color:#f1d493;font-size:.72rem}.proof-cycle strong{color:#fff}.proof-cycle small{color:var(--color-text-soft);font-size:.85rem}@media(max-width:820px){.proof-path-grid,.proof-cycle{grid-template-columns:1fr}.proof-cycle li{grid-template-columns:2.5rem 7rem 1fr}}@media(max-width:560px){.proof-path-grid{grid-template-columns:1fr}.proof-cycle li{grid-template-columns:2rem 1fr}.proof-cycle small{grid-column:2}}
</style>
