---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import { brandAssets } from '../config/brand-assets';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved' || data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3)
  .map((post) => ({ slug: post.data.slug, title: post.data.title, summary: post.data.description, date: post.data.publishedAt, category: post.data.category }));

const customerProblems = [
  { href: '/services/operational-readiness', title: 'Prove operational readiness', copy: 'Verify whether plans, controls, people, evidence, and open actions support the decision to proceed.' },
  { href: '/services/contractor-assurance', title: 'Verify contractor readiness', copy: 'Understand whether contractor controls, records, performance evidence, and corrective actions are ready for execution.' },
  { href: '/services/qa-qc', title: 'Strengthen quality verification', copy: 'Connect requirements, inspection evidence, field conditions, nonconformance, and corrective action.' },
  { href: '/government', title: 'Prepare for a government or prime requirement', copy: 'Move quickly to procurement facts, capability fit, teaming information, and a defined requirement.' }
]


const typicalOutputs = [
  'Readiness assessment',
  'Gap register',
  'Corrective-action roadmap',
  'Validation report',
  'Executive dashboard'
];

const instituteUrl = 'https://institute.safetyassuranceglobal.com';
const academiesUrl = 'https://institute.safetyassuranceglobal.com/institute/academies/';
---

<BaseLayout title="Home" image="/images/brand/sag-social-share.svg" description="Safety Assurance Global provides maritime assurance, contractor and supplier assurance, safety and quality verification, operational readiness reviews, and corrective-action closure validation.">
  <div class="home-v34">
    <section class="hero-v34" aria-labelledby="home-hero-title">
      <img class="hero-scene" src="/images/site-2026/home-hero.webp" alt="Maritime assurance professionals observing port and vessel operations" fetchpriority="high" decoding="async" />
      <div class="hero-overlay"></div>
      <Container class="hero-content">
        <div class="hero-copy">
          <p class="hero-eyebrow">Maritime assurance for safer, stronger, ready operations</p>
          <h1 id="home-hero-title">Know your operation is ready—<strong>before it matters.</strong></h1>
          <span class="hero-rule" aria-hidden="true"></span>
          <p>We help maritime operators and high-consequence teams verify safety controls, contractor readiness, quality, and operational plans before critical work moves forward. Buyers receive traceable findings, actions, closure evidence, and decision-ready reporting.</p>
          <div class="hero-actions">
            <Button href="/start">Start a Scope</Button>
            <Button href="/proof" variant="secondary">See Evidence & Deliverables</Button>
          </div>
          <p class="hero-support">Serving shipyards, ports and terminals, vessel operators, marine contractors, and government maritime programs.</p>
        </div>
      </Container>
    </section>

    <section class="trust-strip" aria-label="Safety Assurance Global trust signals">
      <Container class="trust-grid">
        <p><strong>Independent</strong><small>Objective assurance and verification</small></p>
        <p><strong>Evidence-led</strong><small>Requirements, findings, actions, closure</small></p>
        <p><strong>Maritime-first</strong><small>Ports, terminals, shipyards, vessels</small></p>
        <p><strong>Government-ready</strong><small>VOSB / SDVOSB · SBA VetCert</small></p>
      </Container>
    </section>

    <section class="customer-problems" aria-labelledby="customer-problems-title">
      <Container>
        <div class="light-heading"><p>Start with your problem</p><h2 id="customer-problems-title">What needs to be proven before the work moves forward?</h2><span></span></div>
        <div class="customer-problem-grid">
          {customerProblems.map((item, index) => (
            <a href={item.href} class="customer-problem">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{item.title}</h3><p>{item.copy}</p></div>
              <strong aria-hidden="true">→</strong>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <section class="home-proof" aria-labelledby="home-proof-title">
      <Container class="home-proof-shell">
        <div>
          <p class="eyebrow">See what the work looks like</p>
          <h2 id="home-proof-title">A buyer should know what evidence may come back before the engagement starts.</h2>
          <p>Inspect a populated synthetic work product, then review the people, method, procurement information, and scope boundaries behind the offer.</p>
          <div class="ui-actions"><a class="ui-button ui-button-primary" href="/completed-example">Inspect a Completed Example</a><a class="ui-button ui-button-secondary" href="/leadership">Meet the People Behind the Work</a></div>
        </div>
        <div class="home-proof-ledger">
          {typicalOutputs.map((output, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{output}</strong><small>Representative work product</small></div>)}
        </div>
      </Container>
    </section>

    <Container class="lower-home">
      <Section class="maritime-panel photo-backed-band" style="--band-image:url(/images/site-2026/maritime-hero.webp);--band-position:center 55%" ariaLabelledby="maritime-title">
        <div><Badge text="Primary Market" /><h2 id="maritime-title">Built around high-consequence maritime operations.</h2><p>Safety Assurance Global supports ports, marine terminals, shipyards, vessel operations, marine contractors, and government maritime programs with independent assurance and readiness support.</p></div><Button href="/maritime" variant="secondary">Explore Maritime</Button>
      </Section>

      <section class="home-tools" aria-labelledby="home-tools-title">
        <div class="home-tools__intro">
          <p>Useful before an engagement</p>
          <h2 id="home-tools-title">Organize the problem before you call us.</h2>
          <p>Use practical, no-login tools to check evidence visibility, build a preliminary scope, and download working templates for readiness, corrective actions, contractor assurance, and QA/QC.</p>
        </div>
        <div class="home-tools__grid">
          <a href="/readiness-check"><span>01</span><strong>Readiness Snapshot</strong><small>Ten evidence-focused questions</small></a>
          <a href="/start"><span>02</span><strong>Start a Scope</strong><small>Guided engagement routing</small></a>
          <a href="/resources"><span>03</span><strong>Customer Resources</strong><small>Downloadable working templates</small></a>
          <a href="/proof"><span>04</span><strong>Evidence & Results</strong><small>Sample deliverables and method</small></a>
        </div>
      </section>

      <section class="institute-gateway" aria-labelledby="institute-title">
        <img class="institute-gateway-scene" src="/images/site-2026/institute-hero.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <span class="institute-gateway-overlay" aria-hidden="true"></span>
        <div class="institute-gateway-copy">
          <p class="institute-gateway-eyebrow">Professional education and assurance learning</p>
          <h2 id="institute-title">Safety Assurance Global Institute of Assurance™</h2>
          <p class="institute-gateway-lede">The Safety Assurance Global Institute of Assurance is a professional education and assurance-learning institution associated with the Safety Assurance Global ecosystem. Its dedicated website brings together the Institute’s Academy structure, Institute Core, professional learning pathways, and available course information.</p>
          <div class="institute-gateway-actions">
            <a class="ui-button ui-button-primary" href={instituteUrl}>Explore the Institute</a>
            <a class="ui-button ui-button-secondary" href={academiesUrl}>View Academies</a>
          </div>
          <p class="institute-gateway-boundary">Program availability, enrollment status, assessment requirements, and any credential decision are confirmed for each offering on the Institute website. This corporate site does not represent automatic enrollment, accreditation, approval, or credential issuance.</p>
        </div>
        <aside class="institute-gateway-structure" aria-labelledby="institute-structure-title">
          <img src={brandAssets.instituteSeal} alt="Safety Assurance Global Institute of Assurance seal" width="152" height="152" loading="lazy" decoding="async" />
          <div>
            <p>Institute structure</p>
            <h3 id="institute-structure-title">One destination for professional learning.</h3>
          </div>
          <ul>
            <li><strong>Academies</strong><span>Domain-focused learning communities</span></li>
            <li><strong>Institute Core</strong><span>Shared assurance foundations</span></li>
            <li><strong>Professional pathways</strong><span>Role-aware learning progression</span></li>
            <li><strong>Course information</strong><span>Published details and current status</span></li>
          </ul>
        </aside>
      </section>

      <section class="conversion-close" aria-labelledby="conversion-close-title">
        <p class="conversion-close__eyebrow">Start with the requirement</p>
        <h2 id="conversion-close-title">What needs to be proven before the work moves forward?</h2>
        <p>Share the operating environment, requirement, schedule, and expected outcome. Safety Assurance Global can use that context to determine the appropriate next conversation.</p>
        <div class="conversion-close__actions">
          <a class="ui-button ui-button-primary" href="/contact">Discuss a Requirement</a>
          <a class="ui-button ui-button-secondary" href="/request-proposal">Request a Proposal</a>
        </div>
      </section>

      {approvedPosts.length > 0 && <section class="editorial-insights" aria-labelledby="insights-title">
        <div class="editorial-insights__heading"><p>Insights</p><h2 id="insights-title">Thinking from the field.</h2><a href="/insights">View all insights →</a></div>
        <div class="editorial-insights__grid">
          {approvedPosts.map((post,index)=><article class={index === 0 ? 'editorial-insight editorial-insight--featured' : 'editorial-insight'}>
            <p class="insight-meta"><span>{post.category}</span><time datetime={post.date.toISOString()}>{post.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></p>
            <h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p><a class="editorial-insight__link" href={`/insights/${post.slug}`}>Read insight →</a>
          </article>)}
        </div>
      </section>}
    </Container>
  </div>
</BaseLayout>

<style>
:global(body:has(.home-v34) .site-main){padding-top:0}.home-v34{margin-top:0}.hero-v34{position:relative;min-height:660px;overflow:hidden;border-bottom:1px solid rgba(211,154,50,.55);background:#041424}.hero-scene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% 52%;filter:saturate(1) contrast(1.03) brightness(1.06)}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,16,29,.97) 0%,rgba(3,16,29,.86) 29%,rgba(3,16,29,.46) 51%,rgba(3,16,29,.07) 76%,rgba(3,16,29,.01) 100%),linear-gradient(180deg,rgba(2,12,23,.01),rgba(2,12,23,.24))}.hero-content{position:relative;z-index:1;display:flex;align-items:center;min-height:660px}.hero-copy{max-width:680px;padding:3.55rem 0}.hero-eyebrow{margin:0 0 .7rem;color:#e3a43a!important;font-size:.78rem!important;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hero-copy h1{margin:0;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(2.55rem,5vw,4.9rem);line-height:1;letter-spacing:-.035em;text-shadow:0 2px 24px rgba(0,0,0,.34)}.hero-copy h1 strong{display:block;margin-top:.12em;color:#d8942c;font-weight:900}.hero-rule{display:block;width:84px;height:3px;margin:1.15rem 0;background:#d39a32}.hero-copy>p:not(.hero-eyebrow):not(.hero-support){max-width:650px;margin:0;color:#f2f6fa;font-size:clamp(1rem,1.35vw,1.13rem);line-height:1.65;text-shadow:0 1px 12px rgba(0,0,0,.4)}.hero-actions{display:flex;flex-wrap:wrap;gap:.85rem;margin-top:1.45rem}.hero-actions :global(.ui-button){min-height:3.05rem}.hero-support{max-width:650px;margin:1.25rem 0 0!important;color:#d9e2eb!important;font-size:.83rem!important;line-height:1.5!important}.trust-strip{background:#061a2d;border-bottom:1px solid rgba(211,154,50,.28)}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding-top:1.05rem;padding-bottom:1.05rem}.trust-grid p{display:grid;gap:.1rem;margin:0;padding:.1rem 1rem;border-right:1px solid rgba(211,154,50,.25)}.trust-grid p:last-child{border-right:0}.trust-grid strong{color:#fff;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}.trust-grid small{color:#c7d0db;font-size:.67rem;line-height:1.35}.engagements{padding:3.15rem 0 3.3rem;background:#fafafa;color:#07192a;border-bottom:1px solid #e5e7eb}.light-heading{text-align:center}.light-heading>p{margin:0;color:#b8791d;font-size:.73rem;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.light-heading h2{max-width:820px;margin:.42rem auto 0;color:#07192a;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(1.55rem,2.8vw,2.35rem);line-height:1.13}.light-heading span{display:block;width:78px;height:2px;margin:.85rem auto 1.6rem;background:#d39a32}.engagement-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.engagement-card{overflow:hidden;display:flex;flex-direction:column;border:1px solid #dfe4e9;border-radius:.65rem;background:#fff;color:#07192a;text-decoration:none;box-shadow:0 7px 20px rgba(7,25,42,.08);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.engagement-card:hover,.engagement-card:focus-visible{transform:translateY(-4px);border-color:#d39a32;box-shadow:0 14px 30px rgba(7,25,42,.14)}.engagement-card>img{width:100%;height:185px;object-fit:cover;filter:saturate(1) contrast(1.02) brightness(1.04)}.engagement-card-body{display:flex;flex:1;flex-direction:column;padding:1.05rem 1.15rem 1.2rem}.engagement-card-body>span{color:#b8791d;font-size:.7rem;font-weight:900;letter-spacing:.12em}.engagement-card h3{margin:.55rem 0;color:#07192a;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:1rem;line-height:1.25}.engagement-card p{flex:1;margin:0;color:#3d4854;font-size:.83rem;line-height:1.55}.engagement-card strong{margin-top:1rem;color:#0a4272;font-size:.76rem}.service-depth{margin:1.35rem 0 0;text-align:center;color:#4b5563;font-size:.84rem}.service-depth a{color:#0a4a80;font-weight:800}.output-strip{padding:2.35rem 0;border-bottom:1px solid rgba(211,154,50,.24);background:linear-gradient(135deg,#061525,#0a2238 68%,#0b2c45);color:#fff}.output-strip-shell{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.35fr);gap:1.5rem 2rem;align-items:center}.output-strip-heading p{margin:0 0 .4rem;color:#e3a43a;font-size:.7rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.output-strip-heading h2{margin:0;max-width:17ch;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(1.45rem,2.5vw,2.15rem);line-height:1.12}.output-strip-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.65rem}.output-item{display:grid;gap:.4rem;min-height:5.6rem;padding:.8rem;border:1px solid rgba(211,154,50,.28);border-radius:.55rem;background:rgba(3,16,29,.42)}.output-item span{color:#e3a43a;font-size:.65rem;font-weight:900;letter-spacing:.12em}.output-item strong{align-self:end;color:#f2f6fa;font-size:.77rem;line-height:1.35}.output-note{grid-column:1/-1;margin:0;color:#bdcad6;font-size:.76rem;line-height:1.5}.lower-home{padding-top:1.1rem}.maritime-panel,.method-panel-v34,.institute-panel-v34{display:grid;grid-template-columns:1fr auto;gap:1.4rem;align-items:center;min-height:21rem;padding:clamp(1.5rem,4vw,2.6rem)}.method-panel-v34 ol{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;list-style:none;margin:.5rem 0 0;padding:0}.method-panel-v34 li{display:flex;gap:.65rem;align-items:center;padding:.7rem;border:1px solid rgba(148,163,184,.18);border-radius:.6rem;background:rgba(6,20,36,.76);color:#e7edf5;font-size:.82rem}.method-panel-v34 li span{color:#f3aa35;font-weight:900}.insight-grid-v34{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.insight-heading{margin-bottom:1rem}.insight-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.74rem}.insight-meta span{color:#f59e0b;text-transform:uppercase;font-weight:800}.insight-meta time{color:#94a3b8}.insight-grid-v34 h3 a{color:#fff;text-decoration:none}@media(max-width:1000px){.output-strip-shell{grid-template-columns:1fr}.output-strip-heading h2{max-width:28ch}.output-strip-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:900px){.engagement-grid{grid-template-columns:repeat(2,1fr)}.trust-grid{grid-template-columns:repeat(2,1fr)}.trust-grid p:nth-child(2){border-right:0}.method-panel-v34 ol{grid-template-columns:repeat(2,1fr)}.hero-scene{object-position:62% 52%}}@media(max-width:640px){.hero-v34,.hero-content{min-height:700px}.hero-copy{padding:2.45rem 0}.hero-copy h1{font-size:clamp(2.2rem,11vw,3.3rem)}.hero-scene{object-position:66% center}.hero-overlay{background:linear-gradient(180deg,rgba(3,16,29,.02) 0%,rgba(3,16,29,.18) 34%,rgba(3,16,29,.68) 64%,rgba(3,16,29,.97) 100%)}.hero-content{align-items:flex-end}.hero-actions{display:grid}.hero-actions :global(.ui-button){width:100%}.trust-grid,.engagement-grid,.method-panel-v34 ol,.insight-grid-v34,.output-strip-grid{grid-template-columns:1fr}.trust-grid p{border-right:0;border-bottom:1px solid rgba(211,154,50,.2);padding:.55rem .2rem}.trust-grid p:last-child{border-bottom:0}.engagement-card>img{height:205px}.output-item{min-height:auto;grid-template-columns:auto 1fr;align-items:center}.output-item strong{align-self:center}.maritime-panel,.method-panel-v34,.institute-panel-v34{grid-template-columns:1fr;min-height:25rem;align-content:end}.method-panel-v34 ol{grid-column:auto}}
</style>

<style>
.institute-gateway{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:clamp(1.5rem,4vw,3.5rem);align-items:center;overflow:hidden;min-height:34rem;padding:clamp(1.6rem,5vw,4rem);border:1px solid rgba(211,154,50,.42);border-radius:1rem;background:#061525;box-shadow:0 24px 54px rgba(0,0,0,.28)}
.institute-gateway-scene,.institute-gateway-overlay{position:absolute;inset:0;width:100%;height:100%}.institute-gateway-scene{z-index:-2;object-fit:cover;object-position:center 52%;filter:saturate(.94) contrast(1.04)}.institute-gateway-overlay{z-index:-1;background:linear-gradient(90deg,rgba(3,16,29,.98) 0%,rgba(3,16,29,.9) 43%,rgba(3,16,29,.6) 72%,rgba(3,16,29,.78) 100%),linear-gradient(180deg,rgba(2,12,23,.04),rgba(2,12,23,.48))}
.institute-gateway-copy{max-width:760px}.institute-gateway-eyebrow{margin:0 0 .65rem;color:#e3a43a;font-size:.74rem;font-weight:900;letter-spacing:0;text-transform:uppercase}.institute-gateway h2{max-width:16ch;margin:0;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(2rem,4vw,3.55rem);line-height:1.04}.institute-gateway-lede{max-width:68ch;margin:1rem 0 0;color:#e4ebf2;font-size:clamp(.98rem,1.35vw,1.1rem);line-height:1.68}.institute-gateway-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.35rem}.institute-gateway-boundary{max-width:76ch;margin:1.2rem 0 0;color:#bcc9d5;font-size:.76rem;line-height:1.55}
.institute-gateway-structure{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:1.25rem;border:1px solid rgba(211,154,50,.32);border-radius:.8rem;background:rgba(4,16,29,.86);box-shadow:0 18px 36px rgba(0,0,0,.28)}.institute-gateway-structure>img{width:92px;height:92px;object-fit:contain;filter:drop-shadow(0 12px 20px rgba(0,0,0,.4))}.institute-gateway-structure p{margin:0 0 .35rem;color:#e3a43a;font-size:.68rem;font-weight:900;letter-spacing:0;text-transform:uppercase}.institute-gateway-structure h3{margin:0;color:#fff;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:1.05rem;line-height:1.3}.institute-gateway-structure ul{grid-column:1/-1;display:grid;gap:.55rem;margin:.25rem 0 0;padding:0;list-style:none}.institute-gateway-structure li{display:grid;grid-template-columns:minmax(110px,.7fr) minmax(0,1.3fr);gap:.75rem;padding:.65rem .7rem;border-top:1px solid rgba(148,163,184,.18)}.institute-gateway-structure strong{color:#f5f7fa;font-size:.78rem}.institute-gateway-structure span{color:#bfcbd6;font-size:.75rem;line-height:1.4}
@media(max-width:900px){.institute-gateway{grid-template-columns:1fr;min-height:unset}.institute-gateway h2{max-width:20ch}.institute-gateway-structure{max-width:680px}}
@media(max-width:640px){.institute-gateway{padding:1.35rem;align-content:end}.institute-gateway-overlay{background:linear-gradient(180deg,rgba(3,16,29,.5),rgba(3,16,29,.97) 42%)}.institute-gateway-actions{display:grid}.institute-gateway-actions .ui-button{width:100%}.institute-gateway-structure{grid-template-columns:1fr}.institute-gateway-structure>img{width:78px;height:78px}.institute-gateway-structure ul{grid-column:auto}.institute-gateway-structure li{grid-template-columns:1fr;gap:.2rem}}
</style>
<style>
.customer-problems{padding:var(--oa-section-space) 0;background:#f4f5f7;color:#07192a;border-bottom:1px solid #e5e7eb}.customer-problem-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid #d7dce2}.customer-problem{display:grid;grid-template-columns:3rem 1fr auto;gap:1rem;align-items:start;padding:1.4rem 1rem;border-bottom:1px solid #d7dce2;color:#07192a;text-decoration:none}.customer-problem:nth-child(odd){border-right:1px solid #d7dce2}.customer-problem>span{color:#9b6a19;font-size:.72rem;font-weight:900;letter-spacing:.1em}.customer-problem h3{margin:0 0 .35rem;font-size:clamp(1.15rem,2vw,1.55rem)}.customer-problem p{margin:0;color:#475569;line-height:1.55}.customer-problem>strong{font-size:1.3rem;color:#9b6a19;transition:transform .18s ease}.customer-problem:hover>strong,.customer-problem:focus-visible>strong{transform:translateX(.25rem)}.home-proof{padding:var(--oa-section-space) 0;background:linear-gradient(120deg,#101c2e,#09121f)}.home-proof-shell{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:var(--oa-content-gap);align-items:start}.home-proof-shell h2{font-size:clamp(2.2rem,4.4vw,4.2rem);line-height:1;letter-spacing:-.025em}.home-proof-shell>div:first-child>p:not(.eyebrow){max-width:60ch}.home-proof-ledger{display:grid;border-top:1px solid rgba(148,163,184,.25)}.home-proof-ledger>div{display:grid;grid-template-columns:2.5rem 1fr auto;gap:.75rem;padding:1rem 0;border-bottom:1px solid rgba(148,163,184,.25);align-items:center}.home-proof-ledger span{color:#f1d493;font-size:.7rem}.home-proof-ledger small{color:#94a3b8;font-size:.75rem}@media(max-width:760px){.customer-problem-grid,.home-proof-shell{grid-template-columns:1fr}.customer-problem:nth-child(odd){border-right:0}.home-proof-ledger>div{grid-template-columns:2rem 1fr}.home-proof-ledger small{grid-column:2}}
