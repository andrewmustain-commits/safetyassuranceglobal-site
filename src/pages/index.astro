---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved' || data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3)
  .map((post) => ({ slug: post.data.slug, title: post.data.title, summary: post.data.description, date: post.data.publishedAt, category: post.data.category }));
const services = [
 ['MA','Maritime Assurance','Independent review of compliance readiness, operating controls, and evidence across maritime environments.'],
 ['OR','Operational Readiness','Structured assessments that reveal execution gaps before mobilization, review, or deployment.'],
 ['QC','QA/QC & Contractor Assurance','Field-focused verification of contractor controls, documentation, quality, and traceable performance evidence.'],
 ['SG','Safety Governance','Executive-level governance, accountability, and management-system support for high-consequence operations.'],
 ['RC','Risk & Compliance','Practical risk, regulatory, and control reviews that help leaders prioritize defensible corrective action.'],
 ['IR','Independent Reviews','Objective assessments, incident reviews, and decision support without unsupported approval claims.']
];
const industries = [
 ['Ports & Marine Terminals','Primary-market assurance support for complex port, terminal, cargo, and contractor interfaces.'],
 ['Shipyards & Vessel Operations','Primary-market readiness, compliance, and field assurance for shipyard and vessel operating environments.'],
 ['Construction & Capital Projects','Safety, quality, contractor-assurance, and readiness support for complex project execution.'],
 ['Critical Infrastructure','Evidence-based assurance support for essential facilities, public assets, transportation, and regulated operating environments.'],
 ['Energy & Process Industries','Governance, readiness, risk, and assurance support for complex process and energy operations.'],
 ['Industrial & Occupational Safety','Risk-control, management-system, incident-prevention, and workforce-readiness support for industrial operations.'],
 ['Quality & Operational Excellence','QA/QC, performance verification, corrective-action discipline, and operational-improvement support.'],
 ['Technology & Digital Systems','Assurance-oriented support for technology-enabled operations, digital controls, and readiness-related systems.']
];
---
<BaseLayout title="Home" description="Safety Assurance Global is maritime-focused and provides independent assurance, operational readiness, QA/QC, contractor assurance, safety governance, and risk support across high-consequence sectors.">
 <Container class="homepage-shell">
  <Section class="executive-hero" ariaLabelledby="home-hero-title">
   <div class="hero-copy"><Badge text="Maritime-First Independent Assurance" /><p class="hero-kicker">Safety Assurance Global</p><h1 id="home-hero-title">Independent Assurance for Maritime & High-Consequence Operations</h1><p class="hero-lede">Maritime is our primary market. We help owners, contractors, and government organizations strengthen operational readiness through independent assurance, quality oversight, safety governance, and evidence-based risk management, with broader capability across other high-consequence sectors.</p><div class="hero-actions"><Button href="/maritime">Explore Maritime Services</Button><Button href="/contact" variant="secondary">Book a Consultation</Button></div><div class="hero-proof" aria-label="Safety Assurance Global differentiators"><span>Veteran-Owned</span><span>Evidence-Based</span><span>Maritime Focused</span></div></div>
   <aside class="hero-brand" aria-label="Safety Assurance Global brand mark"><div class="brand-halo"></div><img src="/images/brand/sag-logo.svg" alt="Safety Assurance Global logo" width="330" height="330" /><p>Increase operational readiness through independent assurance supported by measurable evidence.</p></aside>
  </Section>
  <Section ariaLabelledby="services-title"><div class="section-heading"><Badge text="Core Services" /><div><h2 id="services-title">Assurance services built for consequential work.</h2><p>Maritime leads our market focus, supported by transferable assurance, safety, quality, risk, and readiness capabilities for other complex operating environments.</p></div></div><div class="service-grid">{services.map(([code,title,description]) => <Card class="service-card"><span class="service-code" aria-hidden="true">{code}</span><h3>{title}</h3><p>{description}</p><a href="/services">Learn more <span aria-hidden="true">→</span></a></Card>)}</div></Section>
  <Section class="industries-panel" ariaLabelledby="industries-title"><div class="section-heading"><Badge text="Sector Coverage" /><div><h2 id="industries-title">Maritime first. Broader assurance capability where the work demands it.</h2><p>SAG supports defined scopes where our personnel, evidence, experience, and engagement controls substantiate the work. We do not represent universal licensing, accreditation, regulatory approval, or unrestricted capability.</p></div></div><div class="industry-grid">{industries.map(([title,description],index) => <a class="industry-card" href="/industries"><span class="industry-number">{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{description}</p></a>)}</div></Section>
  <Section class="method-panel" ariaLabelledby="method-title"><div class="method-intro"><Badge text="The SAG Assurance Method" /><h2 id="method-title">A disciplined path from uncertainty to sustained assurance.</h2><p>Every engagement is organized around practical evidence, prioritized action, and measurable operational improvement.</p><Button href="/method" variant="secondary">View Our Method</Button></div><ol class="method-steps">{['Discover','Assess','Verify','Prioritize','Improve','Validate','Assure','Sustain'].map((step,index) => <li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol></Section>
  <Section ariaLabelledby="institute-title"><div class="academy-feature"><div><Badge text="SAG Institute of Assurance" /><h2 id="institute-title">Governed learning and workforce development across SAG's sector coverage.</h2><p>The Institute supports readiness-focused learning pathways for maritime and other defined sectors. Program availability, credential status, and any external recognition are stated only when verified.</p><p><strong>Powered by Mandavere.</strong></p></div><Button href="/institute" variant="secondary">Explore the Institute</Button></div></Section>
  {approvedPosts.length > 0 && <Section ariaLabelledby="insights-title"><div class="section-heading"><Badge text="Insights" /><div><h2 id="insights-title">Approved perspectives for leaders and operators.</h2></div></div><div class="insight-grid">{approvedPosts.map((post) => <Card as="article" class="insight-card"><p class="insight-meta"><span>{post.category}</span><time datetime={post.date.toISOString()}>{post.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></p><h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p></Card>)}</div></Section>}
  <Section class="final-cta" ariaLabelledby="consultation-title"><div><Badge text="Start the Conversation" /><h2 id="consultation-title">Ready to improve operational readiness?</h2><p>Start with a focused consultation about your operating environment, risks, evidence, contractors, and required outcomes.</p></div><div class="hero-actions"><Button href="/contact">Book a Consultation</Button><Button href="/request-proposal" variant="secondary">Request a Proposal</Button></div></Section>
 </Container>
</BaseLayout>
<style>
.homepage-shell{display:grid;gap:clamp(1.5rem,3vw,2.5rem);padding-top:clamp(1rem,2vw,1.5rem)}.executive-hero{position:relative;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:clamp(1.5rem,4vw,4rem);overflow:hidden;min-height:610px;padding:clamp(2rem,6vw,5.5rem);border:1px solid rgba(202,164,79,.48);border-radius:var(--radius-xl);background:radial-gradient(circle at 75% 40%,rgba(36,116,125,.22),transparent 30%),linear-gradient(125deg,rgba(5,17,35,.99),rgba(8,30,53,.96) 52%,rgba(7,20,34,.98));box-shadow:var(--shadow-panel)}.executive-hero:before,.executive-hero:after{content:'';position:absolute;pointer-events:none}.executive-hero:before{inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to right,black,transparent 85%)}.executive-hero:after{right:-10%;bottom:-50%;width:620px;height:620px;border:1px solid rgba(202,164,79,.18);border-radius:50%}.hero-copy,.hero-brand{position:relative;z-index:1}.hero-copy{align-self:center}.hero-kicker{margin:1.2rem 0 0;color:var(--color-accent);font-size:.82rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.hero-copy h1{max-width:13ch;margin:.7rem 0 1.25rem;font-size:clamp(2.6rem,6vw,5.8rem);line-height:.98;letter-spacing:-.045em}.hero-lede{max-width:720px;color:rgba(235,242,248,.82);font-size:clamp(1.05rem,1.8vw,1.28rem);line-height:1.7}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.8rem}.hero-proof{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;margin-top:2rem;color:rgba(255,255,255,.66);font-size:.78rem;font-weight:750;letter-spacing:.11em;text-transform:uppercase}.hero-proof span{display:inline-flex;align-items:center;gap:.55rem}.hero-proof span:before{content:'';width:7px;height:7px;border-radius:50%;background:var(--color-accent);box-shadow:0 0 14px rgba(202,164,79,.65)}.hero-brand{display:grid;place-items:center;align-content:center;text-align:center}.hero-brand img{position:relative;z-index:1;width:min(100%,330px);height:auto;filter:drop-shadow(0 26px 38px rgba(0,0,0,.38))}.hero-brand p{max-width:28ch;margin-top:1.6rem;color:rgba(235,242,248,.68);font-size:.92rem;line-height:1.6}.brand-halo{position:absolute;width:min(88%,380px);aspect-ratio:1;border:1px solid rgba(202,164,79,.26);border-radius:50%;box-shadow:inset 0 0 70px rgba(25,105,115,.13),0 0 100px rgba(25,105,115,.14)}.section-heading{display:grid;grid-template-columns:180px minmax(0,1fr);gap:1.5rem;align-items:start;margin-bottom:1.6rem}.section-heading h2,.method-intro h2,.academy-feature h2,.final-cta h2{margin:0;font-size:clamp(1.8rem,3vw,3.2rem);line-height:1.08}.section-heading p,.method-intro p,.academy-feature p,.final-cta p{max-width:760px;color:var(--color-text-soft)}.service-grid,.industry-grid,.insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.service-card{position:relative;min-height:260px;padding:1.45rem;transition:transform .2s ease,border-color .2s ease,background .2s ease}.service-card:hover{transform:translateY(-4px);border-color:rgba(202,164,79,.55);background:linear-gradient(155deg,rgba(14,38,63,.98),rgba(7,20,35,.98))}.service-code{display:inline-grid;place-items:center;width:46px;height:46px;margin-bottom:1.3rem;border:1px solid rgba(202,164,79,.45);border-radius:50%;color:var(--color-accent);font-size:.72rem;font-weight:850;letter-spacing:.08em}.service-card h3,.industry-card h3,.insight-card h3{margin:0 0 .7rem}.service-card p,.industry-card p,.insight-card p{color:var(--color-text-soft)}.service-card a{display:inline-block;margin-top:.4rem;color:var(--color-accent);font-weight:760;text-decoration:none}.industries-panel,.method-panel,.academy-feature,.final-cta{border:1px solid rgba(202,164,79,.22);border-radius:var(--radius-xl);background:linear-gradient(160deg,rgba(11,31,52,.93),rgba(5,15,28,.97));box-shadow:var(--shadow-panel)}.industries-panel,.method-panel{padding:clamp(1.4rem,4vw,3rem)}.industry-card{position:relative;display:block;min-height:220px;padding:1.35rem;border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-lg);background:rgba(255,255,255,.025);color:inherit;text-decoration:none;transition:border-color .2s ease,transform .2s ease}.industry-card:hover{transform:translateY(-3px);border-color:rgba(45,154,160,.55)}.industry-number{display:block;margin-bottom:2.4rem;color:var(--color-accent);font-size:.78rem;font-weight:800;letter-spacing:.13em}.method-panel{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(2rem,5vw,5rem);align-items:center}.method-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:0;padding:0;list-style:none}.method-steps li{display:flex;align-items:center;gap:.8rem;padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:var(--radius-md);background:rgba(255,255,255,.025);font-weight:760}.method-steps span{color:var(--color-accent);font-size:.72rem;letter-spacing:.08em}.academy-feature,.final-cta{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,3rem)}.insight-meta{display:flex;justify-content:space-between;gap:1rem;margin:0 0 1rem;color:var(--color-accent);font-size:.78rem;font-weight:760;letter-spacing:.08em;text-transform:uppercase}.final-cta{margin-bottom:0;border-color:rgba(202,164,79,.46);background:radial-gradient(circle at 85% 50%,rgba(32,123,130,.2),transparent 28%),linear-gradient(135deg,rgba(11,34,58,.98),rgba(5,16,29,.99))}@media(max-width:980px){.executive-hero,.method-panel{grid-template-columns:1fr}.hero-brand{display:none}.service-grid,.industry-grid,.insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.executive-hero{min-height:auto;padding:1.5rem}.hero-copy h1{font-size:clamp(2.45rem,13vw,4.2rem)}.section-heading{grid-template-columns:1fr;gap:.8rem}.service-grid,.industry-grid,.insight-grid,.method-steps{grid-template-columns:1fr}.academy-feature,.final-cta{align-items:flex-start;flex-direction:column}.hero-actions{width:100%}}
</style>
