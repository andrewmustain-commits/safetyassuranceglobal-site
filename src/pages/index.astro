---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved' || data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3)
  .map((post) => ({ slug: post.data.slug, title: post.data.title, summary: post.data.description, date: post.data.publishedAt, category: post.data.category }));

const engagements = [
  { href: '/services/operational-readiness', title: 'Operational Readiness Review', copy: 'Independent review of operational plans, controls, evidence, and open actions before critical work, transition, or startup.' },
  { href: '/services/contractor-assurance', title: 'Contractor & Supplier Assurance', copy: 'Focused oversight of contractor safety, quality, performance, and readiness from pre-mobilization through closeout.' },
  { href: '/services/qa-qc', title: 'Safety & Quality Verification', copy: 'Field verification and QA/QC review that connects requirements to observed conditions, records, findings, and decision-ready evidence.' },
  { href: '/method', title: 'Corrective-Action Closure & Validation', copy: 'Structured follow-through from finding and corrective action to independent closure validation and management reporting.' }
];
---

<BaseLayout title="Home" image="/images/brand/sag-social-share.svg" description="Safety Assurance Global provides maritime assurance, contractor and supplier assurance, safety and quality verification, operational readiness reviews, and corrective-action closure validation.">
  <div class="home-v34">
    <section class="hero-v34" aria-labelledby="home-hero-title">
      <img class="hero-scene" src="/images/brand/sag-maritime-hero-2026.jpeg" alt="Container vessel underway in a maritime operating environment" fetchpriority="high" decoding="async" />
      <div class="hero-overlay"></div>
      <Container class="hero-content">
        <div class="hero-copy">
          <p class="hero-eyebrow">Maritime assurance for safer, stronger, ready operations</p>
          <h1 id="home-hero-title">Know your operation is ready—<strong>before it matters.</strong></h1>
          <span class="hero-rule" aria-hidden="true"></span>
          <p>Safety Assurance Global independently reviews safety controls, contractor performance, quality processes, and operational plans. We identify gaps, prioritize corrective actions, and verify closure so leaders can make defensible readiness decisions.</p>
          <div class="hero-actions">
            <Button href="/contact">Discuss Your Requirement</Button>
            <Button href="#engagements" variant="secondary">See How SAG Helps</Button>
          </div>
          <p class="hero-support">Serving shipyards, ports and terminals, vessel operators, marine contractors, and government maritime programs.</p>
        </div>
      </Container>
    </section>

    <section class="trust-strip" aria-label="Safety Assurance Global trust signals">
      <Container class="trust-grid">
        <p><strong>Independent</strong><small>Objective assurance and verification</small></p>
        <p><strong>Evidence-led</strong><small>Requirements, findings, actions, closure</small></p>
        <p><strong>Maritime-first</strong><small>Ports, terminals, shipyards, vessels</small></p>
        <p><strong>Government-ready</strong><small>VOSB / SDVOSB · SBA VetCert</small></p>
      </Container>
    </section>

    <section id="engagements" class="engagements" aria-labelledby="engagements-title">
      <Container>
        <div class="light-heading"><p>How SAG Helps</p><h2 id="engagements-title">Four clear paths from uncertainty to verified readiness.</h2><span></span></div>
        <div class="engagement-grid">
          {engagements.map((engagement, index) => (
            <a href={engagement.href} class="engagement-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{engagement.title}</h3>
              <p>{engagement.copy}</p>
              <strong>Explore engagement →</strong>
            </a>
          ))}
        </div>
        <p class="service-depth">Need a broader scope? <a href="/services">View SAG’s full assurance and advisory capabilities.</a></p>
      </Container>
    </section>

    <Container class="lower-home">
      <Section class="maritime-panel" ariaLabelledby="maritime-title">
        <div><Badge text="Primary Market" /><h2 id="maritime-title">Built around high-consequence maritime operations.</h2><p>SAG supports ports, marine terminals, shipyards, vessel operations, marine contractors, and government maritime programs with independent assurance and readiness support.</p></div><Button href="/maritime" variant="secondary">Explore Maritime</Button>
      </Section>

      <Section class="method-panel-v34" ariaLabelledby="method-title">
        <div><Badge text="Our Evidence Standard" /><h2 id="method-title">A finding is not closed because someone says it is.</h2><p>SAG connects defined requirements, field evidence, findings, corrective actions, closure evidence, and management reporting. Conclusions are tied to what can be demonstrated and verified.</p></div>
        <ol>{['Define the requirement','Review the evidence','Verify in the field','Prioritize findings','Validate corrective action','Report decision-ready status'].map((step,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol>
        <Button href="/method" variant="secondary">See Our Method</Button>
      </Section>

      <Section class="institute-panel-v34" ariaLabelledby="institute-title">
        <div><Badge text="SAG Institute of Assurance" /><h2 id="institute-title">Build the workforce behind operational readiness.</h2><p>The Institute of Assurance is SAG’s learning and workforce-development division, supporting defined readiness pathways while keeping training and assurance responsibilities clear.</p></div><Button href="/institute" variant="secondary">Explore the Institute</Button>
      </Section>

      {approvedPosts.length > 0 && <Section ariaLabelledby="insights-title"><div class="insight-heading"><Badge text="Insights" /><h2 id="insights-title">Perspectives for leaders and operators.</h2></div><div class="insight-grid-v34">{approvedPosts.map((post)=><Card as="article"><p class="insight-meta"><span>{post.category}</span><time datetime={post.date.toISOString()}>{post.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></p><h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p></Card>)}</div></Section>}
    </Container>
  </div>
</BaseLayout>

<style>
:global(body:has(.home-v34) .site-main){padding-top:0}.home-v34{margin-top:0}.hero-v34{position:relative;min-height:560px;overflow:hidden;border-bottom:1px solid rgba(211,154,50,.55);background:#041424}.hero-scene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% 52%;filter:saturate(.92) contrast(1.04)}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,16,29,.99) 0%,rgba(3,16,29,.94) 32%,rgba(3,16,29,.69) 50%,rgba(3,16,29,.2) 76%,rgba(3,16,29,.08) 100%),linear-gradient(180deg,rgba(2,12,23,.05),rgba(2,12,23,.38))}.hero-content{position:relative;z-index:1;display:flex;align-items:center;min-height:560px}.hero-copy{max-width:680px;padding:3.35rem 0}.hero-eyebrow{margin:0 0 .7rem;color:#e3a43a!important;font-size:.78rem!important;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hero-copy h1{margin:0;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(2.45rem,4.8vw,4.75rem);line-height:1;letter-spacing:-.035em;text-shadow:0 2px 24px rgba(0,0,0,.3)}.hero-copy h1 strong{display:block;margin-top:.12em;color:#d8942c;font-weight:900}.hero-rule{display:block;width:84px;height:3px;margin:1.15rem 0;background:#d39a32}.hero-copy>p:not(.hero-eyebrow):not(.hero-support){max-width:650px;margin:0;color:#eef3f8;font-size:clamp(1rem,1.35vw,1.13rem);line-height:1.65;text-shadow:0 1px 12px rgba(0,0,0,.34)}.hero-actions{display:flex;flex-wrap:wrap;gap:.85rem;margin-top:1.45rem}.hero-actions :global(.ui-button){min-height:3.05rem}.hero-support{max-width:650px;margin:1.25rem 0 0!important;color:#cdd7e2!important;font-size:.83rem!important;line-height:1.5!important}.trust-strip{background:#061a2d;border-bottom:1px solid rgba(211,154,50,.28)}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding-top:.9rem;padding-bottom:.9rem}.trust-grid p{display:grid;gap:.1rem;margin:0;padding:.1rem 1rem;border-right:1px solid rgba(211,154,50,.25)}.trust-grid p:last-child{border-right:0}.trust-grid strong{color:#fff;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}.trust-grid small{color:#c7d0db;font-size:.67rem;line-height:1.35}.engagements{padding:2.8rem 0 3rem;background:#fafafa;color:#07192a;border-bottom:1px solid #e5e7eb}.light-heading{text-align:center}.light-heading>p{margin:0;color:#b8791d;font-size:.73rem;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.light-heading h2{max-width:820px;margin:.42rem auto 0;color:#07192a;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:clamp(1.55rem,2.8vw,2.35rem);line-height:1.13}.light-heading span{display:block;width:78px;height:2px;margin:.85rem auto 1.6rem;background:#d39a32}.engagement-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem}.engagement-card{display:flex;flex-direction:column;min-height:260px;padding:1.25rem;border:1px solid #dfe4e9;border-radius:.35rem;background:#fff;color:#07192a;text-decoration:none;box-shadow:0 7px 20px rgba(7,25,42,.08);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.engagement-card:hover,.engagement-card:focus-visible{transform:translateY(-3px);border-color:#d39a32;box-shadow:0 12px 28px rgba(7,25,42,.13)}.engagement-card>span{color:#b8791d;font-size:.7rem;font-weight:900;letter-spacing:.12em}.engagement-card h3{margin:.7rem 0;color:#07192a;font-family:Montserrat,Inter,system-ui,sans-serif;font-size:1rem;line-height:1.25}.engagement-card p{flex:1;margin:0;color:#3d4854;font-size:.83rem;line-height:1.55}.engagement-card strong{margin-top:1rem;color:#0a4272;font-size:.76rem}.service-depth{margin:1.35rem 0 0;text-align:center;color:#4b5563;font-size:.84rem}.service-depth a{color:#0a4a80;font-weight:800}.lower-home{padding-top:1.1rem}.maritime-panel,.method-panel-v34,.institute-panel-v34{display:grid;grid-template-columns:1fr auto;gap:1.4rem;align-items:center}.method-panel-v34 ol{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;list-style:none;margin:.5rem 0 0;padding:0}.method-panel-v34 li{display:flex;gap:.65rem;align-items:center;padding:.7rem;border:1px solid rgba(148,163,184,.18);border-radius:.6rem;background:rgba(15,23,42,.62);color:#e7edf5;font-size:.82rem}.method-panel-v34 li span{color:#f3aa35;font-weight:900}.insight-grid-v34{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.insight-heading{margin-bottom:1rem}.insight-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.74rem}.insight-meta span{color:#f59e0b;text-transform:uppercase;font-weight:800}.insight-meta time{color:#94a3b8}.insight-grid-v34 h3 a{color:#fff;text-decoration:none}@media(max-width:900px){.engagement-grid{grid-template-columns:repeat(2,1fr)}.trust-grid{grid-template-columns:repeat(2,1fr)}.trust-grid p:nth-child(2){border-right:0}.method-panel-v34 ol{grid-template-columns:repeat(2,1fr)}.hero-scene{object-position:62% 52%}}@media(max-width:640px){.hero-v34,.hero-content{min-height:610px}.hero-copy{padding:2.45rem 0}.hero-copy h1{font-size:clamp(2.15rem,11vw,3.2rem)}.hero-scene{object-position:64% center}.hero-overlay{background:linear-gradient(90deg,rgba(3,16,29,.94),rgba(3,16,29,.7)),linear-gradient(180deg,rgba(3,16,29,.12),rgba(3,16,29,.66))}.hero-actions{display:grid}.hero-actions :global(.ui-button){width:100%}.trust-grid,.engagement-grid,.method-panel-v34 ol,.insight-grid-v34{grid-template-columns:1fr}.trust-grid p{border-right:0;border-bottom:1px solid rgba(211,154,50,.2);padding:.55rem .2rem}.trust-grid p:last-child{border-bottom:0}.engagement-card{min-height:0}.maritime-panel,.method-panel-v34,.institute-panel-v34{grid-template-columns:1fr}.method-panel-v34 ol{grid-column:auto}}
</style>
