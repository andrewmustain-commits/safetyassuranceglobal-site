---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved' || data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3)
  .map((post) => ({ slug: post.data.slug, title: post.data.title, summary: post.data.description, date: post.data.publishedAt, category: post.data.category }));

const services = [
  ['SA','Safety Assurance','Independent safety assurance, field verification, and control review for complex operating environments.'],
  ['RM','Risk Management','Risk assessment, control review, and decision support tied to defined requirements and evidence.'],
  ['QC','QA / QC Services','Quality assurance and quality-control oversight that links requirements, work, findings, and closure evidence.'],
  ['CA','Contractor Assurance','Contractor safety, quality, performance, and readiness oversight from pre-mobilization through closeout.'],
  ['OR','Operational Readiness','Readiness reviews, exercises, evidence checks, and closure validation before critical operations or transition.']
];
---

<BaseLayout title="Home" description="Safety Assurance Global provides maritime-first independent assurance, operational readiness, QA/QC, contractor assurance, safety governance, and evidence-based risk support.">
  <div class="home-v20">
    <section class="hero-v20" aria-labelledby="home-hero-title">
      <img class="hero-scene" src="/images/brand/maritime-hero-v20.svg" alt="Stylized maritime terminal and vessel at night" />
      <div class="hero-overlay"></div>
      <Container class="hero-content">
        <div class="hero-copy">
          <p class="hero-eyebrow">Maritime-First Independent Assurance</p>
          <h1 id="home-hero-title"><span>Independent Assurance.</span><strong>Proven Readiness.</strong></h1>
          <p>Safety Assurance Global delivers independent assurance, safety, risk, QA/QC, contractor-assurance, and operational-readiness support designed to help organizations strengthen execution, evidence, and decision confidence.</p>
          <div class="hero-actions"><Button href="/services">Our Services</Button><Button href="/request-proposal" variant="secondary">Request Proposal</Button></div>
        </div>
      </Container>
    </section>

    <section class="trust-strip" aria-label="Safety Assurance Global trust signals">
      <Container class="trust-grid">
        <div><span class="trust-icon">◇</span><p><strong>SDVOSB / VOSB</strong><small>SBA VetCert status published from approved corporate data.</small></p></div>
        <div><span class="trust-icon">▦</span><p><strong>Government & Public Infrastructure</strong><small>Defined-scope support for public-sector operating environments.</small></p></div>
        <div><span class="trust-icon">✓</span><p><strong>Independent Assurance</strong><small>Requirements-first, evidence-bound, and human-authority preserved.</small></p></div>
        <div><span class="trust-icon">✦</span><p><strong>Operational Excellence</strong><small>Safety. Quality. Readiness. Evidence-based closeout.</small></p></div>
      </Container>
    </section>

    <section class="services-light" aria-labelledby="services-title">
      <Container>
        <div class="light-heading"><p>What We Do</p><h2 id="services-title">Assurance Solutions That Drive Safe, Compliant, and Reliable Operations</h2><span></span></div>
        <div class="service-grid-v20">
          {services.map(([code,title,description]) => <a href="/services" class="service-tile"><span>{code}</span><div><h3>{title}</h3><p>{description}</p></div></a>)}
        </div>
      </Container>
    </section>

    <Container class="lower-home">
      <Section class="maritime-panel" ariaLabelledby="maritime-title">
        <div><Badge text="Primary Market" /><h2 id="maritime-title">Maritime assurance is the lead market.</h2><p>SAG supports ports, marine terminals, shipyards, vessel operations, and marine contractors through defined assurance, readiness, safety, quality, risk, and contractor-oversight scopes.</p></div><Button href="/maritime" variant="secondary">Explore Maritime</Button>
      </Section>

      <Section class="method-panel-v20" ariaLabelledby="method-title">
        <div><Badge text="The SAG Assurance Method" /><h2 id="method-title">Requirements to evidence. Findings to closure.</h2><p>Our delivery model connects requirements intake, control crosswalks, field verification, corrective action, closure validation, and management reporting.</p></div>
        <ol>{['Requirements Intake','Control Crosswalk','Field Verification','Corrective Action','Closure Validation','Management Reporting'].map((step,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol>
      </Section>

      <Section class="institute-panel-v20" ariaLabelledby="institute-title">
        <div><Badge text="SAG Institute of Assurance" /><h2 id="institute-title">Governed learning and workforce development.</h2><p>The Institute supports readiness-focused learning pathways across maritime and other defined sectors. Availability, credential status, and external recognition are stated only when verified.</p></div><Button href="/institute" variant="secondary">Explore the Institute</Button>
      </Section>

      {approvedPosts.length > 0 && <Section ariaLabelledby="insights-title"><div class="insight-heading"><Badge text="Insights" /><h2 id="insights-title">Approved perspectives for leaders and operators.</h2></div><div class="insight-grid-v20">{approvedPosts.map((post)=><Card as="article"><p class="insight-meta"><span>{post.category}</span><time datetime={post.date.toISOString()}>{post.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></p><h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p></Card>)}</div></Section>}
    </Container>
  </div>
</BaseLayout>

<style>
.home-v20{margin-top:0}.hero-v20{position:relative;min-height:540px;overflow:hidden;border-bottom:1px solid rgba(211,154,50,.55);background:#041424}.hero-scene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,16,29,.98) 0%,rgba(3,16,29,.92) 32%,rgba(3,16,29,.45) 62%,rgba(3,16,29,.08) 100%)}.hero-content{position:relative;z-index:1;display:flex;align-items:center;min-height:540px}.hero-copy{max-width:680px;padding:3.7rem 0}.hero-eyebrow{margin:0 0 1rem;color:#d39a32;font-size:.78rem;font-weight:850;letter-spacing:.18em;text-transform:uppercase}.hero-copy h1{margin:0;font-size:clamp(2.65rem,5.3vw,5.4rem);line-height:.98;letter-spacing:-.035em;text-transform:uppercase}.hero-copy h1 span,.hero-copy h1 strong{display:block}.hero-copy h1 strong{margin-top:.25rem;color:#d8942c;font-weight:900}.hero-copy>p:not(.hero-eyebrow){max-width:640px;margin-top:1.45rem;color:#eef3f8;font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.68}.hero-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.65rem}.trust-strip{background:#061a2d;border-bottom:1px solid rgba(211,154,50,.28)}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding-top:1rem;padding-bottom:1rem}.trust-grid>div{display:flex;gap:.8rem;align-items:center;padding:.25rem 1.2rem;border-right:1px solid rgba(211,154,50,.28)}.trust-grid>div:last-child{border-right:0}.trust-icon{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border:2px solid #d39a32;color:#e1a942;font-size:1.15rem}.trust-grid p{display:grid;gap:.18rem;margin:0}.trust-grid strong{color:#fff;font-size:.8rem;text-transform:uppercase;letter-spacing:.04em}.trust-grid small{color:#c3cbd4;font-size:.68rem;line-height:1.35}.services-light{padding:clamp(3rem,5vw,5rem) 0;background:#f7f8fa;color:#07192a}.light-heading{text-align:center}.light-heading>p{margin:0;color:#c98a25;font-weight:850;letter-spacing:.22em;text-transform:uppercase}.light-heading h2{max-width:1000px;margin:.5rem auto 0;color:#07192a;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.12}.light-heading span{display:block;width:105px;height:3px;margin:1rem auto 2rem;background:#d39a32}.service-grid-v20{display:grid;grid-template-columns:repeat(5,1fr);gap:.75rem}.service-tile{display:flex;gap:.85rem;min-height:190px;padding:1.3rem;border:1px solid #e2e5e9;background:#fff;color:#0a1930;text-decoration:none;box-shadow:0 8px 20px rgba(7,25,42,.08);transition:transform .2s ease,border-color .2s ease}.service-tile:hover,.service-tile:focus-visible{transform:translateY(-3px);border-color:#d39a32}.service-tile>span{display:grid;place-items:center;width:46px;height:46px;flex:0 0 46px;border:2px solid #0a2745;color:#0a2745;font-weight:900}.service-tile h3{margin:0 0 .55rem;font-size:.87rem;text-transform:uppercase}.service-tile p{margin:0;color:#3d4754;font-size:.82rem;line-height:1.5}.lower-home{display:grid;gap:1.5rem;padding-top:2rem;padding-bottom:2rem}.maritime-panel,.institute-panel-v20{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid rgba(211,154,50,.35);border-radius:1rem;background:linear-gradient(135deg,#071b2f,#0c2c48)}.maritime-panel h2,.method-panel-v20 h2,.institute-panel-v20 h2,.insight-heading h2{margin:.7rem 0 0;font-size:clamp(1.8rem,3vw,3rem)}.maritime-panel p,.method-panel-v20 p,.institute-panel-v20 p{max-width:760px;color:#c9d2dc}.method-panel-v20{display:grid;grid-template-columns:.85fr 1.15fr;gap:3rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid rgba(211,154,50,.25);border-radius:1rem;background:#061a2d}.method-panel-v20 ol{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;margin:0;padding:0;list-style:none}.method-panel-v20 li{display:flex;align-items:center;gap:.7rem;padding:.9rem;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.025);font-weight:760}.method-panel-v20 li span{color:#d39a32;font-size:.72rem}.insight-heading{margin-bottom:1rem}.insight-grid-v20{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.insight-meta{display:flex;justify-content:space-between;gap:1rem;color:#d39a32;font-size:.72rem;text-transform:uppercase}
@media(max-width:1050px){.service-grid-v20{grid-template-columns:repeat(2,1fr)}.trust-grid{grid-template-columns:repeat(2,1fr)}.trust-grid>div:nth-child(2){border-right:0}.method-panel-v20{grid-template-columns:1fr}.insight-grid-v20{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.hero-v20,.hero-content{min-height:500px}.hero-overlay{background:linear-gradient(90deg,rgba(3,16,29,.96),rgba(3,16,29,.72))}.hero-copy{padding:2.5rem 0}.trust-grid,.service-grid-v20,.method-panel-v20 ol,.insight-grid-v20{grid-template-columns:1fr}.trust-grid>div{border-right:0;border-bottom:1px solid rgba(211,154,50,.2)}.trust-grid>div:last-child{border-bottom:0}.maritime-panel,.institute-panel-v20{align-items:flex-start;flex-direction:column}.service-tile{min-height:auto}}
</style>
