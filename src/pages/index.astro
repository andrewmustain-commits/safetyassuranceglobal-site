---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved' || data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3)
  .map((post) => ({ slug: post.data.slug, title: post.data.title, summary: post.data.description, date: post.data.publishedAt, category: post.data.category }));
---

<BaseLayout title="Independent Assurance & Maritime Operational Readiness" description="Safety Assurance Global provides maritime-first independent assurance, operational readiness, QA/QC, contractor assurance, safety governance, and evidence-based risk support.">
  <div class="home-v25">
    <section class="hero-v25" aria-labelledby="home-hero-title">
      <img class="hero-scene" src="/images/brand/maritime-hero-v20.svg" alt="Stylized maritime terminal and vessel at night" />
      <div class="hero-overlay"></div>
      <Container class="hero-content">
        <div class="hero-copy">
          <h1 id="home-hero-title"><span>Independent Assurance.</span><strong>Proven Readiness.</strong></h1>
          <span class="hero-rule" aria-hidden="true"></span>
          <p>Safety Assurance Global delivers independent assurance, safety, risk, QA/QC, contractor-assurance, and operational-readiness support designed to help organizations strengthen control, evidence, readiness, and decision confidence.</p>
          <div class="hero-actions">
            <Button href="/services">Our Services</Button>
            <Button href="/request-proposal" variant="secondary">Request Proposal</Button>
          </div>
        </div>
      </Container>
    </section>

    <section class="trust-strip" aria-label="Safety Assurance Global trust signals">
      <Container class="trust-grid">
        <div><strong>VOSB / SDVOSB</strong><span>SBA VetCert verified</span></div>
        <div><strong>Government & Public Sector</strong><span>Procurement-ready support</span></div>
        <div><strong>Independent Assurance</strong><span>Impartial. Objective. Defensible.</span></div>
        <div><strong>Operational Excellence</strong><span>Safety. Quality. Readiness.</span></div>
      </Container>
    </section>

    <Section ariaLabelledby="what-title" class="what-section">
      <Container>
        <div class="section-heading centered-heading">
          <Badge>What We Do</Badge>
          <h2 id="what-title">Assurance that strengthens operations.</h2>
          <p>We help organizations understand risk, verify controls, improve contractor performance, and demonstrate operational readiness through disciplined independent assurance.</p>
        </div>
        <div class="focus-grid">
          <a class="focus-card" href="/maritime" aria-label="Explore Maritime Assurance services">
            <span class="focus-icon" aria-hidden="true">⚓</span><h3>Maritime Assurance</h3><p>Independent support for ports, terminals, shipyards, vessels, and maritime contractors.</p>
          </a>
          <a class="focus-card" href="/services/safety-risk-governance" aria-label="Explore Safety and Risk Governance services">
            <span class="focus-icon" aria-hidden="true">◇</span><h3>Safety & Risk Governance</h3><p>Governance, risk review, control verification, and decision support for high-consequence operations.</p>
          </a>
          <a class="focus-card" href="/services/quality-assurance-qaqc" aria-label="Explore QA/QC and Quality Oversight services">
            <span class="focus-icon" aria-hidden="true">✓</span><h3>QA/QC & Quality Oversight</h3><p>Independent quality assurance, surveillance, evidence review, and corrective-action support.</p>
          </a>
          <a class="focus-card" href="/services/contractor-assurance" aria-label="Explore Contractor Assurance services">
            <span class="focus-icon" aria-hidden="true">▣</span><h3>Contractor Assurance</h3><p>Risk-based oversight of contractor controls, field execution, interfaces, and evidence.</p>
          </a>
          <a class="focus-card" href="/services/operational-readiness" aria-label="Explore Operational Readiness services">
            <span class="focus-icon" aria-hidden="true">↗</span><h3>Operational Readiness</h3><p>Structured readiness reviews before startup, turnover, mobilization, or critical operations.</p>
          </a>
        </div>
      </Container>
    </Section>

    <section class="maritime-band" aria-labelledby="maritime-band-title">
      <Container class="maritime-band-grid">
        <div>
          <Badge>Primary Market</Badge>
          <h2 id="maritime-band-title">Maritime operations demand evidence, not assumptions.</h2>
          <p>Safety Assurance Global supports ports, terminals, shipyards, vessel operators, and contractors with independent assurance focused on control effectiveness, operational readiness, safety, quality, and defensible evidence.</p>
          <div class="hero-actions"><Button href="/maritime">Explore Maritime Assurance</Button><Button href="/contact" variant="secondary">Talk With SAG</Button></div>
        </div>
        <div class="readiness-panel">
          <span>Independent Review</span><strong>Controls → Evidence → Readiness</strong>
          <p>Designed for organizations operating where weak interfaces, incomplete evidence, or unverified controls can create significant operational exposure.</p>
        </div>
      </Container>
    </section>

    <Section ariaLabelledby="method-title">
      <Container>
        <div class="section-heading">
          <Badge>How We Work</Badge>
          <h2 id="method-title">The SAG Assurance Method.</h2>
          <p>A repeatable approach for turning uncertainty into documented, decision-ready assurance.</p>
        </div>
        <div class="method-grid">
          <div><span>01</span><h3>Define</h3><p>Clarify scope, obligations, interfaces, and assurance objectives.</p></div>
          <div><span>02</span><h3>Assess</h3><p>Evaluate risks, controls, evidence, and operating conditions.</p></div>
          <div><span>03</span><h3>Verify</h3><p>Test whether controls and evidence support the required conclusion.</p></div>
          <div><span>04</span><h3>Assure</h3><p>Deliver clear findings, actions, and decision-ready assurance outputs.</p></div>
        </div>
        <div class="method-link"><Button href="/method" variant="secondary">View Our Method</Button></div>
      </Container>
    </Section>

    <section class="institute-band" aria-labelledby="institute-band-title">
      <Container class="institute-grid">
        <div><Badge>Institute of Assurance</Badge><h2 id="institute-band-title">Build workforce capability around the same assurance principles.</h2><p>The Safety Assurance Global Institute of Assurance provides governed learning and workforce-development pathways that complement SAG's assurance and readiness mission.</p></div>
        <Button href="/institute">Explore the Institute</Button>
      </Container>
    </section>

    {approvedPosts.length > 0 && (
      <Section ariaLabelledby="insights-title">
        <Container>
          <div class="section-heading"><Badge>Insights</Badge><h2 id="insights-title">Current thinking from Safety Assurance Global.</h2></div>
          <div class="insights-grid">
            {approvedPosts.map((post) => <Card><p class="insight-meta">{post.category} · {post.date.toLocaleDateString('en-US')}</p><h3>{post.title}</h3><p>{post.summary}</p><a href={`/insights/${post.slug}`}>Read insight →</a></Card>)}
          </div>
        </Container>
      </Section>
    )}
  </div>
</BaseLayout>

<style>
  .home-v25 { margin-top:calc(var(--space-4) * -1); }
  .hero-v25 { min-height:clamp(620px,78vh,820px); position:relative; display:flex; align-items:center; overflow:hidden; background:#071427; }
  .hero-scene { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(5,15,31,.96) 0%,rgba(7,21,41,.82) 38%,rgba(7,21,41,.28) 70%,rgba(7,21,41,.12) 100%); }
  .hero-content { position:relative; z-index:2; width:100%; }
  .hero-copy { max-width:760px; padding:7rem 0 6rem; }
  .hero-copy h1 { margin:0; text-transform:uppercase; letter-spacing:-.035em; font-size:clamp(3rem,6.1vw,6.4rem); line-height:.91; }
  .hero-copy h1 span,.hero-copy h1 strong { display:block; }
  .hero-copy h1 span { color:#fff; font-weight:760; }
  .hero-copy h1 strong { color:#e7aa42; font-weight:820; }
  .hero-rule { display:block; width:82px; height:4px; background:#e7aa42; margin:2rem 0 1.5rem; }
  .hero-copy p { color:#d5deeb; max-width:680px; font-size:1.12rem; line-height:1.75; }
  .hero-actions { display:flex; gap:.85rem; flex-wrap:wrap; margin-top:1.8rem; }
  .trust-strip { background:#f5f7fa; color:#14233a; border-bottom:1px solid #dfe5ec; }
  .trust-grid { display:grid; grid-template-columns:repeat(4,1fr); }
  .trust-grid div { padding:1.4rem 1.3rem; text-align:center; border-right:1px solid #dce3eb; }
  .trust-grid div:last-child { border-right:0; }
  .trust-grid strong,.trust-grid span { display:block; }
  .trust-grid strong { font-size:.9rem; color:#102039; }
  .trust-grid span { margin-top:.25rem; font-size:.78rem; color:#6b7687; }
  .what-section { background:#fff; color:#17233a; }
  .section-heading { max-width:780px; margin-bottom:2.2rem; }
  .section-heading h2 { color:inherit; margin:.65rem 0 .75rem; font-size:clamp(2rem,4vw,3.35rem); }
  .section-heading p { color:#687486; font-size:1.03rem; line-height:1.7; }
  .centered-heading { text-align:center; margin-left:auto; margin-right:auto; }
  .focus-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:1rem; }
  .focus-card { text-align:center; padding:2rem 1.1rem; border:1px solid #e2e7ed; background:#fff; box-shadow:0 10px 28px rgba(14,30,56,.05); color:inherit; text-decoration:none; transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease; }
  .focus-card:hover,.focus-card:focus-visible { transform:translateY(-3px); border-color:#d7a34b; box-shadow:0 14px 32px rgba(14,30,56,.1); }
  .focus-card h3 { color:#14233b; font-size:1rem; }
  .focus-card p { color:#707b8b; font-size:.88rem; line-height:1.55; }
  .focus-icon { width:46px; height:46px; display:grid; place-items:center; margin:0 auto 1rem; border:1px solid #d7a34b; color:#c78b2e; border-radius:50%; font-size:1.15rem; }
  .maritime-band { padding:5.5rem 0; background:#0b1a31; border-top:1px solid rgba(229,169,60,.24); border-bottom:1px solid rgba(229,169,60,.24); }
  .maritime-band-grid { display:grid; grid-template-columns:1.35fr .8fr; gap:4rem; align-items:center; }
  .maritime-band h2,.institute-band h2 { font-size:clamp(2rem,4vw,3.35rem); margin:.7rem 0 1rem; }
  .maritime-band p,.institute-band p { color:#b8c4d5; line-height:1.75; }
  .readiness-panel { border:1px solid rgba(229,169,60,.38); padding:2rem; background:rgba(255,255,255,.035); }
  .readiness-panel span,.readiness-panel strong { display:block; }
  .readiness-panel span { color:#e5a93c; text-transform:uppercase; letter-spacing:.1em; font-size:.72rem; }
  .readiness-panel strong { margin:.65rem 0 1rem; font-size:1.35rem; color:#fff; }
  .method-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
  .method-grid div { padding:1.8rem; border-top:2px solid #d7a34b; background:rgba(255,255,255,.035); }
  .method-grid span { color:#d7a34b; font-size:.78rem; letter-spacing:.1em; }
  .method-grid h3 { margin:.65rem 0; }
  .method-grid p { color:var(--color-text-muted); }
  .method-link { margin-top:2rem; }
  .institute-band { background:#0e1e38; padding:4.6rem 0; }
  .institute-grid { display:grid; grid-template-columns:1fr auto; gap:3rem; align-items:center; }
  .institute-grid > div { max-width:760px; }
  .insights-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
  .insight-meta { color:#d7a34b; text-transform:uppercase; letter-spacing:.08em; font-size:.72rem; }
  @media (max-width:1050px) { .focus-grid { grid-template-columns:repeat(3,1fr); } .trust-grid { grid-template-columns:repeat(2,1fr); } .trust-grid div:nth-child(2) { border-right:0; } }
  @media (max-width:760px) { .hero-v25 { min-height:600px; } .hero-copy { padding:5.5rem 0 4rem; } .hero-overlay { background:linear-gradient(90deg,rgba(5,15,31,.95),rgba(7,21,41,.7)); } .trust-grid,.focus-grid,.method-grid,.insights-grid,.maritime-band-grid,.institute-grid { grid-template-columns:1fr; } .trust-grid div { border-right:0; border-bottom:1px solid #dce3eb; } .maritime-band-grid { gap:2rem; } }
</style>
