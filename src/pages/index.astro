---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import NoticePanel from '../components/ui/NoticePanel.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import CTASection from '../components/ui/CTASection.astro';

const publishedPosts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2)
  .map((post) => ({
    slug: post.data.slug,
    title: post.data.title,
    description: post.data.description,
    publishedAt: post.data.publishedAt,
    category: post.data.category
  }));

const audiences = [
  'Shipyards',
  'Ports and marine terminals',
  'Vessel operators',
  'Marine contractors',
  'Government organizations',
  'Critical-infrastructure leaders'
];

const problems = [
  'Readiness is assumed, but evidence is fragmented across teams and contractors.',
  'Safety, QA/QC, compliance, and risk controls are not consistently verified in operations.',
  'Leadership needs independent visibility into what is working, what is missing, and what to prioritize next.'
];

const services = [
  'Operational-readiness assessments',
  'Independent assurance and evidence review',
  'Safety and risk-management support',
  'QA/QC and contractor assurance',
  'Compliance-readiness support',
  'Incident investigation and corrective-action support'
];

const lifecycle = ['Discover', 'Assess', 'Verify', 'Prioritize', 'Improve', 'Validate', 'Assure', 'Sustain'];

const deliverables = [
  'Assurance Case',
  'Evidence Package',
  'Readiness Score',
  'Corrective-Action Roadmap',
  'Validation Report',
  'Closeout Report'
];
---

<BaseLayout
  title="Home"
  description="Safety Assurance Global is a maritime and critical-infrastructure consulting, operational-readiness, safety, risk-management, QA/QC, compliance, and independent-assurance company that also provides workforce training."
>
  <Container>
    <HeroSection
      id="home-hero-title"
      badge="Independent Assurance for Maritime and Critical Infrastructure"
      title="Turn operational risk into verified readiness."
    >
      <p>
        Safety Assurance Global helps shipyards, ports, vessel operators, contractors, government organizations,
        and critical-infrastructure leaders assess risk, strengthen controls, verify evidence, and improve
        operational readiness.
      </p>
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/maritime" variant="secondary">Explore Maritime Services</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="home-audience-title">
      <SectionHeader
        badge="Who We Serve"
        id="home-audience-title"
        title="Operating teams responsible for high-consequence work."
      />
      <div class="grid-three">
        {audiences.map((audience) => (
          <Card>
            <h3>{audience}</h3>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="home-problems-title">
      <SectionHeader
        badge="Problems We Solve"
        id="home-problems-title"
        title="Common readiness and assurance gaps we help address."
      />
      <div class="grid-three">
        {problems.map((problem) => (
          <Card>
            <p>{problem}</p>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="home-services-title">
      <SectionHeader
        badge="Core Services"
        id="home-services-title"
        title="Consulting and assurance services aligned to operational outcomes."
      />
      <div class="grid-three">
        {services.map((service) => (
          <Card>
            <h3>{service}</h3>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="home-maritime-title">
      <SectionHeader
        badge="Maritime Focus"
        id="home-maritime-title"
        title="Maritime-first execution with support for critical infrastructure."
      />
      <div class="grid-two">
        <Card>
          <h3>Maritime market pathways</h3>
          <p>
            Dedicated pathways for shipyards, ports and marine terminals, vessel operators, marine contractors,
            government maritime programs, and workforce training buyers.
          </p>
        </Card>
        <Card>
          <h3>Why this matters</h3>
          <p>
            Maritime operations often depend on contractor coordination, field quality controls, and
            readiness verification under time pressure.
          </p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="home-lifecycle-title">
      <SectionHeader
        badge="Assurance Lifecycle"
        id="home-lifecycle-title"
        title="A staged method from discovery through sustained control."
      />
      <div class="grid-four">
        {lifecycle.map((step) => (
          <Card>
            <h3>{step}</h3>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="home-deliverables-title">
      <SectionHeader
        badge="Typical Deliverables"
        id="home-deliverables-title"
        title="Outputs designed for decisions, oversight, and execution follow-through."
      />
      <div class="grid-three">
        {deliverables.map((deliverable) => (
          <Card>
            <h3>{deliverable}</h3>
          </Card>
        ))}
      </div>
    </Section>

    <Section ariaLabelledby="home-training-title">
      <SectionHeader
        badge="Training Support"
        id="home-training-title"
        title="Workforce training supports consulting and assurance delivery."
      />
      <div class="grid-two">
        <Card>
          <h3>Training as a supporting capability</h3>
          <p>
            Training is presented as part of workforce readiness support and does not replace consulting,
            independent assurance, or operational governance.
          </p>
        </Card>
        <Card>
          <h3>Controlled delivery model</h3>
          <p>
            Delivery format and availability are confirmed through inquiry and scope review, with conservative
            status controls for each program area.
          </p>
          <p><a href="/maritime-training">Review maritime training details</a>.</p>
        </Card>
      </div>
    </Section>

    <Section ariaLabelledby="home-government-title">
      <SectionHeader
        badge="Government and Prime Contractor Support"
        id="home-government-title"
        title="Conservative, evidence-based support posture for public-sector work."
      />
      <NoticePanel tone="info" title="Qualification Notice" class="qualification-notice">
        <p>
          Government-facing language is limited to supported capabilities. Public content does not imply agency
          endorsement, contract award, or regulatory authority.
        </p>
      </NoticePanel>
    </Section>

    <Section ariaLabelledby="home-evidence-title">
      <SectionHeader
        badge="Representative Evidence"
        id="home-evidence-title"
        title="What engagements typically review and produce."
      />
      <div class="grid-two">
        <Card class="evidence-panel">
          <h3>Evidence reviewed</h3>
          <ul>
            <li>Operational procedures and controls</li>
            <li>Training and competency records</li>
            <li>QA/QC and contractor oversight artifacts</li>
            <li>Readiness and incident-response documentation</li>
          </ul>
        </Card>
        <Card class="trust-panel">
          <h3>Evidence produced</h3>
          <ul>
            <li>Assurance findings and gap analysis</li>
            <li>Prioritized corrective-action roadmap</li>
            <li>Validation and closeout reporting</li>
          </ul>
        </Card>
      </div>
    </Section>

    {publishedPosts.length > 0 && (
      <Section ariaLabelledby="home-insights-title">
        <SectionHeader
          badge="Insights"
          id="home-insights-title"
          title="Recent published insights."
        />
        <div class="grid-two">
          {publishedPosts.map((post) => (
            <Card as="article">
              <p class="insight-meta">
                <span>{post.category}</span>
                {' · '}
                <time datetime={post.publishedAt.toISOString()}>{post.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
              </p>
              <h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3>
              <p>{post.description}</p>
            </Card>
          ))}
        </div>
      </Section>
    )}

    <CTASection
      id="home-final-cta-title"
      badge="Next Step"
      title="Start with a focused readiness and assurance discussion."
      intro="We will confirm scope, evidence expectations, and delivery options before engagement."
    >
      <div class="ui-actions">
        <Button href="/contact">Request a Consultation</Button>
        <Button href="/request-proposal" variant="secondary">Request a Proposal</Button>
      </div>
    </CTASection>
  </Container>
</BaseLayout>

<style>
  .insight-meta {
    margin: 0 0 0.6rem;
    color: var(--color-text-soft);
    font-size: 0.84rem;
  }
</style>
