---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ContactInquiryForm from '../components/forms/ContactInquiryForm.astro';
---

<BaseLayout title="Contact" description="Contact Safety Assurance Global to request a consultation or start a controlled inquiry.">
  <Container>
    <HeroSection id="contact-title" badge="Contact" title="Request a Consultation">
      <p>Use this page for consultation and teaming inquiries through the governed intake path.</p>
      <div class="ui-actions">
        <Button href="/request-proposal">Request a Proposal</Button>
        <Button href="mailto:contact@safetyassuranceglobal.com" variant="secondary">Email the team</Button>
      </div>
    </HeroSection>

    <Section ariaLabelledby="contact-form-title">
      <ContactInquiryForm />
    </Section>

    <Section ariaLabelledby="details-title">
      <SectionHeader id="details-title" badge="Contact Details" title="Reach the right team." />
      <div class="details-grid">
        <Card>
          <h3>General inquiries</h3>
          <p><a href="mailto:contact@safetyassuranceglobal.com">contact@safetyassuranceglobal.com</a></p>
        </Card>
        <Card>
          <h3>Proposal requests</h3>
          <p><a href="/request-proposal">Request a proposal workflow</a></p>
        </Card>
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
  .details-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>