---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import LeadForm from '../components/forms/LeadForm.astro';

const serviceOptions = [
  { value: 'maritime-compliance-readiness', label: 'Maritime compliance readiness' },
  { value: 'operational-readiness', label: 'Operational readiness assessments' },
  { value: 'qa-qc-contractor-assurance', label: 'QA/QC and contractor assurance' },
  { value: 'safety-risk-management', label: 'Safety and risk management' },
  { value: 'training', label: 'Training' },
  { value: 'other', label: 'Other' }
];

const timeframeOptions = [
  { value: 'immediate', label: 'Immediate' },
  { value: '1-2-weeks', label: '1-2 weeks' },
  { value: 'within-month', label: 'Within a month' },
  { value: 'exploring', label: 'Exploring options' }
];
---

<BaseLayout title="Contact" description="Contact Safety Assurance Global to request a consultation or start a controlled inquiry.">
  <Container>
    <Section class="contact-hero" ariaLabelledby="contact-title">
      <Badge text="Contact" />
      <h1 id="contact-title">Request a Consultation</h1>
      <p>Use this page for controlled inquiry intake. The form is frontend-only until a safe backend integration is approved.</p>
      <div class="hero-actions">
        <Button href="/request-proposal">Request a Proposal</Button>
        <Button href="mailto:contact@safetyassuranceglobal.com" variant="secondary">Email the team</Button>
      </div>
    </Section>

    <Section ariaLabelledby="contact-lead-title">
      <LeadForm
        id="contact-lead"
        title="Inquiry form"
        description="Fields support accessible validation, a hidden honeypot, and a neutral pre-launch status message rather than a false success response."
        submitLabel="Submit Inquiry"
        serviceOptions={serviceOptions}
        timeframeOptions={timeframeOptions}
      />
    </Section>

    <Section ariaLabelledby="details-title">
      <div class="section-head">
        <Badge text="Contact Details" />
        <h2 id="details-title">Reach the right team.</h2>
      </div>
      <div class="details-grid">
        <Card>
          <h3>General inquiries</h3>
          <p><a href="mailto:contact@safetyassuranceglobal.com">contact@safetyassuranceglobal.com</a></p>
        </Card>
        <Card>
          <h3>Proposal requests</h3>
          <p><a href="/request-proposal">Request a proposal workflow</a></p>
        </Card>
      </div>
    </Section>
  </Container>
</BaseLayout>

<style>
  .contact-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .contact-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-2);
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .details-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>