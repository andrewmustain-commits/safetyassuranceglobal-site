---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import {
  isPublishedInsight,
  sortByPublishedDateDesc,
  normalizeTaxonomySlug,
  getEntryCanonicalPath,
  estimateReadingMinutes
} from '../../lib/insights';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublishedInsight);

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedPosts = sortByPublishedDateDesc((await getCollection('blog'))
  .filter(isPublishedInsight)
  .filter((entry) => entry.id !== post.id)
  .filter((entry) => {
    const sharedTags = entry.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
    return sharedTags > 0 || entry.data.category === post.data.category;
  }))
  .slice(0, 3);

const canonicalPath = getEntryCanonicalPath(post);
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site ?? Astro.url.origin).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Insights',
      item: new URL('/insights/', Astro.site ?? Astro.url.origin).href
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonicalUrl
    }
  ]
};

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Person',
    name: post.data.author
  },
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  image: post.data.image ? new URL(post.data.image, Astro.site ?? Astro.url.origin).href : undefined,
  publisher: {
    '@type': 'Organization',
    name: 'Safety Assurance Global',
    url: 'https://safetyassuranceglobal.com'
  }
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  ogType="article"
  image={post.data.image ?? undefined}
>
  <Container>
    <Section class="insight-shell" ariaLabelledby="insight-title">
      <Card as="article" class="insight-card">
        <div class="post-header">
          <Badge text="Published Insight" />
          <p class="post-meta">
            <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            {' · '}
            <span>{post.data.author}</span>
            {' · '}
            <span><a href={`/insights/category/${normalizeTaxonomySlug(post.data.category)}/`}>{post.data.category}</a></span>
            {' · '}
            <span>{estimateReadingMinutes(post.body)} min read</span>
          </p>
          <h1 id="insight-title">{post.data.title}</h1>
          <p class="post-summary">{post.data.description}</p>
          {post.data.updatedAt && (
            <p class="post-updated">
              Updated: <time datetime={post.data.updatedAt.toISOString()}>{post.data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </p>
          )}
          <div class="tags-row" aria-label="Article tags">
            {post.data.tags.map((tag) => (
              <a class="tag-chip" href={`/insights/tag/${normalizeTaxonomySlug(tag)}/`}>{tag}</a>
            ))}
          </div>
        </div>

        <div class="post-content" data-article-content>
          <Content />
        </div>

        <p class="post-back-link"><a href="/insights/">Back to insights</a></p>
      </Card>
    </Section>

    {relatedPosts.length > 0 && (
      <Section ariaLabelledby="related-title">
        <SectionHeader id="related-title" badge="Related" title="Related published articles" />
        <div class="related-grid">
          {relatedPosts.map((entry) => (
            <Card as="article" class="related-card">
              <p class="post-meta">
                <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                {' · '}
                <span>{entry.data.category}</span>
              </p>
              <h3><a href={`/insights/${entry.data.slug}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.description}</p>
            </Card>
          ))}
        </div>
      </Section>
    )}
  </Container>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleStructuredData)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)}></script>
  <script is:inline>
    const links = document.querySelectorAll('[data-article-content] a[href^="http"]');
    links.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }
      if (link.origin !== window.location.origin) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }
    });
  </script>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(111, 167, 236, 0.24);
  }

  .post-meta,
  .post-updated {
    margin: 0.7rem 0 0;
    color: var(--color-text-soft);
    font-size: 0.86rem;
  }

  .post-header h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.95rem, 3.6vw, 2.7rem);
    max-width: 28ch;
  }

  .post-summary {
    margin: 0.85rem 0 0;
    font-size: 1.05rem;
    max-width: 72ch;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .post-content :global(p),
  .post-content :global(li) {
    color: var(--color-text-muted);
  }

  .post-content :global(a) {
    color: var(--color-link);
  }

  .post-content :global(a:hover),
  .post-content :global(a:focus-visible) {
    color: var(--color-link-hover);
  }

  .post-back-link {
    margin-top: var(--space-3);
  }

</style>
