---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';

const approvedPosts = (await getCollection('blog', ({ data }) => data.status === 'approved'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [featuredPost, ...otherPosts] = approvedPosts;
---

<BaseLayout title="Insights" description="Approved Safety Assurance Global insights, articles, and updates for maritime and critical infrastructure buyers.">
  <Container>
    <Section class="insights-hero" ariaLabelledby="insights-hero-title">
      <Badge text="Insights" />
      <h1 id="insights-hero-title">Approved insights for buyers and operating leaders.</h1>
      <p>Safety Assurance Global publishes only approved articles here. Unsupported or draft material is kept out of public navigation and listings.</p>
    </Section>

    {approvedPosts.length === 0 ? (
      <Section>
        <Card as="div"><p>No approved insights are available yet.</p></Card>
      </Section>
    ) : (
      <>
        <Section ariaLabelledby="featured-insight-title">
          <div class="section-head">
            <Badge text="Featured Approved Insight" />
            <h2 id="featured-insight-title">Latest approved publication.</h2>
          </div>
          <Card as="article" class="featured-card">
            <p class="meta-row">
              <time datetime={featuredPost.data.date.toISOString()}>
                {featuredPost.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {' · '}
              <span>{featuredPost.data.author}</span>
              {' · '}
              <span>{featuredPost.data.category}</span>
            </p>
            <h3><a href={`/insights/${featuredPost.data.slug}`}>{featuredPost.data.title}</a></h3>
            <p>{featuredPost.data.summary}</p>
          </Card>
        </Section>

        {otherPosts.length > 0 && (
          <Section ariaLabelledby="more-insights-title">
            <div class="section-head">
              <Badge text="More Insights" />
              <h2 id="more-insights-title">Additional approved posts.</h2>
            </div>
            <div class="posts-grid">
              {otherPosts.map((post) => (
                <Card as="article" class="post-card">
                  <p class="meta-row">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                    {' · '}
                    <span>{post.data.category}</span>
                  </p>
                  <h3><a href={`/insights/${post.data.slug}`}>{post.data.title}</a></h3>
                  <p>{post.data.summary}</p>
                </Card>
              ))}
            </div>
          </Section>
        )}
      </>
    )}
  </Container>
</BaseLayout>

<style>
  .insights-hero {
    border: var(--border-luminous);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(9, 24, 45, 0.95), rgba(5, 13, 24, 0.96));
    box-shadow: var(--shadow-panel);
    padding: clamp(1.2rem, 2.8vw, 2rem);
  }

  .insights-hero h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 18ch;
  }

  .section-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
  }

  .meta-row {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-soft);
  }

  .featured-card,
  .post-card {
    border-color: rgba(111, 167, 236, 0.3);
    background: rgba(8, 20, 39, 0.9);
  }

  .posts-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 860px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>