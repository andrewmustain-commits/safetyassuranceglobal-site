---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import NoticePanel from '../../components/ui/NoticePanel.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { isPublishedInsight, normalizeTaxonomySlug, sortByPublishedDateDesc, estimateReadingMinutes } from '../../lib/insights';

const publishedPosts = sortByPublishedDateDesc((await getCollection('blog')).filter(isPublishedInsight));
const featuredPost = publishedPosts.find((post) => post.data.featured) ?? publishedPosts[0];
const recentPosts = publishedPosts.filter((post) => post.id !== featuredPost?.id).slice(0, 8);
const categoryMap = new Map();
const tagMap = new Map();
const insightImages = ['/images/site-2026/insights-hero.webp','/images/site-2026/maritime-hero.webp','/images/site-2026/capabilities-hero.webp','/images/site-2026/about-hero.webp'];

for (const post of publishedPosts) {
  const categoryName = post.data.category.trim();
  const categorySlug = normalizeTaxonomySlug(categoryName);
  const categoryCount = categoryMap.get(categorySlug)?.count ?? 0;
  categoryMap.set(categorySlug, { slug: categorySlug, name: categoryName, count: categoryCount + 1 });
  for (const rawTag of post.data.tags) {
    const tagName = rawTag.trim();
    const tagSlug = normalizeTaxonomySlug(tagName);
    const tagCount = tagMap.get(tagSlug)?.count ?? 0;
    tagMap.set(tagSlug, { slug: tagSlug, name: tagName, count: tagCount + 1 });
  }
}

const categories = Array.from(categoryMap.values()).sort((a, b) => a.name.localeCompare(b.name));
const tags = Array.from(tagMap.values()).sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Insights" description="Published Safety Assurance Global insights for maritime and critical-infrastructure leaders." canonical="/insights/">
  <Container>
    <HeroSection id="insights-title" badge="Insights" title="Governed insights for maritime assurance leaders." image="/images/site-2026/insights-hero.webp" imagePosition="center 54%">
      <p>Published perspectives on operational readiness, assurance, risk, governance, and high-consequence work—written for leaders who need practical, evidence-based decision support.</p>
    </HeroSection>

    <Section ariaLabelledby="insights-governance-title">
      <NoticePanel tone="info" title="Editorial Standard" id="insights-governance-title"><p>SAG publishes evidence-led perspectives with claims reviewed for accuracy and context. Articles are informational and do not replace project-specific requirements, contractual criteria, or regulatory obligations.</p></NoticePanel>
    </Section>

    {publishedPosts.length === 0 ? (
      <Section ariaLabelledby="insights-empty-title"><Card as="div"><h2 id="insights-empty-title">No published insights are available at this time.</h2><p>New perspectives will appear here as they are released.</p></Card></Section>
    ) : (
      <>
        {featuredPost && (
          <Section ariaLabelledby="featured-insight-title">
            <SectionHeader id="featured-insight-title" badge="Featured" title="Featured published article" />
            <Card as="article" class="featured-card image-forward-card image-forward-card-tall image-forward-card-gold" style="--card-image:url(/images/site-2026/insights-hero.webp)">
              <p class="meta-row"><time datetime={featuredPost.data.publishedAt.toISOString()}>{featuredPost.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>{' · '}<span>{featuredPost.data.author}</span>{' · '}<span>{featuredPost.data.category}</span>{' · '}<span>{estimateReadingMinutes(featuredPost.body)} min read</span></p>
              <h3><a href={`/insights/${featuredPost.data.slug}/`}>{featuredPost.data.title}</a></h3>
              <p>{featuredPost.data.description}</p>
              <p><a href={`/insights/${featuredPost.data.slug}/`} aria-label={`Read ${featuredPost.data.title}`}>Read article</a></p>
            </Card>
          </Section>
        )}

        <Section ariaLabelledby="insights-categories-title">
          <SectionHeader id="insights-categories-title" badge="Categories" title="Browse by category" />
          <div class="taxonomy-grid">
            {categories.map((category, index) => (
              <Card as="article" class="taxonomy-card image-forward-card image-forward-card-tall" style={`--card-image:url(${insightImages[index % insightImages.length]})`}>
                <h3><a href={`/insights/category/${category.slug}/`}>{category.name}</a></h3>
                <p>{category.count} published {category.count === 1 ? 'article' : 'articles'}</p>
              </Card>
            ))}
          </div>
        </Section>

        <Section ariaLabelledby="insights-tags-title">
          <SectionHeader id="insights-tags-title" badge="Topics" title="Explore published themes" />
          <div class="tag-cloud" aria-label="Published insight tags">
            {tags.map((tag) => (<a class="tag-chip" href={`/insights/tag/${tag.slug}/`}>{tag.name}<span aria-hidden="true"> ({tag.count})</span></a>))}
          </div>
        </Section>

        <Section ariaLabelledby="recent-insights-title">
          <SectionHeader id="recent-insights-title" badge="Recent" title="Recent published insights" />
          {recentPosts.length === 0 ? (
            <Card as="div"><p>Additional published insights will appear here as they are released.</p></Card>
          ) : (
            <div class="posts-grid">
              {recentPosts.map((post, index) => (
                <Card as="article" class="post-card image-forward-card" style={`--card-image:url(${insightImages[(index + 1) % insightImages.length]})`}>
                  <p class="meta-row"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>{' · '}<span>{post.data.category}</span>{' · '}<span>{estimateReadingMinutes(post.body)} min read</span></p>
                  <h3><a href={`/insights/${post.data.slug}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <p><a href={`/insights/${post.data.slug}/`} aria-label={`Read ${post.data.title}`}>Read article</a></p>
                </Card>
              ))}
            </div>
          )}
        </Section>
      </>
    )}

    <CTASection id="insights-cta-title" badge="Next Step" title="Need insight tied to your operating context?" intro="Request a consultation to map assurance priorities, controls, and readiness evidence for your organization.">
      <div class="ui-actions"><Button href="/contact">Request a Consultation</Button><Button href="/request-proposal" variant="secondary">Request a Proposal</Button></div>
    </CTASection>
  </Container>
</BaseLayout>
