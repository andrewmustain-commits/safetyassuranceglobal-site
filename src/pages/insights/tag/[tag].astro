---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/ui/Section.astro';
import Card from '../../../components/ui/Card.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import {
  isPublishedInsight,
  sortByPublishedDateDesc,
  normalizeTaxonomySlug,
  estimateReadingMinutes
} from '../../../lib/insights';

type TagProps = {
  tagName: string;
  tagSlug: string;
  posts: Awaited<ReturnType<typeof getCollection>>;
};

export async function getStaticPaths() {
  const publishedPosts = sortByPublishedDateDesc((await getCollection('blog')).filter(isPublishedInsight));
  const byTag = new Map<string, { name: string; posts: typeof publishedPosts }>();

  for (const post of publishedPosts) {
    for (const rawTag of post.data.tags) {
      const name = rawTag.trim();
      const slug = normalizeTaxonomySlug(name);
      const existing = byTag.get(slug);
      if (existing) {
        existing.posts.push(post);
      } else {
        byTag.set(slug, { name, posts: [post] });
      }
    }
  }

  return Array.from(byTag.entries()).map(([tagSlug, value]) => ({
    params: { tag: tagSlug },
    props: {
      tagName: value.name,
      tagSlug,
      posts: value.posts
    }
  }));
}

const { tagName, tagSlug, posts } = Astro.props as TagProps;
---

<BaseLayout
  title={`Tag: ${tagName}`}
  description={`Published insights tagged with ${tagName}.`}
  canonical={`/insights/tag/${tagSlug}/`}
>
  <Container>
    <HeroSection id="tag-title" badge="Tag" title={tagName}>
      <p>{posts.length} published {posts.length === 1 ? 'article' : 'articles'} with this tag.</p>
      <p><a href="/insights/">Back to insights</a></p>
    </HeroSection>

    <Section ariaLabelledby="tag-list-title">
      <SectionHeader id="tag-list-title" badge="Published" title="Published articles" />
      {posts.length === 0 ? (
        <Card as="div"><p>No published articles are currently assigned to this tag.</p></Card>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => (
            <Card as="article" class="post-card">
              <p class="meta-row">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {' · '}
                <span>{post.data.category}</span>
                {' · '}
                <span>{estimateReadingMinutes(post.body)} min read</span>
              </p>
              <h3><a href={`/insights/${post.data.slug}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </Card>
          ))}
        </div>
      )}
    </Section>
  </Container>
</BaseLayout>
