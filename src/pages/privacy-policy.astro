---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
---

<BaseLayout title="Privacy Policy" description="Privacy policy for Safety Assurance Global website visitors and inquiry submitters.">
  <Container>
    <Section ariaLabelledby="privacy-title">
      <h1 id="privacy-title">Privacy Policy</h1>
      <p>Safety Assurance Global LLC handles inquiry and website information in a controlled and transparent manner.</p>
    </Section>

    <Section ariaLabelledby="privacy-collection-title">
      <h2 id="privacy-collection-title">Information We Collect</h2>
      <p>We collect information you voluntarily provide through inquiry forms or direct contact channels.</p>
    </Section>

    <Section ariaLabelledby="privacy-use-title">
      <h2 id="privacy-use-title">How We Use Information</h2>
      <p>Information is used to respond to inquiries, evaluate service fit, and support legitimate business communication.</p>
    </Section>

    <Section ariaLabelledby="privacy-sharing-title">
      <h2 id="privacy-sharing-title">Sharing and Processing</h2>
      <p>
        Inquiry data may be processed by approved service providers used for intake delivery. We do not publish
        private inquiry content and limit processing to business-response needs.
      </p>
    </Section>

    <Section ariaLabelledby="privacy-security-title">
      <h2 id="privacy-security-title">Security and Retention</h2>
      <p>
        We apply reasonable administrative and technical safeguards and retain records only as needed for business,
        legal, and operational purposes.
      </p>
    </Section>

    <Section ariaLabelledby="privacy-contact-title">
      <h2 id="privacy-contact-title">Privacy Contact</h2>
      <p>For privacy questions, contact <a href="mailto:privacy@safetyassuranceglobal.com">privacy@safetyassuranceglobal.com</a>.</p>
    </Section>
  </Container>
</BaseLayout>
