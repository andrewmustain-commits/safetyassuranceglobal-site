---
import '../styles/design-system.css';
import Container from '../components/ui/Container.astro';
import Logo from '../components/brand/Logo.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
}

const {
  title,
  description = 'Safety Assurance Global provides independent assurance for maritime and critical infrastructure teams.',
  image = '/images/brand/sag-brand-artwork-registered.png',
  canonical,
  ogType = 'website',
  noIndex = false
} = Astro.props;

const navigation = [
  { href: '/', label: 'Home' },
  { href: '/maritime', label: 'Maritime' },
  { href: '/services', label: 'Services' },
  { href: '/training', label: 'Training' },
  { href: '/industries', label: 'Industries' },
  { href: '/government', label: 'Government' },
  { href: '/about', label: 'About' },
  { href: '/insights', label: 'Insights' },
  { href: '/contact', label: 'Contact' }
];

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath !== '/' && currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
const isHome = normalizedPath === '/';
const normalizeHref = (value: string) => (value !== '/' && value.endsWith('/') ? value.slice(0, -1) : value);

const breadcrumbLabelMap: Record<string, string> = {
  about: 'About',
  maritime: 'Maritime',
  services: 'Services',
  industries: 'Industries',
  government: 'Government',
  method: 'Method',
  'sag-command': 'SAG Command',
  training: 'Training',
  insights: 'Insights',
  blog: 'Insights',
  'maritime-training': 'Maritime Training',
  contact: 'Contact',
  'request-proposal': 'Request a Proposal',
  'privacy-policy': 'Privacy Policy',
  'terms-of-use': 'Terms of Use',
  terms: 'Terms',
  '404': '404'
};

const pathParts = normalizedPath.split('/').filter(Boolean);
const currentYear = new Date().getFullYear();

const toTitleCase = (value: string) =>
  value
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());

const breadcrumbs = pathParts.map((segment, index) => {
  const href = `/${pathParts.slice(0, index + 1).join('/')}/`;
  const isLast = index === pathParts.length - 1;
  const mapped = breadcrumbLabelMap[segment];
  const label = isLast && !mapped ? title : mapped ?? toTitleCase(segment);
  return { href, label, isLast };
});

const hideUnifiedCta = ['/privacy-policy', '/terms-of-use', '/terms', '/request-proposal', '/404'].includes(normalizedPath);
const canonicalUrl = canonical ? new URL(canonical, Astro.url.origin).href : Astro.url.href;
const ogImage = new URL(image, Astro.url.origin).href;
const logoUrl = new URL('/images/brand/sag-logo.svg', Astro.url.origin).href;
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Safety Assurance Global',
  url: 'https://safetyassuranceglobal.com',
  logo: logoUrl
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/images/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Safety Assurance Global Insights RSS" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Safety Assurance Global" />
    <meta property="og:title" content={`${title} | Safety Assurance Global`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Safety Assurance Global`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationStructuredData)}></script>

    <meta name="generator" content={Astro.generator} />
    <title>{title} | Safety Assurance Global</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <Container class="header-inner">
        <Logo className="brand" imageClassName="brand-logo" />
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav-list" aria-label="Open navigation" data-nav-toggle>
          Menu
        </button>
        <nav aria-label="Primary navigation" class="primary-nav" data-open="false" data-primary-nav>
          <ul id="primary-nav-list">
            {navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={normalizeHref(item.href) === normalizedPath ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            <li class="mobile-nav-cta"><a class="ui-button ui-button-primary" href="/contact">Request a Consultation</a></li>
          </ul>
        </nav>
        <a class="ui-button ui-button-primary header-cta" href="/contact">Request a Consultation</a>
      </Container>
    </header>
    <main id="main-content" class="site-main">
      {!isHome && (
        <Container>
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {breadcrumbs.map((crumb) => (
                <li aria-current={crumb.isLast ? 'page' : undefined}>
                  {crumb.isLast ? <span>{crumb.label}</span> : <a href={crumb.href}>{crumb.label}</a>}
                </li>
              ))}
            </ol>
          </nav>
        </Container>
      )}
      <slot />
      {!hideUnifiedCta && (
        <section class="site-cross-cta" aria-labelledby="site-cross-cta-title">
          <Container class="site-cross-cta-inner">
            <div>
              <p class="site-cross-eyebrow">Independent Assurance</p>
              <h2 id="site-cross-cta-title">Turn operational risk into verified readiness.</h2>
            </div>
            <div class="site-cross-actions">
              <a class="ui-button ui-button-primary" href="/contact">Request a Consultation</a>
              <a class="ui-button ui-button-secondary" href="/maritime">Explore Maritime Services</a>
            </div>
          </Container>
        </section>
      )}
    </main>
    <footer class="site-footer">
      <Container class="footer-shell">
        <section class="footer-company" aria-labelledby="footer-company-title">
          <p class="footer-lede">Independent Assurance for Maritime and Critical Infrastructure</p>
          <h2 id="footer-company-title" class="visually-hidden">Safety Assurance Global LLC</h2>
          <Logo className="footer-logo-link" imageClassName="footer-logo" loading="lazy" />
          <p>
            Safety Assurance Global LLC is a maritime and critical-infrastructure consulting, operational-readiness,
            safety, risk-management, QA/QC, compliance, and independent-assurance company that also provides workforce training.
          </p>
          <div class="footer-company-actions">
            <a class="ui-button ui-button-primary" href="/contact">Request a Consultation</a>
            <a class="ui-button ui-button-secondary" href="/request-proposal">Request a Proposal</a>
          </div>
        </section>
        <nav class="footer-nav" aria-label="Footer navigation">
          <section>
            <h3>Quick Links</h3>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/maritime">Maritime</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/training">Training</a></li>
              <li><a href="/industries">Industries</a></li>
            </ul>
          </section>
          <section>
            <h3>Sectors and Methods</h3>
            <ul>
              <li><a href="/government">Government</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/method">Method</a></li>
              <li><a href="/insights">Insights</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </section>
          <section>
            <h3>Policies</h3>
            <ul>
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-of-use">Terms of Use</a></li>
            </ul>
          </section>
        </nav>
        <p class="footer-meta">© {currentYear} Safety Assurance Global LLC. All rights reserved.</p>
      </Container>
    </footer>
    <script>
      const nav = document.querySelector('[data-primary-nav]');
      const toggle = document.querySelector('[data-nav-toggle]');

      if (nav instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
        const navLinks = Array.from(nav.querySelectorAll('a'));

        const setState = (open: boolean) => {
          nav.dataset.open = String(open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        };

        const closeNav = () => setState(false);

        toggle.addEventListener('click', () => {
          const open = nav.dataset.open !== 'true';
          setState(open);

          if (open && navLinks[0] instanceof HTMLElement) {
            navLinks[0].focus();
          }
        });

        navLinks.forEach((link) => {
          link.addEventListener('click', closeNav);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.dataset.open === 'true') {
            closeNav();
            toggle.focus();
          }
        });

        document.addEventListener('click', (event) => {
          if (nav.dataset.open !== 'true') {
            return;
          }

          const target = event.target;
          if (!(target instanceof Node)) {
            return;
          }

          if (!nav.contains(target) && !toggle.contains(target)) {
            closeNav();
          }
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 920) {
            closeNav();
          }
        });
      }
    </script>
  </body>
</html>
