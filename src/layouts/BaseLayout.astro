---
import '../styles/design-system.css';
import '../styles/accessibility.css';
import Container from '../components/ui/Container.astro';
import Logo from '../components/brand/Logo.astro';

interface Props { title: string; description?: string; image?: string; canonical?: string; ogType?: 'website' | 'article'; noIndex?: boolean; }
const { title, description = 'Safety Assurance Global provides independent assurance for maritime and critical infrastructure teams.', image, canonical, ogType = 'website', noIndex = false } = Astro.props;
const navigation = [
  { href: '/', label: 'Home' }, { href: '/maritime', label: 'Maritime' }, { href: '/services', label: 'Services' }, { href: '/capabilities', label: 'Capabilities' }, { href: '/industries', label: 'Industries' }, { href: '/government', label: 'Government' }, { href: '/institute', label: 'Institute' }, { href: '/about', label: 'About' }, { href: '/insights', label: 'Insights' }, { href: '/contact', label: 'Contact' }
];
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath !== '/' && currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
const isHome = normalizedPath === '/';
const normalizeHref = (value: string) => (value !== '/' && value.endsWith('/') ? value.slice(0, -1) : value);
const breadcrumbLabelMap: Record<string,string> = { about:'About', maritime:'Maritime', services:'Services', capabilities:'Capabilities', institute:'Institute of Assurance', academy:'Institute of Assurance', industries:'Industries', government:'Government', method:'Method', 'sag-command':'SAG Command', training:'Training', insights:'Insights', blog:'Insights', 'maritime-training':'Maritime Training', contact:'Contact', 'request-proposal':'Request a Proposal', 'privacy-policy':'Privacy Policy', 'terms-of-use':'Terms of Use', terms:'Terms', '404':'404' };
const pathParts = normalizedPath.split('/').filter(Boolean);
const currentYear = new Date().getFullYear();
const toTitleCase = (value:string) => value.replace(/[-_]/g,' ').replace(/\b\w/g,(char)=>char.toUpperCase());
const breadcrumbs = pathParts.map((segment,index)=>{ const href=`/${pathParts.slice(0,index+1).join('/')}/`; const isLast=index===pathParts.length-1; const mapped=breadcrumbLabelMap[segment]; return { href, label:isLast&&!mapped?title:mapped??toTitleCase(segment), isLast }; });
const hideUnifiedCta=['/privacy-policy','/terms-of-use','/terms','/request-proposal','/404'].includes(normalizedPath);
const canonicalPath=normalizedPath||'/';
const canonicalUrl=canonical?new URL(canonical,Astro.url.origin).href:new URL(canonicalPath,Astro.url.origin).href;
const ogImage=image?new URL(image,Astro.url.origin).href:null;
const logoUrl=new URL('/images/brand/sag-logo.svg',Astro.url.origin).href;
const siteUrl='https://safetyassuranceglobal.com';
const pageTitle=isHome?'Maritime Assurance & Operational Readiness | Safety Assurance Global':`${title} | Safety Assurance Global`;
const organizationStructuredData={ '@type':'Organization','@id':`${siteUrl}/#organization`,name:'Safety Assurance Global',legalName:'Safety Assurance Global LLC',url:siteUrl,logo:{'@type':'ImageObject',url:logoUrl},identifier:[{'@type':'PropertyValue',name:'UEI',value:'RCUUJLWEBGD4'},{'@type':'PropertyValue',name:'CAGE',value:'16NM4'}],naics:'541611',address:{'@type':'PostalAddress',addressRegion:'Oregon',addressCountry:'US'},contactPoint:[{'@type':'ContactPoint',contactType:'general inquiries',email:'info@safetyassuranceglobal.com'},{'@type':'ContactPoint',contactType:'general contact',email:'contact@safetyassuranceglobal.com'},{'@type':'ContactPoint',contactType:'Institute and Academy inquiries',email:'academy@safetyassuranceglobal.com'},{'@type':'ContactPoint',contactType:'SAG Command inquiries',email:'command@safetyassuranceglobal.com'}],department:{'@type':'Organization','@id':`${siteUrl}/institute#organization`,name:'Safety Assurance Global Institute of Assurance',url:`${siteUrl}/institute`} };
const websiteStructuredData={'@type':'WebSite','@id':`${siteUrl}/#website`,name:'Safety Assurance Global',url:siteUrl,publisher:{'@id':`${siteUrl}/#organization`},inLanguage:'en-US'};
const breadcrumbStructuredData=!isHome?{'@type':'BreadcrumbList','@id':`${canonicalUrl}#breadcrumb`,itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`${siteUrl}/`},...breadcrumbs.map((crumb,index)=>({'@type':'ListItem',position:index+2,name:crumb.label,item:new URL(crumb.href,Astro.url.origin).href}))]}:null;
const structuredDataGraph={'@context':'https://schema.org','@graph':[organizationStructuredData,websiteStructuredData,...(breadcrumbStructuredData?[breadcrumbStructuredData]:[])]};
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#09121f"/><meta name="color-scheme" content="dark"/><link rel="icon" type="image/svg+xml" href="/images/brand/sag-icon.svg"/><meta name="description" content={description}/><meta name="robots" content={noIndex?'noindex,nofollow':'index,follow'}/><link rel="canonical" href={canonicalUrl}/><link rel="alternate" type="application/rss+xml" title="Safety Assurance Global Insights RSS" href="/rss.xml"/><meta property="og:type" content={ogType}/><meta property="og:site_name" content="Safety Assurance Global"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/>{ogImage&&<meta name="twitter:image" content={ogImage}/>}<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)}></script><meta name="generator" content={Astro.generator}/><title>{pageTitle}</title></head>
<body><a href="#main-content" class="skip-link">Skip to main content</a><header class="site-header"><Container class="header-inner"><Logo className="brand" imageClassName="brand-logo"/><button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav-list" aria-label="Open navigation" data-nav-toggle>Menu</button><nav aria-label="Primary navigation" class="primary-nav" data-open="false" data-primary-nav><ul id="primary-nav-list">{navigation.map((item)=><li><a href={item.href} aria-current={normalizeHref(item.href)===normalizedPath?'page':undefined}>{item.label}</a></li>)}<li class="mobile-nav-cta"><a class="ui-button ui-button-primary" href="/contact">Discuss Your Requirement</a></li></ul></nav><a class="ui-button ui-button-primary header-cta" href="/contact">Discuss Your Requirement</a></Container></header>
<main id="main-content" class="site-main">{!isHome&&<Container><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{breadcrumbs.map((crumb)=><li aria-current={crumb.isLast?'page':undefined}>{crumb.isLast?<span>{crumb.label}</span>:<a href={crumb.href}>{crumb.label}</a>}</li>)}</ol></nav></Container>}<slot/>{!hideUnifiedCta&&<section class="site-cross-cta" aria-labelledby="site-cross-cta-title"><Container class="site-cross-cta-inner"><div><p class="site-cross-eyebrow">Independent Assurance</p><h2 id="site-cross-cta-title">Need confidence before the next critical decision?</h2></div><div class="site-cross-actions"><a class="ui-button ui-button-primary" href="/contact">Discuss Your Requirement</a><a class="ui-button ui-button-secondary" href="/services">See How SAG Helps</a></div></Container></section>}</main>
<footer class="site-footer"><Container class="footer-shell"><section class="footer-company" aria-labelledby="footer-company-title"><p class="footer-lede">Independent Assurance for Maritime and Critical Infrastructure</p><h2 id="footer-company-title" class="visually-hidden">Safety Assurance Global LLC</h2><Logo className="footer-logo-link" imageClassName="footer-logo" loading="lazy"/><p>Safety Assurance Global LLC provides independent assurance, operational-readiness, safety, risk, QA/QC, contractor-assurance, and compliance-readiness support, with workforce development delivered through the Institute of Assurance.</p><div class="footer-company-actions"><a class="ui-button ui-button-primary" href="/contact">Discuss Your Requirement</a><a class="ui-button ui-button-secondary" href="/request-proposal">Request a Proposal</a></div></section><nav class="footer-nav" aria-label="Footer navigation"><section><h3>Quick Links</h3><ul><li><a href="/">Home</a></li><li><a href="/maritime">Maritime</a></li><li><a href="/services">Services</a></li><li><a href="/capabilities">Capabilities</a></li><li><a href="/institute">Institute of Assurance</a></li><li><a href="/industries">Industries</a></li></ul></section><section><h3>Sectors and Methods</h3><ul><li><a href="/government">Government</a></li><li><a href="/about">About</a></li><li><a href="/method">Our Evidence Standard</a></li><li><a href="/insights">Insights</a></li><li><a href="/contact">Contact</a></li></ul></section><section><h3>Contact</h3><ul><li><a href="mailto:info@safetyassuranceglobal.com">General inquiries</a></li><li><a href="mailto:contact@safetyassuranceglobal.com">General contact</a></li><li><a href="mailto:academy@safetyassuranceglobal.com">Institute &amp; Academy</a></li><li><a href="mailto:command@safetyassuranceglobal.com">SAG Command</a></li></ul></section><section><h3>Policies</h3><ul><li><a href="/privacy-policy">Privacy Policy</a></li><li><a href="/terms-of-use">Terms of Use</a></li></ul></section></nav><p class="footer-meta">© {currentYear} Safety Assurance Global LLC. All rights reserved.</p></Container></footer>
<script>const nav=document.querySelector('[data-primary-nav]');const toggle=document.querySelector('[data-nav-toggle]');if(nav instanceof HTMLElement&&toggle instanceof HTMLButtonElement){const navLinks=Array.from(nav.querySelectorAll('a'));const setState=(open)=>{nav.dataset.open=String(open);toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation');document.body.classList.toggle('nav-open',open)};const closeNav=()=>setState(false);toggle.addEventListener('click',()=>{const open=nav.dataset.open!=='true';setState(open);if(open&&navLinks[0] instanceof HTMLElement)navLinks[0].focus()});navLinks.forEach((link)=>link.addEventListener('click',closeNav));document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&nav.dataset.open==='true'){closeNav();toggle.focus()}});document.addEventListener('click',(event)=>{if(nav.dataset.open!=='true')return;const target=event.target;if(target instanceof Node&&!nav.contains(target)&&!toggle.contains(target))closeNav()});window.addEventListener('resize',()=>{if(window.innerWidth>920)closeNav()})}</script></body></html>
