# Cloudflare inquiry delivery activation request

status=dormant
worker=sag-inquiry-delivery
pages_project=safetyassuranceglobal
binding=INQUIRY_DELIVERY

# Safety control
# The activation workflow runs only when this file changes on main and the
# ENTIRE triggering commit message is exactly:
# ACTIVATE_INQUIRY_DELIVERY
#
# Any other commit message performs no Cloudflare activation writes.
